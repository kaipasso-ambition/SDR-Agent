<%
  function fmtDate(d) {
    if (!d) return '—';
    const dt = d instanceof Date ? d : new Date(d);
    if (isNaN(dt)) return '—';
    return dt.toISOString().slice(0, 10);
  }
  const roleLabel = {
    economic_buyer: 'Decider',
    champion:       'Champion',
    coach:          'Coach',
    influencer:     'Influencer',
    blocker:        'Blocker',
    user:           'User',
    unknown:        '—',
  };
  const roleColor = {
    economic_buyer: 'bg-purple-100 text-purple-800',
    champion:       'bg-emerald-100 text-emerald-800',
    coach:          'bg-blue-100 text-blue-800',
    influencer:     'bg-slate-100 text-slate-700',
    blocker:        'bg-red-100 text-red-800',
    user:           'bg-slate-100 text-slate-600',
    unknown:        'bg-slate-100 text-slate-500',
  };
  const stanceColor = {
    hot:     'text-emerald-700',
    warm:    'text-emerald-600',
    neutral: 'text-slate-500',
    cold:    'text-amber-600',
    hostile: 'text-red-600',
  };
  // Show deciders + champions + blockers first; everyone else compressed.
  const primaryContacts = contacts.filter(c =>
    ['economic_buyer', 'champion', 'blocker', 'coach'].includes(c.deal_role)
  );
  const otherContacts = contacts.filter(c =>
    !['economic_buyer', 'champion', 'blocker', 'coach'].includes(c.deal_role)
  );
  // ---------- Scan state + triggers/paths ----------
  const triggers     = Array.isArray(dossier?.last_scan_result) ? dossier.last_scan_result : [];
  const scanStatus   = dossier?.last_scan_status;
  const isScanning   = scanStatus === 'running';
  const hasDossier   = Boolean(dossier);
  const canScan      = hasDossier && dossier.destination;
  const sevPill = (s) => {
    if (s >= 5) return 'bg-red-100 text-red-800';
    if (s === 4) return 'bg-orange-100 text-orange-800';
    if (s === 3) return 'bg-amber-100 text-amber-800';
    if (s === 2) return 'bg-slate-100 text-slate-700';
    return 'bg-slate-100 text-slate-500';
  };
  const channelIcon = (ch) => {
    if (ch === 'linkedin') return 'in';
    if (ch === 'email')    return '@';
    if (ch === 'call')     return '☎';
    if (ch === 'internal') return '→';
    if (ch === 'slack')    return '#';
    if (ch === 'event')    return '★';
    return '·';
  };
  const channelColor = (ch) => {
    if (ch === 'linkedin') return 'bg-blue-100 text-blue-800';
    if (ch === 'email')    return 'bg-emerald-100 text-emerald-800';
    if (ch === 'call')     return 'bg-amber-100 text-amber-800';
    if (ch === 'internal') return 'bg-slate-100 text-slate-700';
    if (ch === 'slack')    return 'bg-purple-100 text-purple-800';
    if (ch === 'event')    return 'bg-fuchsia-100 text-fuchsia-800';
    return 'bg-slate-100 text-slate-600';
  };
  const actorLabel = { ae: 'You', champion: 'Champion', sponsor: 'Sponsor', target: 'Target' };
  const actorColor = {
    ae:       'bg-slate-100 text-slate-700',
    champion: 'bg-emerald-100 text-emerald-800',
    sponsor:  'bg-blue-100 text-blue-800',
    target:   'bg-purple-100 text-purple-800',
  };
  const carryLabel = {
    existing_champion: 'Champion carries',
    existing_sponsor:  'Sponsor carries',
    new_target:        'New target',
  };
  const carryColor = {
    existing_champion: 'bg-emerald-100 text-emerald-800',
    existing_sponsor:  'bg-blue-100 text-blue-800',
    new_target:        'bg-amber-100 text-amber-800',
  };
  // Latest pathSet per trigger_index — the /expand/:id/paths route always
  // inserts a new row, so the FIRST one we see (list is DESC) is current.
  const pathsByTrigger = {};
  (pathSets || []).forEach(function(ps) {
    if (!pathsByTrigger[ps.trigger_index]) pathsByTrigger[ps.trigger_index] = ps;
  });
  const pathColors = [
    { border: 'border-blue-300',    header: 'bg-blue-50 text-blue-900 border-b border-blue-200',       dot: 'bg-blue-500',    bar: 'bg-blue-500',    selected: 'ring-2 ring-blue-500',    selectBtn: 'bg-blue-600 hover:bg-blue-700 text-white' },
    { border: 'border-emerald-300', header: 'bg-emerald-50 text-emerald-900 border-b border-emerald-200', dot: 'bg-emerald-500', bar: 'bg-emerald-500', selected: 'ring-2 ring-emerald-500', selectBtn: 'bg-emerald-600 hover:bg-emerald-700 text-white' },
    { border: 'border-purple-300',  header: 'bg-purple-50 text-purple-900 border-b border-purple-200',  dot: 'bg-purple-500',  bar: 'bg-purple-500',  selected: 'ring-2 ring-purple-500',  selectBtn: 'bg-purple-600 hover:bg-purple-700 text-white' },
  ];
  const outcomeLabels = { won: 'Won', lost: 'Lost', no_response: 'No response', in_progress: 'In progress' };
  const outcomeColors = { won: 'bg-emerald-100 text-emerald-800', lost: 'bg-red-100 text-red-800', no_response: 'bg-slate-100 text-slate-700', in_progress: 'bg-amber-100 text-amber-800' };
  const effortLabel = (s) => ({1:'XS',2:'S',3:'M',4:'L',5:'XL'}[s] || '?');
  // ---------- Dossier coach ----------
  // coach_result is a JSONB object with four string arrays + rationale +
  // sources. Any field may be empty/missing; render defensively.
  const coachStatus = dossier?.coach_status;
  const isCoaching  = coachStatus === 'running';
  const coach = (coachStatus === 'completed' && dossier?.coach_result && typeof dossier.coach_result === 'object')
    ? dossier.coach_result : null;
  const coachBullets = (field) => (coach && Array.isArray(coach[field])) ? coach[field] : [];
  const hasCoachSuggestions = coach && (
    coachBullets('footprint').length ||
    coachBullets('destination').length ||
    coachBullets('stack_competitive').length ||
    coachBullets('open_questions').length ||
    coach.rationale
  );
  // ---------- Strategic plan ----------
  // plan_result is a JSONB object: {hypotheses:[...], rationale, ranking_notes}.
  // The planner synthesizes 3-5 expansion bets from dossier+notes+people alone.
  const planStatus    = dossier?.plan_status;
  const isPlanning    = planStatus === 'running';
  const plan          = (planStatus === 'completed' && dossier?.plan_result && typeof dossier.plan_result === 'object')
    ? dossier.plan_result : null;
  const hypotheses    = plan && Array.isArray(plan.hypotheses) ? plan.hypotheses : [];
  // Any of the four dossier fields filled = planner is allowed to run.
  const hasAnyDossierField = Boolean(
    dossier && (dossier.footprint || dossier.destination ||
                dossier.stack_competitive || dossier.open_questions)
  );
  // Colour scale for odds — red for low (risky), amber mid, emerald high.
  const oddsColor = (o) => {
    if (o == null) return 'bg-slate-200 text-slate-600';
    if (o >= 50)   return 'bg-emerald-100 text-emerald-800 border-emerald-300';
    if (o >= 30)   return 'bg-amber-100 text-amber-800 border-amber-300';
    return 'bg-red-100 text-red-800 border-red-300';
  };
  const oddsBar = (o) => {
    if (o == null) return 'bg-slate-300';
    if (o >= 50)   return 'bg-emerald-500';
    if (o >= 30)   return 'bg-amber-500';
    return 'bg-red-500';
  };
  const strategicLabel = {
    hub_consolidation:       'Hub consolidation',
    new_motion:              'New motion',
    defense_against_churn:   'Defense',
    competitive_displacement: 'Displacement',
    stretch_upsell:          'Stretch upsell',
    seat_upstack:            'Seat upstack',
  };
  const strategicColor = {
    hub_consolidation:        'bg-purple-100 text-purple-800',
    new_motion:               'bg-blue-100 text-blue-800',
    defense_against_churn:    'bg-red-100 text-red-800',
    competitive_displacement: 'bg-fuchsia-100 text-fuchsia-800',
    stretch_upsell:           'bg-emerald-100 text-emerald-800',
    seat_upstack:             'bg-slate-100 text-slate-700',
  };
  const fmtUsd = (n) => {
    if (!Number.isFinite(n)) return null;
    if (n >= 1_000_000) return '$' + (n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 1) + 'M';
    if (n >= 1_000)     return '$' + Math.round(n / 1_000) + 'K';
    return '$' + n;
  };
  const fmtTimeframe = (d) => {
    if (!Number.isFinite(d)) return null;
    if (d >= 365) return (d / 365).toFixed(1).replace(/\.0$/, '') + 'y';
    if (d >= 30)  return Math.round(d / 30) + 'mo';
    return d + 'd';
  };
%>

<div class="mb-2 text-sm text-slate-500">
  <a href="/expand" class="hover:text-slate-900">&larr; Expand</a>
</div>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-semibold"><%= account.account_name %></h1>
    <div class="text-sm text-slate-500 mt-1">
      Active customer
      <% if (account.industry) { %> &middot; <%= account.industry %><% } %>
      <% if (account.domain) { %> &middot; <%= account.domain %><% } %>
    </div>
    <% if (dossier?.updated_at) { %>
      <div class="text-[11px] text-slate-400 mt-1">dossier updated <%= fmtDate(dossier.updated_at) %></div>
    <% } %>
  </div>
  <div class="shrink-0 flex items-center gap-3">
    <a href="/accounts/<%= account.id %>/plan"
       class="text-xs text-slate-600 hover:text-slate-900 underline mt-2">
      Open Plan (org chart) &rarr;
    </a>
    <% if (canScan) { %>
      <form method="POST" action="/expand/<%= account.id %>/scan">
        <button type="submit"
                class="text-sm bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded font-medium disabled:opacity-50"
                <% if (isScanning) { %>disabled<% } %>>
          <% if (isScanning) { %>Scanning&hellip;<% } else if (scanStatus === 'completed') { %>Re-scan<% } else { %>Run scan<% } %>
        </button>
      </form>
    <% } %>
  </div>
</div>

<% if (isScanning) { %>
  <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6 flex items-center gap-3">
    <span class="inline-block w-2 h-2 bg-amber-500 rounded-full animate-pulse"></span>
    <div class="flex-1 text-sm text-amber-900">
      Scanning the web for movement that strengthens one of your destination goals. Typically 1&ndash;3 minutes (~6 web searches).
    </div>
  </div>
  <script>setTimeout(function(){ location.reload(); }, 15000);</script>
<% } else if (scanStatus === 'failed') { %>
  <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6 text-sm text-red-900">
    <strong>Last scan failed.</strong>
    <% if (dossier?.last_scan_error) { %><div class="mt-1 text-red-800 font-mono text-xs"><%= dossier.last_scan_error %></div><% } %>
  </div>
<% } else if (!canScan) { %>
  <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6 text-sm text-amber-900">
    <strong>Fill in <em>Destination</em> below to enable the scanner.</strong>
    The destination goals are the filter — without them the scanner has nothing to optimize toward.
  </div>
<% } %>

<!-- ---------- Dossier editor ---------- -->
<div id="dossier" class="flex items-center justify-between mb-3">
  <h2 class="text-sm font-semibold text-slate-700">Dossier</h2>
  <div class="flex items-center gap-3">
    <% if (coach) { %>
      <form method="POST" action="/expand/<%= account.id %>/coach/clear" class="inline">
        <button type="submit" class="text-xs text-slate-500 hover:text-slate-900 underline">
          Dismiss suggestions
        </button>
      </form>
    <% } %>
    <form method="POST" action="/expand/<%= account.id %>/coach" class="inline">
      <button type="submit"
              class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 px-3 py-1.5 rounded font-medium disabled:opacity-50"
              <% if (isCoaching) { %>disabled<% } %>>
        <% if (isCoaching) { %>
          Thinking&hellip;
        <% } else if (coach) { %>
          Refresh suggestions
        <% } else { %>
          Suggest what to fill in &rarr;
        <% } %>
      </button>
    </form>
  </div>
</div>

<% if (isCoaching) { %>
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-4 flex items-center gap-3 text-sm text-blue-900">
    <span class="inline-block w-2 h-2 bg-blue-500 rounded-full animate-pulse"></span>
    <div class="flex-1">
      Claude is reading what you've got, pulling in external context on <%= account.account_name %>, and figuring out what you should ask. Usually 30&ndash;90 seconds.
    </div>
  </div>
  <script>setTimeout(function(){ location.reload(); }, 10000);</script>
<% } else if (coachStatus === 'failed') { %>
  <div class="bg-red-50 border border-red-200 rounded-lg p-3 mb-4 text-sm text-red-900">
    <strong>Coach failed.</strong>
    <% if (dossier?.coach_error) { %><span class="ml-1 font-mono text-xs"><%= dossier.coach_error %></span><% } %>
  </div>
<% } %>

<% if (hasCoachSuggestions && coach.rationale) { %>
  <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 mb-4 text-sm">
    <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mb-1">Where Claude would start</div>
    <div class="text-slate-700"><%= coach.rationale %></div>
    <% if (Array.isArray(coach.sources) && coach.sources.length) { %>
      <details class="mt-2 text-xs">
        <summary class="cursor-pointer text-slate-500 hover:text-slate-700 select-none">Sources (<%= coach.sources.length %>)</summary>
        <ul class="mt-1 space-y-0.5">
          <% coach.sources.forEach(function(s) { %>
            <li>
              <a href="<%= s.url %>" target="_blank" rel="noopener" class="text-slate-600 hover:text-slate-900 underline">
                <%= s.title || s.url %> &nearr;
              </a>
            </li>
          <% }); %>
        </ul>
      </details>
    <% } %>
  </div>
<% } %>

<%
  // Reusable partial-style helper so each field's suggestion block renders
  // the same way. EJS doesn't have local functions cleanly, so this is a
  // plain function that returns HTML as a string. Guard against empty.
  function renderSuggestions(bullets, variant) {
    if (!Array.isArray(bullets) || bullets.length === 0) return '';
    const pillClass = variant === 'questions'
      ? 'bg-blue-50 border-blue-200 text-blue-900'
      : 'bg-emerald-50 border-emerald-200 text-emerald-900';
    const dotClass = variant === 'questions' ? 'bg-blue-400' : 'bg-emerald-500';
    const bulletsHtml = bullets.map(function(b) {
      // Escape the bullet text manually since we're returning raw HTML.
      const escaped = String(b)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      return `<li class="flex items-start gap-2"><span class="inline-block w-1 h-1 rounded-full ${dotClass} mt-2 shrink-0"></span><span>${escaped}</span></li>`;
    }).join('');
    return `
      <div class="mt-2 border ${pillClass} rounded p-3 text-xs">
        <div class="text-[10px] uppercase tracking-wide font-semibold opacity-70 mb-1">AI suggestions &middot; copy what's useful</div>
        <ul class="space-y-1 leading-snug">${bulletsHtml}</ul>
      </div>
    `;
  }
%>

<form method="POST" action="/expand/<%= account.id %>/dossier" class="space-y-5 mb-8">
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <label class="block">
      <div class="text-sm font-semibold text-slate-700">Footprint</div>
      <div class="text-xs text-slate-500 mb-2">
        Team &times; seats &times; health &times; one-line. Where you are in the account today.
      </div>
      <textarea name="footprint" rows="5" maxlength="8000"
                class="w-full text-sm border border-slate-300 rounded p-2 focus:outline-none focus:border-slate-500 font-mono"
                placeholder="- SMB — True Champions program, healthy&#10;- Mid-Market — upsell attach + upstack 50+ accounts&#10;- GOV — rollout in progress&#10;- ENT — coaching rollout starting"><%= dossier?.footprint || '' %></textarea>
      <%- renderSuggestions(coachBullets('footprint'), 'declarative') %>
    </label>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <label class="block">
      <div class="text-sm font-semibold text-slate-700">Destination</div>
      <div class="text-xs text-slate-500 mb-2">
        What they've told you they want next. Stated goal &times; sponsor &times; timing cue.
        Feeds the Phase-2 scanner's search priorities.
      </div>
      <textarea name="destination" rows="5" maxlength="8000"
                class="w-full text-sm border border-slate-300 rounded p-2 focus:outline-none focus:border-slate-500 font-mono"
                placeholder="- AI real-time coaching — Enablement Exec — Sept onsite&#10;- MM upsell attach-rate lift — Mid-Market Team — Q3&#10;- Upstack 50+ deals — Mid-Market Team — ongoing&#10;- Agile templates tied to product launches — Enablement — Q3"><%= dossier?.destination || '' %></textarea>
      <%- renderSuggestions(coachBullets('destination'), 'declarative') %>
    </label>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <label class="block">
      <div class="text-sm font-semibold text-slate-700">Stack &amp; competitive</div>
      <div class="text-xs text-slate-500 mb-2">
        What else is deployed in the account + known objections. The competitive narrative you need to win.
      </div>
      <textarea name="stack_competitive" rows="4" maxlength="8000"
                class="w-full text-sm border border-slate-300 rounded p-2 focus:outline-none focus:border-slate-500 font-mono"
                placeholder="- Gong, Highspot, Salesforce, HR tools all in stack&#10;- Live objection: 'what's unique about Ambition vs Gong+SFDC?'&#10;- Threat: Gong real-time-coaching overlap"><%= dossier?.stack_competitive || '' %></textarea>
      <%- renderSuggestions(coachBullets('stack_competitive'), 'declarative') %>
    </label>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <label class="block">
      <div class="text-sm font-semibold text-slate-700">Open questions</div>
      <div class="text-xs text-slate-500 mb-2">
        What you don't know yet. Each line becomes a search priority when the scanner runs.
      </div>
      <textarea name="open_questions" rows="4" maxlength="8000"
                class="w-full text-sm border border-slate-300 rounded p-2 focus:outline-none focus:border-slate-500 font-mono"
                placeholder="- How do comparable F500s structure coaching?&#10;- What did other Gong+Ambition customers do about the overlap?&#10;- What AI can we demo live at Ohio?&#10;- How is MM measuring attach today?"><%= dossier?.open_questions || '' %></textarea>
      <%- renderSuggestions(coachBullets('open_questions'), 'questions') %>
    </label>
  </div>

  <div class="flex items-center justify-between">
    <div class="text-xs text-slate-500">
      Saves the whole dossier in one go. 8000 chars max per field.
    </div>
    <button type="submit" class="text-sm bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded font-medium">
      Save dossier
    </button>
  </div>
</form>

<!-- ---------- Strategic plan (hypotheses from dossier) ---------- -->
<div id="plan" class="mb-8">
  <div class="flex items-baseline justify-between mb-3">
    <div>
      <h2 class="text-sm font-semibold text-slate-700">
        Strategic plan
        <span class="text-xs text-slate-400 font-normal">&middot; where to expand, odds &times; impact</span>
      </h2>
      <% if (plan?.rationale || plan?.ranking_notes) { %>
        <div class="text-xs text-slate-500 mt-1">Synthesized from dossier + notes + people map. Not scanner output.</div>
      <% } %>
    </div>
    <div class="flex items-center gap-3">
      <% if (plan) { %>
        <form method="POST" action="/expand/<%= account.id %>/plan/clear" class="inline">
          <button type="submit" class="text-xs text-slate-500 hover:text-slate-900 underline">
            Dismiss plan
          </button>
        </form>
      <% } %>
      <% if (hasAnyDossierField) { %>
        <form method="POST" action="/expand/<%= account.id %>/plan" class="inline">
          <button type="submit"
                  class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium disabled:opacity-50"
                  <% if (isPlanning) { %>disabled<% } %>>
            <% if (isPlanning) { %>
              Thinking&hellip;
            <% } else if (plan) { %>
              Regenerate plan
            <% } else { %>
              Generate plan &rarr;
            <% } %>
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <% if (!hasAnyDossierField && !plan) { %>
    <div class="bg-slate-50 border border-slate-200 rounded-lg p-5 text-sm text-slate-500 text-center">
      Fill in any dossier field above &mdash; the planner uses your footprint, destination, stack, and open questions as evidence.
    </div>
  <% } else if (isPlanning) { %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 flex items-center gap-3 text-sm text-blue-900">
      <span class="inline-block w-2 h-2 bg-blue-500 rounded-full animate-pulse"></span>
      <div class="flex-1">
        Synthesizing 3&ndash;5 expansion hypotheses from the dossier. Each one gets an honest odds and impact. ~15&ndash;45 sec.
      </div>
    </div>
    <script>setTimeout(function(){ location.reload(); }, 8000);</script>
  <% } else if (planStatus === 'failed') { %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-900">
      <strong>Plan generation failed.</strong>
      <% if (dossier?.plan_error) { %><span class="ml-1 font-mono text-xs"><%= dossier.plan_error %></span><% } %>
    </div>
  <% } else if (plan && hypotheses.length === 0) { %>
    <div class="bg-slate-50 border border-slate-200 rounded-lg p-5 text-sm text-slate-500">
      The planner returned no hypotheses. Usually this means the dossier is too thin &mdash; add specifics to destination, people map, or notes and try again.
    </div>
  <% } else if (plan && hypotheses.length > 0) { %>

    <% if (plan.rationale) { %>
      <div class="bg-slate-900 text-white rounded-lg p-4 mb-4">
        <div class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-1">Where this account is heading</div>
        <div class="text-sm leading-relaxed"><%= plan.rationale %></div>
        <% if (plan.ranking_notes) { %>
          <div class="text-xs text-slate-400 mt-2 italic"><%= plan.ranking_notes %></div>
        <% } %>
      </div>
    <% } %>

    <!-- Hypothesis comparison table — quick at-a-glance ranking -->
    <div class="bg-white border border-slate-200 rounded-lg overflow-hidden mb-4">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
          <tr>
            <th class="text-left px-3 py-2 font-semibold">#</th>
            <th class="text-left px-3 py-2 font-semibold">Move</th>
            <th class="text-left px-3 py-2 font-semibold">Type</th>
            <th class="text-right px-3 py-2 font-semibold">Odds</th>
            <th class="text-right px-3 py-2 font-semibold">Impact (ARR)</th>
            <th class="text-right px-3 py-2 font-semibold">Timeframe</th>
            <th class="text-right px-3 py-2 font-semibold">Effort</th>
            <th class="text-right px-3 py-2 font-semibold">Conf.</th>
          </tr>
        </thead>
        <tbody>
          <% hypotheses.forEach(function(h, hi) {
            const strat = h?.impact?.strategic_value;
          %>
            <tr class="border-t border-slate-100">
              <td class="px-3 py-2 text-slate-400 tabular-nums"><%= hi + 1 %></td>
              <td class="px-3 py-2">
                <a href="#hypothesis-<%= hi %>" class="font-medium text-slate-800 hover:text-slate-900"><%= h.move_name %></a>
              </td>
              <td class="px-3 py-2">
                <% if (strat && strategicLabel[strat]) { %>
                  <span class="pill <%= strategicColor[strat] %> text-[10px]"><%= strategicLabel[strat] %></span>
                <% } else { %>
                  <span class="text-slate-400 text-xs">&mdash;</span>
                <% } %>
              </td>
              <td class="px-3 py-2 text-right tabular-nums">
                <% if (h.odds != null) { %>
                  <span class="pill <%= oddsColor(h.odds) %> border font-semibold"><%= h.odds %>%</span>
                <% } else { %><span class="text-slate-400">&mdash;</span><% } %>
              </td>
              <td class="px-3 py-2 text-right tabular-nums text-slate-700">
                <%= fmtUsd(h?.impact?.arr_delta_usd) || '—' %>
              </td>
              <td class="px-3 py-2 text-right tabular-nums text-slate-700">
                <%= fmtTimeframe(h?.impact?.timeframe_days) || '—' %>
              </td>
              <td class="px-3 py-2 text-right tabular-nums text-slate-700">
                <%= h.effort_score != null ? effortLabel(h.effort_score) : '—' %>
              </td>
              <td class="px-3 py-2 text-right tabular-nums text-slate-700">
                <%= h.confidence != null ? h.confidence + '/10' : '—' %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Hypothesis detail cards -->
    <div class="space-y-4">
      <% hypotheses.forEach(function(h, hi) {
        const strat = h?.impact?.strategic_value;
        const arr   = fmtUsd(h?.impact?.arr_delta_usd);
        const tf    = fmtTimeframe(h?.impact?.timeframe_days);
        const odds  = h.odds;
        const isTop = hi === 0;
      %>
        <div id="hypothesis-<%= hi %>"
             class="bg-white border-2 rounded-lg overflow-hidden <%= isTop ? 'border-slate-900' : 'border-slate-200' %>">
          <!-- Header: rank + name + strategic badge + odds -->
          <div class="<%= isTop ? 'bg-slate-900 text-white' : 'bg-slate-50 border-b border-slate-200' %> px-5 py-3">
            <div class="flex items-center justify-between gap-3 flex-wrap">
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-xs font-bold <%= isTop ? 'text-slate-400' : 'text-slate-400' %>">#<%= hi + 1 %><% if (isTop) { %> &middot; TOP BET<% } %></span>
                <span class="text-base font-semibold truncate"><%= h.move_name %></span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <% if (strat && strategicLabel[strat]) { %>
                  <span class="pill <%= strategicColor[strat] %> text-[10px]"><%= strategicLabel[strat] %></span>
                <% } %>
                <% if (odds != null) { %>
                  <span class="pill <%= oddsColor(odds) %> border font-bold"><%= odds %>% odds</span>
                <% } %>
              </div>
            </div>
          </div>

          <div class="p-5">
            <!-- Falsifiable claim -->
            <% if (h.hypothesis) { %>
              <div class="text-sm text-slate-700 italic leading-relaxed mb-4">&ldquo;<%= h.hypothesis %>&rdquo;</div>
            <% } %>

            <% if (h.destination_link) { %>
              <div class="mb-4 text-xs">
                <span class="text-slate-500 uppercase tracking-wide font-semibold text-[10px]">Advances:</span>
                <% if (h.destination_link === 'net-new') { %>
                  <span class="pill bg-amber-100 text-amber-800 text-[10px] ml-1">net-new destination</span>
                <% } else { %>
                  <span class="text-slate-700 ml-1"><%= h.destination_link %></span>
                <% } %>
              </div>
            <% } %>

            <!-- Odds bar + impact row -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-3 mb-4">
              <!-- Odds -->
              <div class="bg-slate-50 rounded p-3">
                <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Odds of landing</div>
                <div class="text-2xl font-bold tabular-nums text-slate-900 mt-0.5"><%= odds != null ? odds + '%' : '—' %></div>
                <% if (odds != null) { %>
                  <div class="w-full bg-slate-200 rounded-full h-1.5 mt-1.5 overflow-hidden">
                    <div class="<%= oddsBar(odds) %> h-1.5" style="width: <%= odds %>%"></div>
                  </div>
                <% } %>
                <% if (h.odds_reasoning) { %>
                  <div class="text-[11px] text-slate-500 mt-2 leading-snug"><%= h.odds_reasoning %></div>
                <% } %>
              </div>

              <!-- ARR impact -->
              <div class="bg-slate-50 rounded p-3">
                <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">ARR impact</div>
                <div class="text-2xl font-bold tabular-nums text-emerald-700 mt-0.5"><%= arr || '—' %></div>
                <% if (h?.impact?.seats_delta) { %>
                  <div class="text-[11px] text-slate-600 mt-1"><%= h.impact.seats_delta %></div>
                <% } %>
              </div>

              <!-- Timeframe + effort -->
              <div class="bg-slate-50 rounded p-3">
                <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Timeframe</div>
                <div class="text-2xl font-bold tabular-nums text-slate-900 mt-0.5"><%= tf || '—' %></div>
                <div class="text-[11px] text-slate-500 mt-1">
                  Effort: <span class="font-semibold text-slate-700"><%= h.effort_score != null ? effortLabel(h.effort_score) : '—' %></span>
                </div>
              </div>

              <!-- Confidence -->
              <div class="bg-slate-50 rounded p-3">
                <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Confidence</div>
                <div class="text-2xl font-bold tabular-nums text-slate-900 mt-0.5">
                  <%= h.confidence != null ? h.confidence : '—' %><% if (h.confidence != null) { %><span class="text-xs text-slate-500">/10</span><% } %>
                </div>
                <% if (h.confidence != null) { %>
                  <div class="w-full bg-slate-200 rounded-full h-1.5 mt-1.5 overflow-hidden">
                    <div class="bg-slate-700 h-1.5" style="width: <%= h.confidence * 10 %>%"></div>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Key moves -->
            <% if (Array.isArray(h.key_moves) && h.key_moves.length > 0) { %>
              <div class="mb-4">
                <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mb-2">Key moves</div>
                <ol class="space-y-2">
                  <% h.key_moves.forEach(function(km, ki) { %>
                    <li class="flex items-start gap-3 text-sm">
                      <span class="shrink-0 w-5 h-5 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center text-[10px] font-bold"><%= ki + 1 %></span>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-baseline gap-2 flex-wrap">
                          <% if (km.actor && actorLabel[km.actor]) { %>
                            <span class="pill <%= actorColor[km.actor] %> text-[10px]"><%= actorLabel[km.actor] %></span>
                          <% } %>
                          <span class="text-slate-800 font-medium"><%= km.what %></span>
                        </div>
                        <% if (km.why) { %>
                          <div class="text-xs text-slate-500 mt-0.5 leading-snug"><%= km.why %></div>
                        <% } %>
                      </div>
                    </li>
                  <% }); %>
                </ol>
              </div>
            <% } %>

            <!-- Champion needed -->
            <% if (h.champion_needed) {
              const cn = h.champion_needed;
              const pillCls = cn.from_people_map
                ? 'bg-emerald-50 border-emerald-200 text-emerald-900'
                : 'bg-amber-50 border-amber-200 text-amber-900';
            %>
              <div class="border <%= pillCls %> rounded p-3 mb-4">
                <div class="text-[10px] uppercase tracking-wide font-semibold opacity-70 mb-1">
                  <%= cn.from_people_map ? 'Champion in people map' : 'Champion needs to be recruited' %>
                </div>
                <% if (cn.who) { %>
                  <div class="text-sm font-semibold"><%= cn.who %></div>
                <% } %>
                <% if (cn.ask) { %>
                  <div class="text-xs opacity-80 mt-1 leading-snug"><strong>Ask:</strong> <%= cn.ask %></div>
                <% } %>
              </div>
            <% } %>

            <!-- Key variable + open question -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
              <% if (h.key_variable) { %>
                <div class="bg-red-50 border border-red-200 rounded p-2.5">
                  <div class="text-[10px] uppercase tracking-wide text-red-700 font-semibold">Hinges on</div>
                  <div class="text-slate-700 leading-snug mt-1"><%= h.key_variable %></div>
                </div>
              <% } %>
              <% if (h.open_question) { %>
                <div class="bg-blue-50 border border-blue-200 rounded p-2.5">
                  <div class="text-[10px] uppercase tracking-wide text-blue-700 font-semibold">Answer first</div>
                  <div class="text-slate-700 leading-snug mt-1"><%= h.open_question %></div>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

  <% } else if (hasAnyDossierField && !plan) { %>
    <div class="bg-white border border-slate-200 rounded-lg p-5 text-sm text-slate-500 text-center">
      Click <strong class="text-slate-800">Generate plan</strong> to turn the dossier into 3&ndash;5 ranked expansion bets with odds and ARR impact.
    </div>
  <% } %>
</div>

<!-- ---------- Next step (state-aware CTA) ---------- -->
<%
  // The dossier editor is above, the triggers/paths section is far below. Without
  // an explicit next-step nudge here the AE has no obvious signal that Run scan
  // (top-right) is what unblocks the rest of the flow. This panel mirrors the
  // real state so there's always a single "do this next" button in view.
  const triggerCount = triggers.length;
%>
<% if (!canScan) { %>
  <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-8 flex items-start gap-3">
    <div class="shrink-0 w-6 h-6 rounded-full bg-amber-200 text-amber-900 flex items-center justify-center text-xs font-bold">!</div>
    <div class="flex-1 text-sm">
      <div class="font-semibold text-amber-900">Fill in <em>Destination</em> to unlock the scanner.</div>
      <div class="text-amber-800 text-xs mt-1">
        The destination goals are what the scanner optimizes toward. Without at least one, there's nothing for it to filter on.
      </div>
    </div>
  </div>
<% } else if (isScanning) { %>
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-8 flex items-start gap-3">
    <span class="inline-block w-2 h-2 bg-blue-500 rounded-full animate-pulse mt-2"></span>
    <div class="flex-1 text-sm">
      <div class="font-semibold text-blue-900">Scan running&hellip;</div>
      <div class="text-blue-800 text-xs mt-1">
        Claude is searching the web for movement that strengthens one of your destination goals. The page auto-refreshes when it's done.
      </div>
    </div>
  </div>
<% } else if (!scanStatus) { %>
  <div class="bg-slate-900 text-white rounded-lg p-5 mb-8 flex items-center justify-between gap-4">
    <div class="flex-1">
      <div class="text-[10px] uppercase tracking-wider text-slate-300 font-semibold mb-1">Next step</div>
      <div class="text-base font-semibold">Run the scanner &mdash; find expansion triggers</div>
      <div class="text-xs text-slate-300 mt-1 leading-snug">
        Claude searches the web for external movement (exec hires, earnings calls, product launches, partnerships) that plausibly strengthens one of your <em>Destination</em> goals. 1&ndash;3 min, ~6 searches.
      </div>
    </div>
    <form method="POST" action="/expand/<%= account.id %>/scan" class="shrink-0">
      <button type="submit"
              class="bg-white hover:bg-slate-100 text-slate-900 px-5 py-2.5 rounded font-semibold text-sm whitespace-nowrap">
        Run scan &rarr;
      </button>
    </form>
  </div>
<% } else if (scanStatus === 'failed') { %>
  <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-8 flex items-center justify-between gap-4">
    <div class="flex-1 text-sm">
      <div class="font-semibold text-red-900">Last scan failed.</div>
      <div class="text-red-800 text-xs mt-1">
        <% if (dossier?.last_scan_error) { %><span class="font-mono"><%= dossier.last_scan_error %></span><% } else { %>Retry when ready.<% } %>
      </div>
    </div>
    <form method="POST" action="/expand/<%= account.id %>/scan" class="shrink-0">
      <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded font-medium text-sm whitespace-nowrap">
        Retry scan
      </button>
    </form>
  </div>
<% } else if (scanStatus === 'completed' && triggerCount === 0) { %>
  <div class="bg-white border border-slate-200 rounded-lg p-5 mb-8 flex items-center justify-between gap-4">
    <div class="flex-1 text-sm">
      <div class="font-semibold text-slate-800">Scan found nothing connectable.</div>
      <div class="text-slate-600 text-xs mt-1 leading-snug">
        Add a fresh note below (recent meeting, Slack update, internal intel) or sharpen the <em>Destination</em> field, then re-scan.
      </div>
    </div>
    <form method="POST" action="/expand/<%= account.id %>/scan" class="shrink-0">
      <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded font-medium text-sm whitespace-nowrap">
        Re-scan
      </button>
    </form>
  </div>
<% } else if (scanStatus === 'completed' && triggerCount > 0) {
     const pathsBuilt = Object.keys(pathsByTrigger).length;
     const needsPaths = triggerCount - pathsBuilt;
%>
  <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-5 mb-8 flex items-center justify-between gap-4">
    <div class="flex-1 text-sm">
      <div class="text-[10px] uppercase tracking-wider text-emerald-700 font-semibold mb-1">Next step</div>
      <div class="font-semibold text-emerald-900">
        <%= triggerCount %> trigger<%= triggerCount === 1 ? '' : 's' %> below<% if (needsPaths > 0) { %> &middot; build paths on <%= needsPaths === triggerCount ? 'one' : needsPaths %> to generate hypotheses<% } else { %> &middot; paths built on all<% } %>
      </div>
      <div class="text-emerald-800 text-xs mt-1 leading-snug">
        Each path predicts reply rate, days to meeting, and effort. Warm-intro-via-champion is the default where your people map supports it.
      </div>
    </div>
    <a href="#trigger-0"
       class="shrink-0 bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded font-semibold text-sm whitespace-nowrap">
      Jump to triggers &darr;
    </a>
  </div>
<% } %>

<!-- ---------- People map (reused from /accounts/:id/plan) ---------- -->
<div class="bg-white border border-slate-200 rounded-lg p-5 mb-8">
  <div class="flex items-baseline justify-between mb-3">
    <div>
      <h2 class="text-sm font-semibold text-slate-700">People map</h2>
      <div class="text-xs text-slate-500">
        Single source of truth — edit on the Plan page so both views stay in sync.
      </div>
    </div>
    <a href="/accounts/<%= account.id %>/plan"
       class="text-xs text-slate-600 hover:text-slate-900 underline">
      Manage on Plan &rarr;
    </a>
  </div>

  <% if (contacts.length === 0) { %>
    <div class="text-xs text-slate-400 text-center py-4">
      No contacts yet. Add them on
      <a href="/accounts/<%= account.id %>/plan" class="underline">the Plan page</a>
      — they'll show up here too.
    </div>
  <% } else { %>
    <% if (primaryContacts.length > 0) { %>
      <div class="space-y-2 mb-3">
        <% primaryContacts.forEach(function(c) { %>
          <div class="flex items-start gap-3 text-sm border-l-2 border-slate-200 pl-3 py-1">
            <div class="flex-1">
              <div class="font-medium text-slate-900"><%= c.name %></div>
              <% if (c.title) { %><div class="text-xs text-slate-500"><%= c.title %></div><% } %>
              <% if (c.notes) { %><div class="text-xs text-slate-600 mt-1 whitespace-pre-wrap"><%= c.notes %></div><% } %>
            </div>
            <div class="shrink-0 flex flex-col items-end gap-1">
              <span class="pill <%= roleColor[c.deal_role] || roleColor.unknown %>">
                <%= roleLabel[c.deal_role] || c.deal_role %>
              </span>
              <span class="text-[11px] <%= stanceColor[c.stance] || 'text-slate-500' %>">
                <%= c.stance %>
              </span>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (otherContacts.length > 0) { %>
      <details class="text-xs">
        <summary class="cursor-pointer text-slate-500 hover:text-slate-700 select-none">
          <%= otherContacts.length %> other contact<%= otherContacts.length === 1 ? '' : 's' %>
        </summary>
        <ul class="mt-2 space-y-1">
          <% otherContacts.forEach(function(c) { %>
            <li class="flex items-center gap-2 text-slate-600">
              <span class="pill <%= roleColor[c.deal_role] || roleColor.unknown %> text-[10px]">
                <%= roleLabel[c.deal_role] || c.deal_role %>
              </span>
              <span><%= c.name %></span>
              <% if (c.title) { %><span class="text-slate-400">&middot; <%= c.title %></span><% } %>
            </li>
          <% }); %>
        </ul>
      </details>
    <% } %>
  <% } %>
</div>

<!-- ---------- Notes (chronological) ---------- -->
<div id="notes" class="bg-white border border-slate-200 rounded-lg p-5 mb-8">
  <div class="flex items-baseline justify-between mb-3">
    <h2 class="text-sm font-semibold text-slate-700">Notes
      <span class="text-xs text-slate-400 font-normal">&middot; meeting recaps, Slack chatter, late-arriving intel</span>
    </h2>
    <span class="text-xs text-slate-400"><%= (notes || []).length %></span>
  </div>

  <form method="POST" action="/expand/<%= account.id %>/notes" class="mb-4">
    <textarea name="note" rows="3" maxlength="8000" required
              placeholder="Drop a meeting recap, a Slack update, a hallway conversation — anything that'd matter to the next expansion move."
              class="w-full text-sm border border-slate-300 rounded p-2 focus:outline-none focus:border-slate-500"></textarea>
    <div class="flex justify-end mt-2">
      <button type="submit" class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">
        Add note
      </button>
    </div>
  </form>

  <% if ((notes || []).length === 0) { %>
    <div class="text-xs text-slate-400 text-center py-2">
      Nothing yet. The Verizon-style meeting recap you'd paste in Slack is the right unit of entry.
    </div>
  <% } else { %>
    <ul class="space-y-3">
      <% (notes || []).forEach(function(n) { %>
        <li class="flex items-start gap-3 text-sm border-l-2 border-slate-200 pl-3 py-1">
          <div class="flex-1">
            <div class="text-slate-700 whitespace-pre-wrap"><%= n.note %></div>
            <div class="text-[11px] text-slate-400 mt-1">
              <%= fmtDate(n.created_at) %>
              <% if (n.created_by_name) { %> &middot; <%= n.created_by_name %><% } %>
            </div>
          </div>
          <form method="POST" action="/expand/notes/<%= n.id %>/delete"
                onsubmit="return confirm('Delete this note?');" class="shrink-0">
            <button type="submit" class="text-[11px] text-slate-400 hover:text-red-600">delete</button>
          </form>
        </li>
      <% }); %>
    </ul>
  <% } %>
</div>

<!-- ---------- Triggers (from scanner) + paths ---------- -->
<% if (scanStatus === 'completed' || triggers.length > 0) { %>
  <div class="mb-3 flex items-center justify-between">
    <h2 class="text-lg font-semibold">
      <%= triggers.length %> expansion trigger<%= triggers.length === 1 ? '' : 's' %>
      <% if (dossier?.last_scan_searches != null) { %>
        <span class="text-xs text-slate-500 font-normal">&middot; <%= dossier.last_scan_searches %> web searches</span>
      <% } %>
    </h2>
  </div>

  <% if (triggers.length === 0) { %>
    <div class="bg-white border border-slate-200 rounded-lg p-8 text-sm text-slate-500 text-center mb-8">
      <div class="text-base text-slate-700 mb-1">Nothing connectable surfaced.</div>
      Claude searched but didn't find external movement that plausibly strengthens one of the stated destination goals.
      Worth re-scanning once the dossier has fresher context.
    </div>
  <% } else { %>
    <div class="space-y-6 mb-8">
      <% triggers.forEach(function(t, i) {
        const ps = pathsByTrigger[i];
        const paths = ps && Array.isArray(ps.paths) ? ps.paths : [];
        const carry = t.carry_internally || {};
      %>
        <div id="trigger-<%= i %>" class="bg-white border-2 border-slate-200 rounded-lg p-5">
          <!-- Trigger header: severity + signal_type + destination_link -->
          <div class="flex items-start justify-between gap-4 mb-2">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="pill <%= sevPill(t.severity) %>">SEV <%= t.severity %></span>
              <% if (t.signal_type) { %><span class="pill bg-slate-100 text-slate-700"><%= t.signal_type %></span><% } %>
              <% if (carry.role && carryLabel[carry.role]) { %>
                <span class="pill <%= carryColor[carry.role] %>"><%= carryLabel[carry.role] %></span>
              <% } %>
            </div>
            <span class="text-xs text-slate-400">#<%= i + 1 %></span>
          </div>

          <div class="text-base font-semibold text-slate-900 mb-1"><%= t.trigger_title %></div>
          <% if (t.trigger_summary) { %>
            <div class="text-sm text-slate-600 mb-3"><%= t.trigger_summary %></div>
          <% } %>

          <% if (t.destination_link) { %>
            <div class="mt-3 mb-2">
              <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Advances destination goal</div>
              <div class="text-sm text-slate-800 bg-emerald-50 border-l-2 border-emerald-400 pl-3 py-1"><%= t.destination_link %></div>
            </div>
          <% } %>

          <% if (t.why_this_unlocks) { %>
            <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mt-3 mb-1">Why this strengthens the ask</div>
            <div class="text-sm text-slate-800"><%= t.why_this_unlocks %></div>
          <% } %>

          <% if (carry.who && carry.who !== 'unknown') { %>
            <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mt-3 mb-1">Who should hear this first</div>
            <div class="text-sm text-slate-800"><%= carry.who %></div>
          <% } %>

          <% if (t.champion_talking_point) { %>
            <div class="mt-3 bg-slate-50 border-l-2 border-slate-400 pl-3 py-2 pr-2">
              <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Champion talking point</div>
              <div class="text-sm text-slate-700 italic">&ldquo;<%= t.champion_talking_point %>&rdquo;</div>
            </div>
          <% } %>

          <div class="flex items-center justify-between gap-3 mt-4 flex-wrap text-xs">
            <div>
              <% if (t.source_url) { %>
                <a href="<%= t.source_url %>" target="_blank" rel="noopener"
                   class="text-slate-600 hover:text-slate-900 underline truncate max-w-md inline-block align-middle">
                  Source &nearr;
                </a>
              <% } %>
              <% if (t.source_excerpt) { %>
                <span class="text-slate-400 italic ml-2">&ldquo;<%= t.source_excerpt %>&rdquo;</span>
              <% } %>
            </div>
            <% if (!ps) { %>
              <form method="POST" action="/expand/<%= account.id %>/paths">
                <input type="hidden" name="trigger_index" value="<%= i %>" />
                <button type="submit"
                        class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-1.5 rounded font-medium text-xs">
                  Build paths &rarr;
                </button>
              </form>
            <% } %>
          </div>

          <!-- ============================================================ -->
          <!-- PATH CARDS                                                    -->
          <!-- ============================================================ -->
          <% if (ps && paths.length > 0) {
            const safeM = (p) => p.metrics || {};
            const bestReply = Math.max(...paths.map(p => safeM(p).predicted_reply_rate ?? -1));
            const daysArr = paths.map(p => safeM(p).predicted_days_to_meeting).filter(n => Number.isFinite(n));
            const bestDays = daysArr.length ? Math.min(...daysArr) : null;
            const bestEffort = Math.min(...paths.map(p => safeM(p).effort_score ?? 99));
            const bestConf  = Math.max(...paths.map(p => safeM(p).confidence ?? -1));
          %>
            <div id="paths-<%= ps.id %>" class="mt-6 border-t border-slate-200 pt-5">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-semibold text-slate-700">
                  Hypotheses
                  <% if (ps.selected_path != null) { %>
                    &middot; <span class="text-emerald-700">Path <%= ps.selected_path + 1 %> selected</span>
                    <% if (ps.outcome) { %>
                      &middot; <span class="pill <%= outcomeColors[ps.outcome] || 'bg-slate-100' %>"><%= outcomeLabels[ps.outcome] || ps.outcome %></span>
                    <% } %>
                  <% } %>
                </h3>
                <% if (ps.selected_path == null) { %>
                  <form method="POST" action="/expand/<%= account.id %>/paths">
                    <input type="hidden" name="trigger_index" value="<%= i %>" />
                    <button type="submit" class="text-xs text-slate-500 hover:text-slate-900 underline">Regenerate</button>
                  </form>
                <% } %>
              </div>

              <!-- Comparison table -->
              <div class="bg-white border border-slate-200 rounded-lg overflow-hidden mb-4">
                <table class="w-full text-sm">
                  <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
                    <tr>
                      <th class="text-left px-3 py-2 font-semibold">Path</th>
                      <th class="text-left px-3 py-2 font-semibold">Entry point</th>
                      <th class="text-right px-3 py-2 font-semibold">Reply %</th>
                      <th class="text-right px-3 py-2 font-semibold">Days&nbsp;&rarr;&nbsp;meet</th>
                      <th class="text-right px-3 py-2 font-semibold">Effort</th>
                      <th class="text-right px-3 py-2 font-semibold">Confidence</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% paths.forEach(function(p, pi) {
                      const m = p.metrics || {};
                      const ep = p.entry_point || {};
                      const color = pathColors[pi] || pathColors[0];
                      const isSelected = ps.selected_path === pi;
                      const highlight = (val, best) => (best != null && val === best) ? 'font-semibold text-emerald-700' : 'text-slate-700';
                    %>
                      <tr class="border-t border-slate-100 <%= isSelected ? 'bg-emerald-50' : '' %>">
                        <td class="px-3 py-2">
                          <a href="#path-<%= ps.id %>-<%= pi %>" class="inline-flex items-center gap-2">
                            <span class="inline-block w-2 h-2 rounded-full <%= color.dot %>"></span>
                            <span class="font-medium text-slate-800"><%= p.path_name %></span>
                          </a>
                        </td>
                        <td class="px-3 py-2 text-slate-600 text-xs">
                          <% if (ep.role) { %>
                            <span class="pill <%= carryColor[ep.role] || 'bg-slate-100 text-slate-600' %> text-[10px]"><%= carryLabel[ep.role] || ep.role %></span>
                          <% } %>
                          <% if (ep.who && ep.who !== 'unknown') { %>
                            <span class="ml-1"><%= ep.who %></span>
                          <% } %>
                        </td>
                        <td class="px-3 py-2 text-right tabular-nums <%= highlight(m.predicted_reply_rate, bestReply) %>">
                          <%= m.predicted_reply_rate != null ? m.predicted_reply_rate + '%' : '—' %>
                        </td>
                        <td class="px-3 py-2 text-right tabular-nums <%= highlight(m.predicted_days_to_meeting, bestDays) %>">
                          <%= m.predicted_days_to_meeting != null ? m.predicted_days_to_meeting + 'd' : '—' %>
                        </td>
                        <td class="px-3 py-2 text-right tabular-nums <%= highlight(m.effort_score, bestEffort) %>">
                          <%= effortLabel(m.effort_score) %>
                        </td>
                        <td class="px-3 py-2 text-right tabular-nums <%= highlight(m.confidence, bestConf) %>">
                          <%= m.confidence != null ? m.confidence + '/10' : '—' %>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

              <!-- Detail cards: one per path -->
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                <% paths.forEach(function(p, pi) {
                  const m = p.metrics || {};
                  const ep = p.entry_point || {};
                  const color = pathColors[pi] || pathColors[0];
                  const isSelected = ps.selected_path === pi;
                  const isDimmed = ps.selected_path != null && !isSelected;
                  const reply = m.predicted_reply_rate ?? 0;
                  const conf  = m.confidence ?? 0;
                  const effort = m.effort_score ?? 0;
                %>
                  <div id="path-<%= ps.id %>-<%= pi %>"
                       class="bg-white border-2 <%= color.border %> rounded-lg overflow-hidden flex flex-col
                              <%= isSelected ? color.selected : '' %>
                              <%= isDimmed ? 'opacity-50' : '' %>">
                    <div class="<%= color.header %> px-4 py-2 flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <span class="inline-block w-2 h-2 rounded-full <%= color.dot %>"></span>
                        <span class="text-sm font-semibold">Path <%= pi + 1 %></span>
                      </div>
                      <% if (isSelected) { %><span class="text-[10px] uppercase tracking-wider font-bold">&check; Selected</span><% } %>
                    </div>

                    <div class="p-4 flex-1 flex flex-col">
                      <div class="text-base font-semibold text-slate-900 mb-1"><%= p.path_name %></div>
                      <div class="text-xs text-slate-600 italic mb-3 leading-snug"><%= p.hypothesis %></div>

                      <% if (ep.role) { %>
                        <div class="mb-3 flex items-center gap-2 text-xs">
                          <span class="pill <%= carryColor[ep.role] || 'bg-slate-100 text-slate-600' %> text-[10px]"><%= carryLabel[ep.role] || ep.role %></span>
                          <% if (ep.who && ep.who !== 'unknown') { %>
                            <span class="text-slate-700 font-medium"><%= ep.who %></span>
                          <% } %>
                        </div>
                      <% } %>

                      <!-- Metric grid -->
                      <div class="grid grid-cols-2 gap-3 mb-4">
                        <div class="bg-slate-50 rounded p-2.5">
                          <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Reply %</div>
                          <div class="text-xl font-bold tabular-nums text-slate-900"><%= reply %>%</div>
                          <div class="w-full bg-slate-200 rounded-full h-1 mt-1">
                            <div class="<%= color.bar %> h-1 rounded-full" style="width: <%= Math.min(100, reply * 2) %>%"></div>
                          </div>
                        </div>
                        <div class="bg-slate-50 rounded p-2.5">
                          <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Days &rarr; meet</div>
                          <div class="text-xl font-bold tabular-nums text-slate-900">
                            <%= m.predicted_days_to_meeting != null ? m.predicted_days_to_meeting + 'd' : '—' %>
                          </div>
                          <div class="text-[10px] text-slate-400 mt-1">if booked</div>
                        </div>
                        <div class="bg-slate-50 rounded p-2.5">
                          <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Effort</div>
                          <div class="flex items-baseline gap-1">
                            <div class="text-xl font-bold text-slate-900"><%= effortLabel(effort) %></div>
                            <div class="text-[10px] text-slate-500"><%= ['','<30min','1hr','½ day','1 day','multi-day'][effort] || '' %></div>
                          </div>
                          <div class="flex gap-0.5 mt-1">
                            <% for (let e = 1; e <= 5; e++) { %>
                              <div class="flex-1 h-1 rounded-full <%= e <= effort ? color.bar : 'bg-slate-200' %>"></div>
                            <% } %>
                          </div>
                        </div>
                        <div class="bg-slate-50 rounded p-2.5">
                          <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Confidence</div>
                          <div class="text-xl font-bold tabular-nums text-slate-900"><%= conf %><span class="text-xs text-slate-500">/10</span></div>
                          <div class="w-full bg-slate-200 rounded-full h-1 mt-1">
                            <div class="<%= color.bar %> h-1 rounded-full" style="width: <%= conf * 10 %>%"></div>
                          </div>
                        </div>
                      </div>

                      <!-- Sequence timeline with actor row -->
                      <div class="mb-4">
                        <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mb-2">Sequence</div>
                        <div class="flex items-start gap-1 overflow-x-auto">
                          <% (p.steps || []).forEach(function(step, si) { %>
                            <% if (si > 0) { %>
                              <div class="h-px bg-slate-300 flex-1 mt-3 min-w-[12px]"></div>
                            <% } %>
                            <div class="flex flex-col items-center shrink-0" title="<%= step.action %>">
                              <div class="w-6 h-6 rounded-full <%= channelColor(step.channel) %> flex items-center justify-center text-[11px] font-bold"><%= channelIcon(step.channel) %></div>
                              <div class="text-[9px] text-slate-500 mt-1">D<%= step.day %></div>
                              <div class="text-[9px] text-slate-700 font-medium"><%= step.channel %></div>
                              <% if (step.actor) { %>
                                <div class="text-[9px] px-1 rounded mt-0.5 <%= actorColor[step.actor] || 'bg-slate-100 text-slate-500' %>"><%= actorLabel[step.actor] || step.actor %></div>
                              <% } %>
                            </div>
                          <% }); %>
                        </div>
                      </div>

                      <!-- Ask of champion — the actual message the AE sends to the champion -->
                      <% if (p.ask_of_champion) { %>
                        <div class="mb-3 bg-emerald-50 border-l-2 border-emerald-400 pl-3 py-2">
                          <div class="text-[10px] uppercase tracking-wide text-emerald-700 font-semibold">Ask the champion</div>
                          <div class="text-xs text-slate-700 mt-1 leading-snug"><%= p.ask_of_champion %></div>
                        </div>
                      <% } %>

                      <!-- Destination linkage — why this moves the dossier goal -->
                      <% if (p.destination_goal_advanced) { %>
                        <div class="mb-3 text-[11px]">
                          <span class="font-semibold text-slate-600">Advances:</span>
                          <span class="text-slate-700"><%= p.destination_goal_advanced %></span>
                        </div>
                      <% } %>

                      <!-- Best / worst -->
                      <div class="grid grid-cols-2 gap-2 mb-3 text-[11px]">
                        <div class="bg-emerald-50 border border-emerald-200 rounded p-2">
                          <div class="text-[10px] uppercase tracking-wide text-emerald-700 font-semibold">Best</div>
                          <div class="text-slate-700 leading-snug"><%= p.best_case || '—' %></div>
                        </div>
                        <div class="bg-red-50 border border-red-200 rounded p-2">
                          <div class="text-[10px] uppercase tracking-wide text-red-700 font-semibold">Worst</div>
                          <div class="text-slate-700 leading-snug"><%= p.worst_case || '—' %></div>
                        </div>
                      </div>

                      <% if (p.key_variable) { %>
                        <div class="text-[11px] text-slate-500 mb-3">
                          <span class="font-semibold text-slate-600">Hinges on:</span> <%= p.key_variable %>
                        </div>
                      <% } %>

                      <!-- Drafts, collapsed -->
                      <% if ((p.steps || []).some(s => s.draft_message)) { %>
                        <details class="mb-3 text-xs">
                          <summary class="cursor-pointer text-slate-600 hover:text-slate-900 select-none font-medium">&#9662; Show drafts (<%= (p.steps || []).filter(s => s.draft_message).length %>)</summary>
                          <div class="mt-2 space-y-2">
                            <% (p.steps || []).forEach(function(step) { if (step.draft_message) { %>
                              <div class="bg-slate-50 border-l-2 <%= color.border %> pl-3 py-2 pr-2">
                                <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold flex items-center gap-2">
                                  <span>Day <%= step.day %> &middot; <%= step.channel %> &middot; <%= step.action %></span>
                                  <% if (step.actor) { %>
                                    <span class="pill <%= actorColor[step.actor] || 'bg-slate-100 text-slate-600' %> text-[9px]"><%= actorLabel[step.actor] || step.actor %></span>
                                  <% } %>
                                </div>
                                <div class="text-slate-700 mt-1 whitespace-pre-wrap"><%= step.draft_message %></div>
                              </div>
                            <% } }); %>
                          </div>
                        </details>
                      <% } %>

                      <!-- Select -->
                      <% if (ps.selected_path == null) { %>
                        <form method="POST" action="/expand/paths/<%= ps.id %>/select" class="mt-auto">
                          <input type="hidden" name="path_index" value="<%= pi %>" />
                          <button type="submit"
                                  class="w-full text-xs font-semibold py-2 rounded <%= color.selectBtn %> transition">
                            Select this hypothesis
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                <% }); %>
              </div>

              <!-- Outcome tracker -->
              <% if (ps.selected_path != null && !ps.outcome) { %>
                <div class="mt-4 bg-slate-50 border border-slate-200 rounded-lg p-4">
                  <div class="text-sm font-semibold text-slate-700 mb-2">How did it go?</div>
                  <form method="POST" action="/expand/paths/<%= ps.id %>/outcome" class="flex items-end gap-3 flex-wrap">
                    <div>
                      <select name="outcome" class="text-sm border border-slate-300 rounded px-3 py-1.5">
                        <option value="in_progress">In progress</option>
                        <option value="won">Won (meeting / reply)</option>
                        <option value="no_response">No response</option>
                        <option value="lost">Lost (rejected)</option>
                      </select>
                    </div>
                    <div class="flex-1">
                      <input type="text" name="notes" placeholder="What happened? (optional)" class="w-full text-sm border border-slate-300 rounded px-3 py-1.5" />
                    </div>
                    <button type="submit" class="text-sm bg-slate-900 hover:bg-slate-800 text-white px-4 py-1.5 rounded font-medium">
                      Record outcome
                    </button>
                  </form>
                </div>
              <% } else if (ps.outcome) { %>
                <div class="mt-4 bg-slate-50 border border-slate-200 rounded-lg p-4 text-sm">
                  <span class="pill <%= outcomeColors[ps.outcome] || 'bg-slate-100' %>"><%= outcomeLabels[ps.outcome] || ps.outcome %></span>
                  <% if (ps.outcome_notes) { %><span class="text-slate-600 ml-2"><%= ps.outcome_notes %></span><% } %>
                  <span class="text-xs text-slate-400 ml-2">&middot; recorded <%= fmtDate(ps.outcome_at) %></span>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>
<% } else if (canScan && !isScanning) { %>
  <div class="bg-white border border-slate-200 rounded-lg p-8 text-sm text-slate-500 text-center mb-8">
    <div class="text-base text-slate-700 mb-1">Not scanned yet.</div>
    Click <strong>Run scan</strong> above to ask Claude what's happening externally that strengthens one of your stated destination goals.
  </div>
<% } %>
