<%
  function pill(color, text) {
    const cls = {
      emerald: 'bg-emerald-100 text-emerald-800',
      amber:   'bg-amber-100 text-amber-800',
      slate:   'bg-slate-100 text-slate-700',
      red:     'bg-red-100 text-red-800',
      sky:     'bg-sky-100 text-sky-800',
      violet:  'bg-violet-100 text-violet-800',
    }[color] || 'bg-slate-100 text-slate-700';
    return `<span class="pill ${cls}">${text}</span>`;
  }
  const statusColor = {
    customer: 'emerald',
    prospect: 'sky',
    churned: 'amber',
    disqualified: 'slate',
  };
%>

<div class="mb-6 flex items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Accounts</h1>
    <p class="text-sm text-slate-500 mt-1 max-w-2xl">
      Ambition's account book — current customers, churned accounts, active prospects, and DQs.
      Used by the champion tracker to route a detected move: landing at a live customer → internal
      note; landing at a churned account → win-back play; anywhere else → warm outbound.
    </p>
  </div>
  <% const totalAccounts = (counts.customer||0) + (counts.churned||0) + (counts.prospect||0) + (counts.disqualified||0); %>
  <% if (totalAccounts > 0) { %>
    <form method="POST" action="/accounts/clear" onsubmit="return confirmClearAccounts(this);" class="shrink-0">
      <input type="hidden" name="confirm" value="" id="clearConfirmField" />
      <button type="submit" class="text-xs border border-red-200 text-red-700 hover:bg-red-50 px-3 py-2 rounded font-medium">
        Clear all accounts
      </button>
    </form>
    <script>
      function confirmClearAccounts(form) {
        var typed = window.prompt(
          'This will permanently delete all <%= totalAccounts %> accounts in the book.\n\n' +
          'Prospects, drafts, and sent messages are NOT deleted — only the accounts_registry rows go.\n\n' +
          'Type CLEAR to confirm.'
        );
        if (typed == null) return false;
        form.querySelector('#clearConfirmField').value = typed;
        return (typed || '').trim().toUpperCase() === 'CLEAR';
      }
    </script>
  <% } %>
</div>

<% if (launchReadiness && launchReadiness.total > 0) { %>
  <div class="bg-white border-2 border-slate-900 rounded-lg p-4 mb-6 flex items-center justify-between gap-4 flex-wrap">
    <div>
      <div class="text-xs uppercase tracking-wide text-slate-500">May 15 launch · Performance Graph · Gartner CSO Summit</div>
      <div class="text-lg font-semibold mt-1">
        <span class="text-emerald-700"><%= launchReadiness.ready %></span>
        <span class="text-slate-400">/</span>
        <span><%= launchReadiness.total %></span>
        <span class="text-slate-500 text-sm font-normal">customers launch-ready</span>
      </div>
      <div class="text-xs text-slate-500 mt-0.5">
        Launch-ready = coverage on both Frontline Manager and RevOps, contacted in last 60 days or replied.
      </div>
    </div>
    <% if (launchReadiness.gaps > 0) { %>
      <a href="/accounts?readiness=not_ready"
         class="text-sm bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded font-medium shrink-0">
        Show <%= launchReadiness.gaps %> account<%= launchReadiness.gaps === 1 ? '' : 's' %> needing work →
      </a>
    <% } else { %>
      <span class="pill bg-emerald-100 text-emerald-800">All customers launch-ready</span>
    <% } %>
  </div>
<% } %>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
  <a href="/accounts?status=customer" class="bg-white border border-slate-200 rounded-lg p-4 hover:border-emerald-300">
    <div class="text-xs uppercase tracking-wide text-slate-500">Customers</div>
    <div class="text-2xl font-semibold mt-1 text-emerald-700"><%= counts.customer %></div>
  </a>
  <a href="/accounts?status=churned" class="bg-white border border-slate-200 rounded-lg p-4 hover:border-amber-300">
    <div class="text-xs uppercase tracking-wide text-slate-500">Churned · win-back list</div>
    <div class="text-2xl font-semibold mt-1 text-amber-700"><%= counts.churned %></div>
  </a>
  <a href="/accounts?status=prospect" class="bg-white border border-slate-200 rounded-lg p-4 hover:border-sky-300">
    <div class="text-xs uppercase tracking-wide text-slate-500">Prospects</div>
    <div class="text-2xl font-semibold mt-1 text-sky-700"><%= counts.prospect %></div>
  </a>
  <a href="/accounts?status=disqualified" class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Disqualified</div>
    <div class="text-2xl font-semibold mt-1 text-slate-600"><%= counts.disqualified %></div>
  </a>
</div>

<div class="bg-white border border-slate-200 rounded-lg mb-8">
  <div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between">
    <h2 class="font-semibold">Add accounts (paste CSV)</h2>
    <span class="text-xs text-slate-500">Works with HubSpot / Salesforce exports — headers are auto-mapped</span>
  </div>
  <form method="POST" action="/accounts/import" class="p-4">
    <textarea id="csvTextarea" name="csv" rows="8" placeholder="Paste directly from HubSpot, Salesforce, or Google Sheets — or use the 'Choose file' button above to load a .csv.&#10;Include the header row.&#10;&#10;Recognized columns (any of these work):&#10;  name · Account Name · Company → account_name&#10;  website · Website · Domain     → domain&#10;  type · Account Type · Status   → status  (Customer/Prospect/Churned/Disqualified)&#10;  owner · Account Owner          → owner (email or name)&#10;  industry · vertical · segment  → industry&#10;&#10;Example:&#10;Account Name,Website,Type,Owner,Industry&#10;Acme Logistics,acme.com,Customer,kai@ambition.com,Logistics&#10;Bravo Tech,https://www.bravotech.io,Churned,colin@ambition.com,SaaS"
      class="w-full border border-slate-300 rounded px-3 py-2 text-sm font-mono focus:ring-1 focus:ring-slate-500 focus:outline-none"></textarea>
    <div class="flex items-center justify-between mt-3 gap-4 flex-wrap">
      <span class="text-xs text-slate-500 flex-1 min-w-0">
        Tab- or comma-separated. Domains are normalized (https://, www., paths all stripped). Dedups by domain, then by account_name. Unknown status values map to "prospect" with a warning.
      </span>
      <div class="flex items-center gap-2">
        <label class="cursor-pointer bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 px-3 py-2 rounded text-sm font-medium inline-flex items-center gap-2">
          <span>Choose .csv file</span>
          <input id="csvFileInput" type="file" accept=".csv,.tsv,.txt,text/csv,text/tab-separated-values,text/plain" class="hidden" />
        </label>
        <span id="csvFileLabel" class="text-xs text-slate-500"></span>
        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded text-sm font-medium">Import</button>
      </div>
    </div>
  </form>
  <script>
    (function () {
      // Client-side CSV file loader — reads the file into the textarea so the
      // operator can eyeball it before submitting. We intentionally don't use
      // multipart/form-data; keeps the server endpoint a simple form post.
      var input = document.getElementById('csvFileInput');
      var textarea = document.getElementById('csvTextarea');
      var label = document.getElementById('csvFileLabel');
      if (!input || !textarea) return;
      input.addEventListener('change', function () {
        var file = input.files && input.files[0];
        if (!file) return;
        // 5mb server limit — warn early if we're over it.
        if (file.size > 5 * 1024 * 1024) {
          label.textContent = file.name + ' is too large (>5mb) — split it.';
          label.className = 'text-xs text-red-600';
          return;
        }
        var reader = new FileReader();
        reader.onload = function () {
          textarea.value = reader.result || '';
          label.textContent = file.name + ' loaded (' + (file.size / 1024).toFixed(1) + ' KB) — review and click Import.';
          label.className = 'text-xs text-emerald-700';
          textarea.focus();
        };
        reader.onerror = function () {
          label.textContent = 'Could not read ' + file.name;
          label.className = 'text-xs text-red-600';
        };
        reader.readAsText(file);
      });
    })();
  </script>
  <% if (importResults && importResults.length > 0) { %>
    <div class="px-4 pb-4">
      <div class="text-xs font-semibold text-slate-700 uppercase tracking-wide mb-2">Last import</div>
      <ul class="text-xs space-y-1">
        <% importResults.slice(0, 20).forEach(function(r) { %>
          <li class="<%= r.ok ? (r.warnings ? 'text-amber-700' : 'text-slate-600') : 'text-red-700' %>">
            row <%= r.index + 1 %>:
            <% if (r.ok) { %>
              <%= r.inserted ? 'added' : 'updated' %> — <%= r.name %> (<%= r.status %>)<% if (r.warnings) { %> · <%= r.warnings.join('; ') %><% } %>
            <% } else { %>
              error — <%= (r.errors || []).join('; ') %>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>
</div>

<div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
  <div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between">
    <h2 class="font-semibold">
      <% if (readinessFilter === 'not_ready') { %>
        Customers not launch-ready
        <a href="/accounts" class="text-xs text-slate-500 hover:text-slate-900 font-normal ml-2 underline">Clear filter</a>
      <% } else if (filter) { %>
        <%= filter.charAt(0).toUpperCase() + filter.slice(1) %> accounts
        <a href="/accounts" class="text-xs text-slate-500 hover:text-slate-900 font-normal ml-2 underline">Clear filter</a>
      <% } else { %>
        All accounts
      <% } %>
      <span class="text-slate-400 font-normal">(<%= accounts.length %>)</span>
    </h2>
  </div>
  <% if (accounts.length === 0) { %>
    <div class="p-6 text-sm text-slate-500">No accounts yet. Paste a CSV above to seed the book.</div>
  <% } else { %>
    <table class="w-full text-sm">
      <thead class="text-slate-500 uppercase tracking-wider text-xs bg-slate-50">
        <tr>
          <th class="text-left px-4 py-2">Account</th>
          <th class="text-left px-4 py-2">Domain</th>
          <th class="text-left px-4 py-2">Status</th>
          <th class="text-left px-4 py-2">Launch</th>
          <th class="text-left px-4 py-2">Owner</th>
          <th class="text-left px-4 py-2">Industry</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% accounts.forEach(function(a) { %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3">
              <a href="/accounts/<%= a.id %>" class="font-medium hover:underline"><%= a.account_name %></a>
              <% if (a.notes) { %><div class="text-xs text-slate-500 truncate max-w-md"><%= a.notes %></div><% } %>
            </td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= a.domain || '—' %></td>
            <td class="px-4 py-3"><%- pill(statusColor[a.status] || 'slate', a.status) %></td>
            <td class="px-4 py-3 text-xs">
              <% if (a.status !== 'customer') { %>
                <span class="text-slate-300">—</span>
              <% } else if (a.launchReady === true) { %>
                <span class="pill bg-emerald-100 text-emerald-800">ready</span>
              <% } else if (a.launchReady === false) { %>
                <span class="pill bg-amber-100 text-amber-800"><%= a.launchGaps || 0 %> gap<%= a.launchGaps === 1 ? '' : 's' %></span>
              <% } else { %>
                <span class="text-slate-400">no domain</span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-xs">
              <% if (a.owner_name || a.owner_email) { %>
                <%= a.owner_name || a.owner_email %>
                <% if (a.owner_role) { %><span class="text-slate-400">· <%= a.owner_role %></span><% } %>
              <% } else { %>
                <span class="text-slate-400">—</span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-xs text-slate-600"><%= a.industry || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
