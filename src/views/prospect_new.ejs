<div class="max-w-xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold">Add a prospect to research</h1>
    <p class="text-sm text-slate-500 mt-1">
      Give the agent a company. Claude will search the web for the best timing signal, identify the right contact, score fit, and — if the prospect qualifies — draft a 3-touch sequence that lands on your drafts queue.
    </p>
    <p class="text-xs text-slate-400 mt-2">
      This is a manual test harness. Once Salesforce is connected, accounts will flow in automatically from your book and the same pipeline runs on a schedule.
    </p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-4 bg-red-50 border border-red-200 text-red-800 rounded p-3 text-sm"><%= error %></div>
  <% } %>

  <% if (typeof notice !== 'undefined' && notice) { %>
    <div class="mb-4 bg-amber-50 border border-amber-200 text-amber-800 rounded p-3 text-sm"><%= notice %></div>
  <% } %>

  <form method="POST" action="/prospects/new" class="bg-white border border-slate-200 rounded-lg p-6 space-y-5">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Company <span class="text-red-500">*</span></label>
      <input name="company" required value="<%= form.company || '' %>"
        class="w-full border border-slate-300 rounded px-3 py-2 text-sm" placeholder="Arrive Logistics" />
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Domain</label>
      <input name="domain" value="<%= form.domain || '' %>"
        class="w-full border border-slate-300 rounded px-3 py-2 text-sm" placeholder="arrivelogistics.com" />
      <p class="text-xs text-slate-500 mt-1">Helps the agent find the right company online.</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Known contact name <span class="text-slate-400 font-normal">(optional)</span></label>
      <input name="contact_name" value="<%= form.contact_name || '' %>"
        class="w-full border border-slate-300 rounded px-3 py-2 text-sm" placeholder="leave blank to let the agent find the best persona" />
    </div>

    <div class="flex items-center gap-3 pt-2 border-t border-slate-100">
      <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-5 py-2 rounded text-sm font-medium">
        Research + draft
      </button>
      <a href="/drafts" class="text-sm text-slate-500 hover:text-slate-900 underline">Cancel</a>
      <span class="text-xs text-slate-400 ml-auto">Takes 20–60 seconds (Claude is searching)</span>
    </div>
  </form>
</div>
