<%
  function fmtDate(d) {
    if (!d) return '—';
    const dt = d instanceof Date ? d : new Date(d);
    if (isNaN(dt)) return '—';
    return dt.toISOString().slice(0, 10);
  }
  function fmtRelative(d) {
    if (!d) return '';
    const ms = Date.now() - new Date(d).getTime();
    const min = Math.floor(ms / 60000);
    if (min < 1) return 'just now';
    if (min < 60) return min + 'm ago';
    const hr = Math.floor(min / 60);
    if (hr < 24) return hr + 'h ago';
    return Math.floor(hr / 24) + 'd ago';
  }
  const total = deals.length;
  const scanned = deals.filter(d => d.last_scan_status === 'completed').length;
  const withTriggers = deals.filter(d => d.last_scan_status === 'completed' && d.trigger_count > 0).length;
%>

<div class="mb-6">
  <h1 class="text-2xl font-semibold">Revisit — Closed Lost &amp; Churn</h1>
  <p class="text-sm text-slate-500 mt-1 max-w-3xl">
    Pick a dead deal and scan the web for what has changed since close_date that might neutralise the original loss reason.
    Each scan uses ~6 web searches and takes 1–3 minutes. Triggers are not auto-acted on — they're for you to read and judge.
  </p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Dead deals</div>
    <div class="text-2xl font-semibold mt-1"><%= total %></div>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Scanned</div>
    <div class="text-2xl font-semibold mt-1"><%= scanned %></div>
  </div>
  <div class="bg-white border border-emerald-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-emerald-700">With triggers</div>
    <div class="text-2xl font-semibold mt-1 text-emerald-700"><%= withTriggers %></div>
  </div>
</div>

<% if (total === 0) { %>
  <div class="bg-white border border-slate-200 rounded-lg p-8 text-sm text-slate-500 text-center">
    <div class="text-base text-slate-700 mb-1">No dead deals imported yet.</div>
    Run <code class="text-xs bg-slate-100 px-1 py-0.5 rounded">npm run import:dead-deals -- &lt;file&gt;</code> to bring in your Closed Lost / Churn export.
  </div>
<% } else { %>
  <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="text-left px-4 py-2 font-semibold">Account</th>
          <th class="text-left px-4 py-2 font-semibold">Type</th>
          <th class="text-left px-4 py-2 font-semibold">Closed</th>
          <th class="text-left px-4 py-2 font-semibold">Loss reason</th>
          <th class="text-left px-4 py-2 font-semibold">Last scan</th>
          <th class="text-right px-4 py-2 font-semibold"></th>
        </tr>
      </thead>
      <tbody>
        <% deals.forEach(function(d) {
          const status = d.last_scan_status;
          let pill = null;
          if (status === 'running') pill = { cls: 'bg-amber-100 text-amber-800', label: 'scanning…' };
          else if (status === 'failed') pill = { cls: 'bg-red-100 text-red-800', label: 'failed' };
          else if (status === 'completed' && d.trigger_count > 0) pill = { cls: 'bg-emerald-100 text-emerald-800', label: d.trigger_count + ' trigger' + (d.trigger_count === 1 ? '' : 's') };
          else if (status === 'completed') pill = { cls: 'bg-slate-100 text-slate-600', label: 'no triggers' };
        %>
          <tr class="border-b border-slate-100 hover:bg-slate-50">
            <td class="px-4 py-2.5">
              <a href="/revisit/<%= encodeURIComponent(d.opportunity_id) %>" class="font-medium text-slate-900 hover:underline"><%= d.account_name %></a>
              <div class="text-[11px] text-slate-400"><%= d.opportunity_id %></div>
            </td>
            <td class="px-4 py-2.5 text-slate-600 text-xs"><%= d.account_type_at_close || '—' %></td>
            <td class="px-4 py-2.5 text-slate-600 text-xs"><%= fmtDate(d.close_date) %></td>
            <td class="px-4 py-2.5 text-slate-700"><%= d.loss_reason || '—' %></td>
            <td class="px-4 py-2.5">
              <% if (pill) { %>
                <span class="pill <%= pill.cls %>"><%= pill.label %></span>
                <% if (d.last_signal_scan_at && status === 'completed') { %>
                  <span class="text-[11px] text-slate-400 ml-1"><%= fmtRelative(d.last_signal_scan_at) %></span>
                <% } %>
              <% } else { %>
                <span class="text-xs text-slate-400">never</span>
              <% } %>
            </td>
            <td class="px-4 py-2.5 text-right">
              <a href="/revisit/<%= encodeURIComponent(d.opportunity_id) %>" class="text-xs text-slate-600 hover:text-slate-900 underline">Open →</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
