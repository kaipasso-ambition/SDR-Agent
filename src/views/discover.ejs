<%
  const FY_MONTHS = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const statusColor = {
    customer: 'bg-emerald-100 text-emerald-800',
    prospect: 'bg-sky-100 text-sky-800',
    churned:  'bg-amber-100 text-amber-800',
  };
  const strengthColor = {
    hot:  'bg-red-100 text-red-800',
    warm: 'bg-amber-100 text-amber-800',
    cool: 'bg-slate-100 text-slate-600',
  };
  const signalTypeLabel = {
    linkedin_post: 'LinkedIn',
    press_quote: 'Press',
    conference: 'Conference',
    job_posting: 'Job posting',
    podcast: 'Podcast',
    blog: 'Blog',
    other: 'Web',
  };
  function daysAgo(d) {
    if (!d) return null;
    return Math.floor((Date.now() - new Date(d).getTime()) / 86400000);
  }
  const anyRunning = accounts.some(function(a) { return a.prospect_scan_status === 'running'; });
%>

<% if (anyRunning) { %>
  <script>setTimeout(function(){ location.reload(); }, 8000);</script>
<% } %>

<div class="mb-6">
  <h1 class="text-2xl font-semibold">Discover</h1>
  <p class="text-sm text-slate-500 mt-1">
    Find the 2-3 people at each account who've said or done something that signals buying intent for sales performance + coaching.
  </p>
</div>

<div class="grid grid-cols-3 gap-4 mb-6">
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Prospects</div>
    <div class="text-2xl font-semibold mt-1 text-sky-700"><%= counts.prospect %></div>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Customers</div>
    <div class="text-2xl font-semibold mt-1 text-emerald-700"><%= counts.customer %></div>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Churned</div>
    <div class="text-2xl font-semibold mt-1 text-amber-700"><%= counts.churned %></div>
  </div>
</div>

<% if (accounts.length === 0) { %>
  <div class="bg-white border border-slate-200 rounded-lg p-8 text-center text-slate-500">
    No accounts yet. <a href="/accounts" class="underline text-slate-700">Import your book</a> to get started.
  </div>
<% } else { %>
  <div class="space-y-4">
    <% accounts.forEach(function(a) {
      const ps = a.prospect_scan_result;
      const psStatus = a.prospect_scan_status;
      const isRunning = psStatus === 'running';
      const hasResults = psStatus === 'completed' && ps && ps.prospects && ps.prospects.length > 0;
      const noSignals = psStatus === 'completed' && ps && (!ps.prospects || ps.prospects.length === 0);
      const ago = daysAgo(a.prospect_scan_at);
    %>
      <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
        <div class="px-4 py-3 flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <a href="/accounts/<%= a.id %>" class="font-medium text-slate-900 hover:text-emerald-700 truncate"><%= a.account_name %></a>
            <span class="pill <%= statusColor[a.status] || 'bg-slate-100 text-slate-700' %> shrink-0"><%= a.status %></span>
            <% if (hasResults) { %>
              <span class="pill <%= strengthColor[ps.opportunity_strength] || strengthColor.cool %> shrink-0"><%= ps.opportunity_strength %></span>
            <% } %>
            <% if (a.industry) { %>
              <span class="text-xs text-slate-500 hidden sm:inline"><%= a.industry %></span>
            <% } %>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <% if (a.fiscal_year_end) { %>
              <span class="text-[11px] text-slate-500">FY <%= FY_MONTHS[a.fiscal_year_end] %></span>
            <% } %>
            <% if (a.budget_start_month) { %>
              <span class="text-[11px] text-slate-500">budget <%= FY_MONTHS[a.budget_start_month] %></span>
            <% } %>
            <% if (!a.fiscal_year_end) { %>
              <form method="POST" action="/accounts/<%= a.id %>/fields/lookup-fiscal-year" class="inline">
                <button type="submit" class="text-[11px] text-slate-500 hover:text-slate-900 underline">FY lookup</button>
              </form>
            <% } %>
            <form method="POST" action="/accounts/<%= a.id %>/intel/prospects" class="inline">
              <input type="hidden" name="_from" value="discover" />
              <button type="submit"
                      class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium disabled:bg-slate-400 disabled:cursor-wait"
                      <% if (isRunning) { %>disabled<% } %>>
                <% if (isRunning) { %>Scanning…<% } else if (hasResults || noSignals) { %>Re-scan<% } else { %>Scan<% } %>
              </button>
            </form>
          </div>
        </div>

        <% if (isRunning) { %>
          <div class="px-4 py-3 border-t border-slate-100 text-sm text-slate-500 flex items-center gap-2">
            <span class="inline-block w-2 h-2 bg-slate-400 rounded-full animate-pulse"></span>
            Searching for people at <%= a.account_name %> showing buying signals… (~30-60s)
          </div>
        <% } else if (hasResults) { %>
          <div class="border-t border-slate-100">
            <% if (ps.opportunity_thesis) { %>
              <div class="px-4 py-2.5 bg-slate-50 text-sm text-slate-800 font-medium border-b border-slate-100">
                <%= ps.opportunity_thesis %>
              </div>
            <% } %>
            <div class="divide-y divide-slate-100">
              <% ps.prospects.forEach(function(p) { %>
                <div class="px-4 py-3">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-medium text-slate-900"><%= p.name %></span>
                        <span class="text-xs text-slate-500"><%= p.title %></span>
                        <span class="pill bg-sky-50 text-sky-800"><%= signalTypeLabel[p.signal_type] || p.signal_type %></span>
                        <% if (p.signal_date) { %><span class="text-[11px] text-slate-400"><%= p.signal_date %></span><% } %>
                      </div>
                      <div class="text-sm text-slate-800 mt-1"><%= p.signal %></div>
                      <% if (p.why_it_matters) { %>
                        <div class="text-xs text-slate-500 mt-1 italic"><%= p.why_it_matters %></div>
                      <% } %>
                    </div>
                    <% if (p.source_url) { %>
                      <a href="<%= p.source_url %>" target="_blank" rel="noopener" class="text-xs text-slate-500 hover:text-slate-900 underline shrink-0">Source ↗</a>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
            <% if (a.prospect_scan_at) { %>
              <div class="px-4 py-2 text-[10px] text-slate-400 border-t border-slate-100">
                Scanned <%= ago === 0 ? 'today' : ago === 1 ? 'yesterday' : ago + ' days ago' %>
              </div>
            <% } %>
          </div>
        <% } else if (noSignals) { %>
          <div class="px-4 py-3 border-t border-slate-100 text-xs text-slate-500">
            No active signals found at <%= a.account_name %>. <% if (ps && ps.opportunity_thesis) { %><%= ps.opportunity_thesis %><% } %>
          </div>
        <% } else if (psStatus === 'failed') { %>
          <div class="px-4 py-2 border-t border-slate-100 text-xs text-red-700">
            Scan failed. Click <strong>Scan</strong> to try again.
          </div>
        <% } %>
      </div>
    <% }); %>
  </div>
<% } %>
