<div>
  <% if (contactRows.length === 0) { %>
    <div class="p-4 text-sm text-slate-500">No contacts yet. Add one below or run a scan.</div>
  <% } else { %>
    <ul class="p-3 space-y-1 text-sm">
      <% contactRows.forEach(function(row) { var node = row.node; var depth = row.depth; %>
        <li style="padding-left: <%= Math.min(depth, 6) * 16 %>px;">
          <details class="group">
            <summary class="cursor-pointer list-none flex items-start gap-2 py-1.5 px-2 hover:bg-slate-50 rounded">
              <% if (depth > 0) { %><span class="text-slate-400">└─</span><% } %>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-medium text-slate-900"><%= node.name %></span>
                  <% if (node.source === 'signal_mention') { %><span title="auto-placed from signal">&#128309;</span><% } %>
                  <span class="pill <%= (dealRoleMeta[node.deal_role] || dealRoleMeta.unknown).pill %>"><%= (dealRoleMeta[node.deal_role] || dealRoleMeta.unknown).label %></span>
                  <span class="text-xs <%= (stanceMeta[node.stance] || stanceMeta.neutral).cls %>"><%= (stanceMeta[node.stance] || stanceMeta.neutral).label %></span>
                </div>
                <% if (node.title) { %><div class="text-xs text-slate-500"><%= node.title %></div><% } %>
              </div>
            </summary>
            <form method="POST" action="/contacts/<%= node.id %>" class="bg-slate-50 border border-slate-200 rounded p-3 mt-1 mb-2 space-y-2 text-xs">
              <div class="grid grid-cols-2 gap-2">
                <label class="block"><span class="text-slate-500">Name</span>
                  <input name="name" value="<%= node.name %>" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5" /></label>
                <label class="block"><span class="text-slate-500">Title</span>
                  <input name="title" value="<%= node.title || '' %>" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5" /></label>
                <label class="block"><span class="text-slate-500">Deal role</span>
                  <select name="deal_role" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
                    <% Object.keys(dealRoleMeta).forEach(function(k) { %><option value="<%= k %>" <%= node.deal_role === k ? 'selected' : '' %>><%= dealRoleMeta[k].label %></option><% }); %>
                  </select></label>
                <label class="block"><span class="text-slate-500">Stance</span>
                  <select name="stance" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
                    <% Object.keys(stanceMeta).forEach(function(k) { %><option value="<%= k %>" <%= node.stance === k ? 'selected' : '' %>><%= stanceMeta[k].label %></option><% }); %>
                  </select></label>
              </div>
              <label class="block"><span class="text-slate-500">Reports to</span>
                <select name="reports_to_contact_id" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
                  <option value="">— top of org —</option>
                  <% contacts.filter(function(c){ return c.id !== node.id; }).forEach(function(c) { %>
                    <option value="<%= c.id %>" <%= node.reports_to_contact_id === c.id ? 'selected' : '' %>><%= c.name %> (<%= c.title || '—' %>)</option>
                  <% }); %>
                </select></label>
              <label class="block"><span class="text-slate-500">Notes</span>
                <textarea name="notes" rows="2" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5"><%= node.notes || '' %></textarea></label>
              <div class="flex items-center gap-2">
                <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded font-medium">Save</button>
                <button type="submit" formaction="/contacts/<%= node.id %>/delete" class="text-red-600 hover:text-red-800">Remove</button>
              </div>
            </form>
          </details>
        </li>
      <% }); %>
    </ul>
  <% } %>

  <details class="border-t border-slate-200 p-4 bg-slate-50" <% if (contactRows.length === 0) { %>open<% } %>>
    <summary class="text-xs font-semibold text-slate-700 cursor-pointer">+ Add contact</summary>
    <form method="POST" action="/accounts/<%= account.id %>/contacts" class="mt-3 space-y-2 text-xs">
      <div class="grid grid-cols-2 gap-2">
        <input name="name" placeholder="Name *" required class="border border-slate-300 rounded px-2 py-1" />
        <input name="title" placeholder="Title" class="border border-slate-300 rounded px-2 py-1" />
        <select name="deal_role" class="border border-slate-300 rounded px-2 py-1">
          <% Object.keys(dealRoleMeta).forEach(function(k) { %><option value="<%= k %>" <%= k === 'unknown' ? 'selected' : '' %>><%= dealRoleMeta[k].label %></option><% }); %>
        </select>
        <select name="stance" class="border border-slate-300 rounded px-2 py-1">
          <% Object.keys(stanceMeta).forEach(function(k) { %><option value="<%= k %>" <%= k === 'neutral' ? 'selected' : '' %>><%= stanceMeta[k].label %></option><% }); %>
        </select>
      </div>
      <select name="reports_to_contact_id" class="w-full border border-slate-300 rounded px-2 py-1">
        <option value="">— reports to (top of org) —</option>
        <% contacts.forEach(function(c) { %><option value="<%= c.id %>"><%= c.name %> (<%= c.title || '—' %>)</option><% }); %>
      </select>
      <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded font-medium">Add contact</button>
    </form>
  </details>
</div>
