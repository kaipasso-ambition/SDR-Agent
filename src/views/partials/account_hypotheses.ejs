<%
  var hgenFailed = hgen?.status === 'failed';
  var hgenResult = hgen?.status === 'completed' && hgen.result ? hgen.result : null;
%>
<div>
  <% if (hgenFailed) { %>
    <div class="px-4 py-2 bg-red-50 text-xs text-red-700">Generation failed<% if (hgen.error) { %>: <%= hgen.error %><% } %>.</div>
  <% } else if (hgenResult && hgen.completed_at) { %>
    <div class="px-4 py-2 bg-emerald-50 text-xs text-emerald-800"><%= hgenResult.inserted %> hypothes<%= hgenResult.inserted === 1 ? 'is' : 'es' %> drafted</div>
  <% } %>

  <% if (hypotheses.length === 0 && !hgenRunning) { %>
    <div class="p-4 text-sm text-slate-500">No hypotheses yet. Select signals below and click Generate.</div>
  <% } else if (hypotheses.length === 0 && hgenRunning) { %>
    <div class="p-4 text-sm text-slate-500 flex items-center gap-2">
      <span class="inline-block w-2 h-2 bg-slate-400 rounded-full animate-pulse"></span> Drafting hypotheses…
    </div>
  <% } else { %>
    <ul class="divide-y divide-slate-100">
      <% hypotheses.forEach(function(h) { %>
        <li class="p-4">
          <div class="flex items-center gap-2 flex-wrap mb-1">
            <span class="pill bg-navy-700 text-white"><%= useCaseLabel[h.use_case] || h.use_case %></span>
            <span class="pill bg-sky-100 text-sky-800"><%= h.target_persona_id %></span>
            <span class="text-xs text-slate-500">confidence <%= h.confidence %>/5</span>
            <% if (h.status === 'validated') { %><span class="pill bg-emerald-100 text-emerald-800">validated</span><% } %>
            <% if (h.status === 'disproven') { %><span class="pill bg-slate-100 text-slate-500">disproven</span><% } %>
          </div>
          <p class="text-sm text-slate-800"><%= h.narrative_hook %></p>
          <% if (h.narrative && (h.narrative.current_state || h.narrative.future_state || h.narrative.bridge)) { %>
            <div class="mt-3 space-y-2 text-xs">
              <% if (h.narrative.current_state) { %>
                <div class="bg-slate-50 border-l-2 border-slate-300 rounded px-3 py-2">
                  <div class="uppercase tracking-wide text-[10px] text-slate-500 font-semibold mb-0.5">Today</div>
                  <div class="text-slate-800"><%= h.narrative.current_state %></div>
                </div>
              <% } %>
              <% if (h.narrative.future_state) { %>
                <div class="bg-emerald-50 border-l-2 border-emerald-400 rounded px-3 py-2">
                  <div class="uppercase tracking-wide text-[10px] text-emerald-700 font-semibold mb-0.5">What would be different</div>
                  <div class="text-slate-800"><%= h.narrative.future_state %></div>
                </div>
              <% } %>
              <% if (h.narrative.bridge) { %>
                <div class="bg-violet-50 border-l-2 border-violet-400 rounded px-3 py-2">
                  <div class="uppercase tracking-wide text-[10px] text-violet-700 font-semibold mb-0.5">Bridge</div>
                  <div class="text-slate-800"><%= h.narrative.bridge %></div>
                </div>
              <% } %>
            </div>
          <% } %>
          <details class="mt-2">
            <summary class="text-xs text-slate-500 hover:text-slate-900 cursor-pointer">Edit</summary>
            <form method="POST" action="/hypotheses/<%= h.id %>" class="mt-2 space-y-2 text-xs">
              <textarea name="narrative_hook" rows="2" class="w-full border border-slate-300 rounded px-2 py-1"><%= h.narrative_hook %></textarea>
              <div class="grid grid-cols-3 gap-2">
                <select name="status" class="border border-slate-300 rounded px-2 py-1">
                  <option value="theory" <%= h.status === 'theory' ? 'selected' : '' %>>Theory</option>
                  <option value="validated" <%= h.status === 'validated' ? 'selected' : '' %>>Validated</option>
                  <option value="disproven" <%= h.status === 'disproven' ? 'selected' : '' %>>Disproven</option>
                </select>
                <label class="flex items-center gap-1"><span class="text-slate-500">conf</span>
                  <input type="number" min="1" max="5" name="confidence" value="<%= h.confidence %>" class="w-14 border border-slate-300 rounded px-2 py-1" /></label>
                <button type="submit" class="bg-navy-700 hover:bg-navy-800 text-white rounded font-medium">Save</button>
              </div>
              <button type="submit" formaction="/hypotheses/<%= h.id %>/delete" class="text-red-600 hover:text-red-800 text-xs">Remove</button>
            </form>
          </details>
        </li>
      <% }); %>
    </ul>
  <% } %>

  <div class="border-t border-slate-200 p-4 bg-slate-50">
    <form method="POST" action="/accounts/<%= account.id %>/hypotheses/generate" class="space-y-3">
      <% if (!signals || signals.length === 0) { %>
        <div class="text-xs text-slate-500">No signals yet. Run a scan first.</div>
      <% } else { %>
        <div class="max-h-48 overflow-y-auto bg-white border border-slate-300 rounded p-2">
          <% signals.forEach(function(s) { %>
            <label class="flex items-start gap-2 py-1 text-xs">
              <input type="checkbox" name="signal_ids" value="<%= s.id %>" checked />
              <span class="min-w-0 break-words">
                <% if (s.risk_class) { %><span class="pill <%= riskPill[s.risk_class] || riskPill.neutral %>"><%= (riskLabel[s.risk_class] || 'Context') %></span><% } %>
                <%= s.title %>
              </span>
            </label>
          <% }); %>
        </div>
      <% } %>
      <button type="submit" class="bg-navy-700 hover:bg-navy-800 text-white text-xs px-3 py-1.5 rounded font-medium disabled:bg-slate-400 disabled:cursor-wait"
              <% if (hgenRunning || !signals || signals.length === 0) { %>disabled<% } %>>
        <% if (hgenRunning) { %>Drafting…<% } else { %>Generate hypotheses<% } %>
      </button>
    </form>
  </div>
</div>
