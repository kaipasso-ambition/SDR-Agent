<% if (psRunning) { %>
  <div class="p-4 text-sm text-slate-500 flex items-center gap-2">
    <span class="inline-block w-2 h-2 bg-slate-400 rounded-full animate-pulse"></span> Scanning for active voices…
  </div>
<% } else if (psFailed) { %>
  <div class="p-4 text-sm text-red-700">Prospect scan failed. Click <strong>Scan account</strong> to retry.</div>
<% } else if (visibleProspects.length === 0) { %>
  <div class="p-4 text-sm text-slate-500">No active voices detected.</div>
<% } else { %>
  <div>
    <div class="px-4 py-2 bg-slate-50/50 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-xs text-slate-700"><%= visibleProspects.length %> voice<%= visibleProspects.length === 1 ? '' : 's' %></span>
        <% if (psResult && psResult.opportunity_strength) { %>
          <span class="pill <%= priorityColor[psResult.opportunity_strength] || priorityColor.cool %> text-[10px]"><%= psResult.opportunity_strength %></span>
        <% } %>
      </div>
      <form method="POST" action="/accounts/<%= account.id %>/intel/prospects/clear" class="inline"
            onsubmit="return confirm('Hide all prospects? Data is preserved.');">
        <button type="submit" class="text-[10px] text-slate-400 hover:text-red-700 underline">Hide all</button>
      </form>
    </div>
    <% if (psResult && psResult.opportunity_thesis) { %>
      <div class="px-4 py-2 text-xs text-slate-600 italic border-t border-slate-100"><%= psResult.opportunity_thesis %></div>
    <% } %>
    <div class="divide-y divide-slate-100">
      <% visibleProspects.forEach(function(p) {
        var origIdx = psResult.prospects.indexOf(p);
        var hasStones = Array.isArray(p.stepping_stones) && p.stepping_stones.length > 0;
        var pathRunning = p.warm_path_status === 'running';
        var pathEmpty = p.warm_path_status === 'empty';
      %>
        <div class="px-4 py-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-medium text-slate-900"><%= p.name %></span>
                <span class="text-xs text-slate-500"><%= p.title %></span>
                <span class="pill bg-sky-50 text-sky-800 text-[10px]"><%= signalTypeLabel[p.signal_type] || p.signal_type %></span>
                <% if (p.signal_date) { %><span class="text-[11px] text-slate-400"><%= p.signal_date %></span><% } %>
              </div>
              <div class="text-sm text-slate-800 mt-1"><%= p.signal %></div>
              <% if (p.why_it_matters) { %><div class="text-xs text-slate-500 mt-1 italic"><%= p.why_it_matters %></div><% } %>
            </div>
            <div class="flex flex-col items-end gap-1.5 shrink-0">
              <% if (p.source_url) { %>
                <a href="<%= p.source_url %>" target="_blank" rel="noopener" class="text-xs text-slate-500 hover:text-slate-900 underline">Source ↗</a>
              <% } %>
              <% if (!hasStones && !pathRunning) { %>
                <form method="POST" action="/accounts/<%= account.id %>/prospects/<%= origIdx %>/find-path" class="inline">
                  <button type="submit" class="text-xs text-emerald-700 hover:text-emerald-900 underline">Find related contacts</button>
                </form>
              <% } %>
              <form method="POST" action="/accounts/<%= account.id %>/intel/prospects/<%= origIdx %>/dismiss" class="inline"
                    onsubmit="var r=prompt('Why not relevant? (optional)','');if(r===null)return false;this.querySelector('[name=reason]').value=r;return true;">
                <input type="hidden" name="reason" value="" />
                <button type="submit" class="text-[11px] text-slate-400 hover:text-red-700 underline">Not relevant</button>
              </form>
            </div>
          </div>
          <% if (pathRunning) { %>
            <div class="mt-2 text-xs text-slate-500 flex items-center gap-2">
              <span class="inline-block w-2 h-2 bg-slate-400 rounded-full animate-pulse"></span> Finding related contacts…
            </div>
          <% } else if (hasStones) { %>
            <div class="mt-2 ml-4 border-l-2 border-emerald-200 pl-3 space-y-2">
              <% if (p.approach_summary) { %><div class="text-xs text-emerald-800 font-medium"><%= p.approach_summary %></div><% } %>
              <% p.stepping_stones.forEach(function(ss) { %>
                <div class="text-sm">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-medium text-slate-900"><%= ss.name %></span>
                    <span class="text-xs text-slate-500"><%= ss.title %></span>
                    <% if (ss.source_url) { %><a href="<%= ss.source_url %>" target="_blank" rel="noopener" class="text-[11px] text-slate-400 hover:text-slate-700 underline">↗</a><% } %>
                  </div>
                  <% if (ss.relationship) { %><div class="text-xs text-slate-500"><%= ss.relationship %></div><% } %>
                  <div class="text-xs text-emerald-800 mt-0.5"><%= ss.message_angle %></div>
                </div>
              <% }); %>
            </div>
          <% } else if (pathEmpty) { %>
            <div class="mt-2 text-xs text-slate-500"><%= p.approach_summary || 'No related contacts found.' %></div>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>
