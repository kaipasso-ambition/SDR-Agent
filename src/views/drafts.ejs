<%
  // Human-friendly labels + tag colors
  function label(key) {
    const map = {
      revops: 'RevOps', salesops: 'Sales Ops',
      sales_leader: 'Sales Leader', sales_strategy: 'Sales Strategy',
      vp_plus: 'VP+', c_suite: 'C-Suite', director: 'Director', manager: 'Manager',
      saas: 'SaaS', logistics: 'Logistics', fintech: 'Fintech',
      staffing: 'Staffing', insurance: 'Insurance', proptech: 'PropTech',
      healthtech: 'Healthtech', other: 'Other',
      prospect: 'Prospect', customer: 'Customer', churn: 'Churned',
    };
    return map[key] || key;
  }
  function fitColor(n) {
    if (n == null) return 'bg-slate-100 text-slate-700';
    if (n >= 80) return 'bg-emerald-100 text-emerald-800';
    if (n >= 60) return 'bg-amber-100 text-amber-800';
    return 'bg-red-100 text-red-800';
  }
  function statusColor(s) {
    if (s === 'customer') return 'bg-emerald-100 text-emerald-800';
    if (s === 'churn') return 'bg-red-100 text-red-800';
    return 'bg-amber-100 text-amber-800';
  }
%>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold">Drafts <span class="text-slate-400 text-base font-normal">(<%= drafts.length %> pending)</span></h1>
  <div class="flex items-center gap-2">
    <a href="/brief" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded text-sm font-medium no-underline">
      Today
    </a>
    <a href="/prospects/new" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 px-4 py-2 rounded text-sm font-medium">
      + Add one manually
    </a>
  </div>
</div>


<% if (drafts.length === 0) { %>
  <div class="bg-white border border-slate-200 rounded-lg p-10 text-center text-slate-500">
    No drafts in the queue. Click <strong>+ Add prospect</strong> above to queue one now.
  </div>
<% } %>

<% drafts.forEach(function(d) { %>
  <details class="bg-white border border-slate-200 rounded-lg mb-3 group overflow-hidden">
    <summary class="cursor-pointer p-5 hover:bg-slate-50 list-none">
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap mb-1">
            <h2 class="text-lg font-semibold text-slate-900"><%= d.company %></h2>
            <span class="pill <%= statusColor(d.customer_status) %>"><%= label(d.customer_status) %></span>
          </div>
          <div class="text-sm text-slate-700 mb-3">
            <span class="font-medium"><%= d.contact_name || '—' %></span><% if (d.contact_title) { %> <span class="text-slate-500">· <%= d.contact_title %></span><% } %>
          </div>

          <div class="flex items-center gap-2 flex-wrap mb-3">
            <% if (d.industry) { %><span class="pill bg-blue-100 text-blue-800"><%= label(d.industry) %></span><% } %>
            <% if (d.persona)  { %><span class="pill bg-purple-100 text-purple-800"><%= label(d.persona) %></span><% } %>
            <% if (d.seniority){ %><span class="pill bg-slate-200 text-slate-800"><%= label(d.seniority) %></span><% } %>
            <% const fs = (d.prospect_fit_score ?? d.draft.fit_score); %>
            <span class="pill <%= fitColor(fs) %>">Fit <%= fs ?? '?' %></span>
          </div>

          <% if (d.timing_signal) { %>
            <div class="bg-amber-50 border-l-4 border-amber-400 px-3 py-2 rounded-r text-sm text-amber-900">
              <span class="font-semibold uppercase text-[10px] tracking-wider text-amber-700 mr-2">Why now</span>
              <%= d.timing_signal %>
              <% if (d.timing_signal_source) { %><span class="text-amber-600 text-xs"> · <%= d.timing_signal_source %></span><% } %>
            </div>
          <% } %>
        </div>
        <div class="text-xs text-slate-400 whitespace-nowrap pt-1">queued <%= new Date(d.queued_at).toLocaleString() %></div>
      </div>
    </summary>

    <form class="p-5 border-t border-slate-100 space-y-5" data-draft-id="<%= d.id %>">
      <% if (d.draft.fit_rationale) { %>
        <div class="bg-slate-50 border border-slate-200 rounded p-3 text-sm text-slate-700 space-y-1">
          <div class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-1">Fit rationale</div>
          <% if (d.draft.fit_rationale.persona_fit)     { %><div><span class="font-semibold">Persona:</span> <%= d.draft.fit_rationale.persona_fit %></div><% } %>
          <% if (d.draft.fit_rationale.timing_signal)   { %><div><span class="font-semibold">Timing:</span> <%= d.draft.fit_rationale.timing_signal %></div><% } %>
          <% if (d.draft.fit_rationale.message_rationale){ %><div><span class="font-semibold">Message:</span> <%= d.draft.fit_rationale.message_rationale %></div><% } %>
        </div>
      <% } %>

      <% (d.draft.sequence || []).forEach(function(t, i) { %>
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="pill bg-slate-900 text-white">Touch <%= t.touch %></span>
            <span class="pill bg-slate-100 text-slate-700"><%= t.channel %></span>
          </div>
          <% if (t.channel === 'email') { %>
            <input type="text" name="subject_<%= i %>" value="<%- t.subject || '' %>"
              class="w-full border border-slate-200 rounded px-3 py-2 text-sm font-medium mb-2"
              placeholder="Subject" />
          <% } %>
          <textarea name="body_<%= i %>" rows="<%= t.channel === 'linkedin' ? 4 : 6 %>"
            class="w-full border border-slate-200 rounded px-3 py-2 text-sm font-mono"><%- t.body || '' %></textarea>
          <div class="text-xs text-slate-400 mt-1"><span class="word-count">0</span> words</div>
        </div>
      <% }); %>

      <div class="flex items-center gap-3 pt-2 border-t border-slate-100">
        <button type="button" data-action="approve"
          class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded text-sm font-medium">Approve</button>
        <button type="button" data-action="save"
          class="bg-slate-200 hover:bg-slate-300 text-slate-900 px-4 py-2 rounded text-sm font-medium">Save edits</button>
        <button type="button" data-action="reject"
          class="bg-white hover:bg-red-50 text-red-700 border border-red-200 px-4 py-2 rounded text-sm font-medium ml-auto">Reject</button>
      </div>
      <div class="status text-xs text-slate-500 hidden"></div>
    </form>
  </details>
<% }); %>

<script>
  // Live word count
  function updateCounts(form) {
    form.querySelectorAll('textarea').forEach(function(ta) {
      const count = ta.value.trim().split(/\s+/).filter(Boolean).length;
      const el = ta.parentElement.querySelector('.word-count');
      if (el) el.textContent = count;
      el.parentElement.style.color = count > 75 ? '#b91c1c' : '';
    });
  }
  document.querySelectorAll('form[data-draft-id]').forEach(function(form) {
    updateCounts(form);
    form.addEventListener('input', function() { updateCounts(form); });
  });

  function readDraft(form) {
    const sequence = [];
    let i = 0;
    while (form.querySelector('[name="body_' + i + '"]')) {
      const subjEl = form.querySelector('[name="subject_' + i + '"]');
      const bodyEl = form.querySelector('[name="body_' + i + '"]');
      sequence.push({
        touch: i + 1,
        channel: subjEl ? 'email' : 'linkedin',
        subject: subjEl ? subjEl.value : '',
        body: bodyEl.value,
      });
      i++;
    }
    return { sequence: sequence };
  }

  function showStatus(form, msg, ok) {
    const el = form.querySelector('.status');
    el.classList.remove('hidden');
    el.textContent = msg;
    el.style.color = ok ? '#047857' : '#b91c1c';
  }

  document.querySelectorAll('button[data-action]').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const form = btn.closest('form');
      const id = form.dataset.draftId;
      const action = btn.dataset.action;
      btn.disabled = true;
      try {
        if (action === 'save' || action === 'approve') {
          const draft = readDraft(form);
          const merged = Object.assign({}, window['draft_' + id] || {}, draft);
          await fetch('/api/queue/drafts/' + id, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ draft: merged }),
          });
        }
        if (action === 'approve' || action === 'reject') {
          await fetch('/api/queue/drafts/' + id + '/' + action, { method: 'POST' });
          form.closest('details').remove();
        } else {
          showStatus(form, 'Saved.', true);
        }
      } catch (e) {
        showStatus(form, 'Error: ' + e.message, false);
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
