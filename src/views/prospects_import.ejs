<%
  function badge(ok) {
    return ok ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800';
  }
  const kai   = batch.filter(function(p) { return p.owner_name.toLowerCase() === 'kai'; });
  const colin = batch.filter(function(p) { return p.owner_name.toLowerCase() === 'colin'; });

  const unresolved = Object.entries(ownerStatus).filter(function(e) { return !e[1]; });

  const runningJob = recentJob && recentJob.status === 'running';
  const lastResults = recentJob && recentJob.diagnostics && recentJob.diagnostics.results;
%>

<div class="mb-6 flex items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">
      Pilot batch
      <span class="text-slate-400 text-base font-normal">
        (<%= batch.length %><% if (limit) { %> of <%= fullBatchSize %><% } %>)
      </span>
    </h1>
    <p class="text-sm text-slate-500 mt-1">
      Hand-picked prospects from Kai's and Colin's books — transportation, telecom, and consumer finance.
      Batch is ordered strongest-signal first, alternating owners. Append <code>?limit=N</code> to the URL to run only the top N.
      Owners are hard-coded; drafts land in each owner's queue.
    </p>
    <div class="text-xs text-slate-500 mt-2 flex items-center gap-2">
      <span>Quick limits:</span>
      <a href="/prospects/import?limit=2" class="underline hover:text-slate-900">2</a>
      <a href="/prospects/import?limit=4" class="underline hover:text-slate-900">4</a>
      <a href="/prospects/import?limit=6" class="underline hover:text-slate-900">6</a>
      <a href="/prospects/import" class="underline hover:text-slate-900">all <%= fullBatchSize %></a>
    </div>
  </div>
  <form method="POST" action="/prospects/import">
    <% if (limit) { %><input type="hidden" name="limit" value="<%= limit %>" /><% } %>
    <button
      type="submit"
      <%= (runningJob || unresolved.length > 0) ? 'disabled' : '' %>
      class="bg-slate-900 hover:bg-slate-800 text-white px-5 py-2 rounded text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed"
    >
      <%= runningJob ? 'Running…' : ('Run research + draft (' + batch.length + ')') %>
    </button>
  </form>
</div>

<% if (unresolved.length > 0) { %>
  <div class="mb-4 bg-red-50 border border-red-200 text-red-800 rounded p-3 text-sm">
    <strong>Owner lookup failed for:</strong> <%= unresolved.map(function(e) { return e[0]; }).join(', ') %>.
    Create a user whose name or email starts with that string before running.
  </div>
<% } %>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <% [['Kai', kai], ['Colin', colin]].forEach(function(pair) { %>
    <% var owner = pair[0], rows = pair[1]; %>
    <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between">
        <h2 class="font-semibold"><%= owner %>'s 5</h2>
        <% var resolved = ownerStatus[owner]; %>
        <span class="pill <%= badge(!!resolved) %>">
          <%= resolved ? resolved.email : 'NOT RESOLVED' %>
        </span>
      </div>
      <ul class="divide-y divide-slate-100">
        <% rows.forEach(function(p) { %>
          <li class="px-4 py-3 text-sm">
            <div class="flex items-baseline justify-between gap-2">
              <strong><%= p.company %></strong>
              <span class="text-xs text-slate-400"><%= p.domain %></span>
            </div>
            <p class="text-xs text-slate-600 mt-1"><%= p.signal_note %></p>
          </li>
        <% }); %>
      </ul>
    </div>
  <% }); %>
</div>

<% if (recentJob && !runningJob) { %>
  <div class="mt-8 bg-white border border-slate-200 rounded-lg p-4">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="font-semibold text-lg">Last pilot run</h2>
      <span class="text-xs text-slate-500">
        <%= new Date(recentJob.started_at).toLocaleString() %>
        · <%= recentJob.duration_sec %>s
        · drafted <strong><%= recentJob.drafted_count ?? 0 %></strong>
        · skipped/errored <%= recentJob.skipped_count ?? 0 %>
      </span>
    </div>
    <% if (lastResults && lastResults.length) { %>
      <table class="w-full text-xs">
        <thead class="text-slate-500 uppercase tracking-wider">
          <tr>
            <th class="text-left py-1">Company</th>
            <th class="text-left py-1">Owner</th>
            <th class="text-left py-1">Fit</th>
            <th class="text-left py-1">Drafted?</th>
            <th class="text-left py-1">Reason / error</th>
            <th class="text-right py-1">Time</th>
          </tr>
        </thead>
        <tbody>
          <% lastResults.forEach(function(r) { %>
            <tr class="border-t border-slate-100">
              <td class="py-2"><%= r.company %></td>
              <td class="py-2 text-slate-600"><%= r.owner || r.owner_name %></td>
              <td class="py-2"><%= r.fit_score ?? '—' %></td>
              <td class="py-2">
                <% if (r.drafted) { %>
                  <span class="pill bg-emerald-100 text-emerald-800">drafted</span>
                <% } else if (r.error) { %>
                  <span class="pill bg-red-100 text-red-800">error</span>
                <% } else if (r.disqualified) { %>
                  <span class="pill bg-slate-100 text-slate-700">disqualified</span>
                <% } else { %>
                  <span class="pill bg-amber-100 text-amber-800">skipped</span>
                <% } %>
              </td>
              <td class="py-2 text-slate-600"><%= r.reason || '' %></td>
              <td class="py-2 text-right text-slate-500"><%= r.duration_ms ? Math.round(r.duration_ms / 1000) + 's' : '' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
<% } %>
