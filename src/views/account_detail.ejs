<%
  function pill(color, text) {
    const cls = {
      emerald: 'bg-emerald-100 text-emerald-800',
      amber:   'bg-amber-100 text-amber-800',
      slate:   'bg-slate-100 text-slate-700',
      red:     'bg-red-100 text-red-800',
      sky:     'bg-sky-100 text-sky-800',
      violet:  'bg-violet-100 text-violet-800',
    }[color] || 'bg-slate-100 text-slate-700';
    return `<span class="pill ${cls}">${text}</span>`;
  }
  const statusColor = {
    customer: 'emerald',
    prospect: 'sky',
    churned: 'amber',
    disqualified: 'slate',
  };
  const draftStatusColor = {
    pending: 'amber',
    approved: 'emerald',
    rejected: 'slate',
    sent: 'sky',
  };
  const sourceLabel = {
    customer_champion: 'Customer champion',
    foa: 'Friend of Ambition',
    churned_customer_contact: 'Ex-customer contact',
  };
  const totalChampions = Object.values(championCounts || {}).reduce(function(a,b){return a+b;}, 0);
%>

<div class="mb-6">
  <a href="/accounts" class="text-xs text-slate-500 hover:text-slate-900">← All accounts</a>
  <div class="flex items-start justify-between gap-4 mt-2">
    <div class="flex-1">
      <h1 class="text-2xl font-semibold flex items-center gap-3">
        <%= account.account_name %>
        <%- pill(statusColor[account.status] || 'slate', account.status) %>
        <a href="/accounts/<%= account.id %>/plan" class="ml-auto text-sm bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Game Plan →</a>
      </h1>
      <div class="text-sm text-slate-500 mt-1 flex items-center gap-4 flex-wrap">
        <% if (account.domain) { %>
          <a href="https://<%= account.domain %>" target="_blank" rel="noopener" class="hover:text-slate-900 hover:underline"><%= account.domain %></a>
        <% } %>
        <% if (account.industry) { %><span>· <%= account.industry %></span><% } %>
        <% if (account.owner_name_resolved || account.owner_email_resolved) { %>
          <span>·
            Owner:
            <span class="text-slate-700 font-medium"><%= account.owner_name_resolved || account.owner_email_resolved %></span>
            <% if (account.owner_role) { %><span class="text-slate-500">(<%= account.owner_role %>)</span><% } %>
          </span>
        <% } %>
      </div>
      <%
        const FY_MONTHS = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      %>
      <div class="mt-3 flex items-center gap-4 flex-wrap text-xs text-slate-500">
        <% if (account.fiscal_year_end) { %>
          <span>FY ends <strong class="text-slate-700"><%= FY_MONTHS[account.fiscal_year_end] %></strong></span>
        <% } %>
        <% if (account.budget_start_month) { %>
          <span>Budget planning starts <strong class="text-slate-700"><%= FY_MONTHS[account.budget_start_month] %></strong></span>
        <% } %>
        <% if (account.buyer_timing) { %>
          <span>· <strong class="text-slate-700"><%= account.buyer_timing %></strong></span>
        <% } %>
      </div>

      <details class="mt-3 max-w-2xl" <% if (!account.notes) { %>open<% } %>>
        <summary class="text-xs text-slate-500 hover:text-slate-900 cursor-pointer select-none">
          <% if (account.notes) { %>Notes (click to edit)<% } else { %>Add notes — feeds the weekly signal scan<% } %>
        </summary>
        <% if (account.notes) { %>
          <p class="text-sm text-slate-600 mt-2 whitespace-pre-wrap"><%= account.notes %></p>
        <% } %>
        <form method="POST" action="/accounts/<%= account.id %>/notes" class="mt-2">
          <textarea name="notes" rows="3" maxlength="4000"
            placeholder="e.g. SDR team uses Ambition; Ascend AE team is our Q2 expansion target. New CRO started in Feb — background in stack consolidation."
            class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:ring-1 focus:ring-slate-500 focus:outline-none"><%= account.notes || '' %></textarea>
          <div class="flex justify-end mt-1">
            <button type="submit" class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">
              Save notes
            </button>
          </div>
        </form>
      </details>

      <details class="mt-3 max-w-2xl" <% if (!account.fiscal_year_end && !account.buyer_timing && !account.sales_perf_topics) { %>open<% } %>>
        <summary class="text-xs text-slate-500 hover:text-slate-900 cursor-pointer select-none">
          Fiscal calendar, buyer timing & sales-perf topics
        </summary>
        <% if (!account.fiscal_year_end || !account.budget_start_month) { %>
          <form method="POST" action="/accounts/<%= account.id %>/fields/lookup-fiscal-year" class="mt-2 mb-2">
            <button type="submit"
                    class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">
              Look up fiscal year + budget cycle (AI)
            </button>
            <span class="text-[11px] text-slate-400 ml-2">Haiku — fast + cheap</span>
          </form>
        <% } %>
        <form method="POST" action="/accounts/<%= account.id %>/fields" class="mt-2 space-y-3 text-xs">
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">FY ends</label>
              <select name="fiscal_year_end" class="block w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
                <option value="">Unknown</option>
                <% for (let m = 1; m <= 12; m++) { %>
                  <option value="<%= m %>" <%= account.fiscal_year_end === m ? 'selected' : '' %>><%= FY_MONTHS[m] %></option>
                <% } %>
              </select>
            </div>
            <div>
              <label class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Budget planning starts</label>
              <select name="budget_start_month" class="block w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
                <option value="">Unknown</option>
                <% for (let m = 1; m <= 12; m++) { %>
                  <option value="<%= m %>" <%= account.budget_start_month === m ? 'selected' : '' %>><%= FY_MONTHS[m] %></option>
                <% } %>
              </select>
            </div>
            <div>
              <label class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Buyer timing</label>
              <input type="text" name="buyer_timing" value="<%= account.buyer_timing || '' %>"
                     placeholder="e.g. renewal March, new CRO started Feb"
                     class="block w-full border border-slate-300 rounded px-2 py-1 mt-0.5" />
            </div>
          </div>
          <div>
            <label class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">What they're talking about (sales coaching & performance)</label>
            <textarea name="sales_perf_topics" rows="3" maxlength="4000"
              placeholder="e.g. Mentioned coaching effectiveness on earnings call Q3. VP Sales posted about rep ramp challenges on LinkedIn. RFP for sales performance platform expected Q1."
              class="block w-full border border-slate-300 rounded px-3 py-2 mt-0.5"><%= account.sales_perf_topics || '' %></textarea>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">Save</button>
          </div>
        </form>
      </details>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Prospects researched</div>
    <div class="text-2xl font-semibold mt-1"><%= prospects.length %></div>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Drafts (all states)</div>
    <div class="text-2xl font-semibold mt-1"><%= drafts.length %></div>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Messages sent</div>
    <div class="text-2xl font-semibold mt-1"><%= sent.length %></div>
    <% const replied = sent.filter(function(s){return s.reply_received;}).length; %>
    <% if (replied > 0) { %><div class="text-xs text-emerald-700 mt-1"><%= replied %> replies</div><% } %>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Champions tracked</div>
    <div class="text-2xl font-semibold mt-1"><%= totalChampions %></div>
    <% if (totalChampions > 0) { %>
      <div class="text-xs text-slate-500 mt-1">
        <% if (championCounts.customer_champion) { %><%= championCounts.customer_champion %> champ<% } %><% if (championCounts.foa) { %><% if (championCounts.customer_champion) { %> · <% } %><%= championCounts.foa %> FoA<% } %><% if (championCounts.churned_customer_contact) { %> · <%= championCounts.churned_customer_contact %> ex<% } %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/pulse', {
  signals: signals,
  archivedSignals: typeof archivedSignals !== 'undefined' ? archivedSignals : [],
  signalArchiveCount: signalArchiveCount,
  archiveOpen: typeof archiveOpen !== 'undefined' ? archiveOpen : false,
  account: account,
  rescanStatus: typeof rescanStatus !== 'undefined' ? rescanStatus : null,
}) %>

<% if (account.status === 'customer' && coverage) { %>
  <%
    const stateColor = {
      covered:    { bg: 'bg-emerald-50', border: 'border-emerald-200', pill: 'bg-emerald-100 text-emerald-800', label: 'Covered' },
      stale:      { bg: 'bg-amber-50',   border: 'border-amber-200',   pill: 'bg-amber-100 text-amber-800',     label: 'Stale — re-reach' },
      researched: { bg: 'bg-sky-50',     border: 'border-sky-200',     pill: 'bg-sky-100 text-sky-800',         label: 'Researched, not contacted' },
      gap:        { bg: 'bg-slate-50',   border: 'border-slate-200',   pill: 'bg-slate-100 text-slate-700',     label: 'No coverage' },
    };
  %>
  <div class="bg-white border border-slate-200 rounded-lg mb-6 overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between">
      <div>
        <h2 class="font-semibold">Launch-readiness map</h2>
        <div class="text-xs text-slate-500 mt-0.5">
          Performance Graph launch · May 15 · Gartner CSO Summit · covered = contacted in last 60 days or replied
        </div>
      </div>
      <% if (coverage.launchReady) { %>
        <span class="pill bg-emerald-100 text-emerald-800">Launch-ready</span>
      <% } else { %>
        <% const gapCount = coverage.personas.filter(function(p){return p.state === 'gap' || p.state === 'stale';}).length; %>
        <span class="pill bg-amber-100 text-amber-800">
          <%= gapCount %> gap<%= gapCount === 1 ? '' : 's' %>
        </span>
      <% } %>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
      <% coverage.personas.forEach(function(p, idx) {
        const sc = stateColor[p.state] || stateColor.gap;
      %>
        <div class="<%= sc.bg %> <%= idx === 0 ? 'md:border-r' : '' %> border-slate-200 p-4">
          <div class="flex items-center justify-between mb-1">
            <div class="font-medium"><%= p.label %></div>
            <span class="pill <%= sc.pill %>"><%= sc.label %></span>
          </div>
          <div class="text-xs text-slate-600 mb-3"><%= p.why %></div>

          <% if (p.contacts.length > 0) { %>
            <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Contacts in this bucket</div>
            <ul class="text-xs space-y-1 mb-3">
              <% p.contacts.slice(0, 5).forEach(function(c) { %>
                <li>
                  <span class="font-medium text-slate-800"><%= c.contact_name || '(name missing)' %></span>
                  <% if (c.contact_title) { %><span class="text-slate-500"> — <%= c.contact_title %></span><% } %>
                  <% if (c.last_reply_at) { %>
                    <span class="text-emerald-700"> · replied <%= new Date(c.last_reply_at).toLocaleDateString() %></span>
                  <% } else if (c.last_contacted_at) { %>
                    <span class="text-slate-500"> · last touch <%= new Date(c.last_contacted_at).toLocaleDateString() %></span>
                  <% } else { %>
                    <span class="text-slate-400"> · not contacted</span>
                  <% } %>
                </li>
              <% }); %>
              <% if (p.contacts.length > 5) { %>
                <li class="text-slate-500">+ <%= p.contacts.length - 5 %> more</li>
              <% } %>
            </ul>
          <% } else { %>
            <div class="text-xs text-slate-500 italic mb-3">No contacts in this persona yet on <%= account.domain || 'this account' %>.</div>
          <% } %>

          <form method="POST" action="/accounts/<%= account.id %>/draft-launch" class="inline">
            <input type="hidden" name="persona" value="<%= p.id %>" />
            <button type="submit" class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">
              <% if (p.state === 'gap') { %>Draft May 15th intro
              <% } else if (p.state === 'stale') { %>Draft re-reach
              <% } else if (p.state === 'researched') { %>Draft first touch
              <% } else { %>Draft follow-up<% } %>
            </button>
          </form>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>

<div class="bg-white border border-slate-200 rounded-lg mb-6 overflow-hidden">
  <div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between">
    <h2 class="font-semibold">Prospects on this account</h2>
    <span class="text-xs text-slate-500">Matched by domain</span>
  </div>
  <% if (prospects.length === 0) { %>
    <div class="p-6 text-sm text-slate-500">
      No prospects researched under this domain yet.
      <% if (account.domain) { %>
        Any prospect added with domain <code class="bg-slate-100 px-1 rounded"><%= account.domain %></code> will show up here.
      <% } else { %>
        Add a domain to this account so the outbound pipeline can match prospects to it.
      <% } %>
    </div>
  <% } else { %>
    <table class="w-full text-sm">
      <thead class="text-slate-500 uppercase tracking-wider text-xs bg-slate-50">
        <tr>
          <th class="text-left px-4 py-2">Contact</th>
          <th class="text-left px-4 py-2">Persona</th>
          <th class="text-left px-4 py-2">Fit</th>
          <th class="text-left px-4 py-2">Signal</th>
          <th class="text-right px-4 py-2">Researched</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% prospects.forEach(function(p) { %>
          <tr>
            <td class="px-4 py-3">
              <div class="font-medium"><%= p.contact_name || '—' %></div>
              <% if (p.contact_title) { %><div class="text-xs text-slate-500"><%= p.contact_title %></div><% } %>
            </td>
            <td class="px-4 py-3 text-xs text-slate-600">
              <% if (p.persona) { %><%= p.persona %><% } else { %>—<% } %>
              <% if (p.seniority) { %><span class="text-slate-400"> · <%= p.seniority %></span><% } %>
            </td>
            <td class="px-4 py-3">
              <% if (p.disqualified) { %>
                <span class="pill bg-slate-100 text-slate-700">DQ</span>
              <% } else if (p.fit_score != null) { %>
                <span class="font-medium <%= p.fit_score >= 80 ? 'text-emerald-700' : p.fit_score >= 60 ? 'text-slate-800' : 'text-slate-500' %>"><%= p.fit_score %></span>
              <% } else { %>—<% } %>
            </td>
            <td class="px-4 py-3 text-xs text-slate-600 max-w-md truncate">
              <%= p.disqualified ? p.disqualify_reason : (p.timing_signal || '—') %>
            </td>
            <td class="px-4 py-3 text-right text-xs text-slate-500">
              <%= p.researched_at ? new Date(p.researched_at).toLocaleDateString() : '—' %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<% if (drafts.length > 0) { %>
  <div class="bg-white border border-slate-200 rounded-lg mb-6 overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between">
      <h2 class="font-semibold">Drafts</h2>
      <a href="/drafts" class="text-xs text-slate-500 hover:text-slate-900 underline">All drafts →</a>
    </div>
    <table class="w-full text-sm">
      <thead class="text-slate-500 uppercase tracking-wider text-xs bg-slate-50">
        <tr>
          <th class="text-left px-4 py-2">Contact</th>
          <th class="text-left px-4 py-2">Campaign</th>
          <th class="text-left px-4 py-2">Status</th>
          <th class="text-right px-4 py-2">Queued</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% drafts.forEach(function(d) { %>
          <tr>
            <td class="px-4 py-3"><%= d.contact_name || '—' %></td>
            <td class="px-4 py-3 text-xs text-slate-600"><%= d.campaign_name || '<em class="text-slate-400">generic</em>' %></td>
            <td class="px-4 py-3"><%- pill(draftStatusColor[d.status] || 'slate', d.status) %></td>
            <td class="px-4 py-3 text-right text-xs text-slate-500"><%= new Date(d.queued_at).toLocaleDateString() %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (sent.length > 0) { %>
  <div class="bg-white border border-slate-200 rounded-lg mb-6 overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-200">
      <h2 class="font-semibold">Sent messages</h2>
    </div>
    <table class="w-full text-sm">
      <thead class="text-slate-500 uppercase tracking-wider text-xs bg-slate-50">
        <tr>
          <th class="text-left px-4 py-2">Contact</th>
          <th class="text-left px-4 py-2">Touch</th>
          <th class="text-left px-4 py-2">Subject</th>
          <th class="text-left px-4 py-2">Reply?</th>
          <th class="text-right px-4 py-2">Sent</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% sent.forEach(function(s) { %>
          <tr>
            <td class="px-4 py-3"><%= s.contact_name || '—' %></td>
            <td class="px-4 py-3 text-xs text-slate-600">
              <%= s.touch ? ('T' + s.touch) : '—' %><% if (s.channel) { %> · <%= s.channel %><% } %>
            </td>
            <td class="px-4 py-3 text-xs text-slate-700 max-w-md truncate"><%= s.subject || '—' %></td>
            <td class="px-4 py-3">
              <% if (s.reply_received) { %>
                <span class="pill bg-emerald-100 text-emerald-800">replied</span>
              <% } else { %>
                <span class="text-slate-400 text-xs">no</span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-right text-xs text-slate-500"><%= new Date(s.sent_at).toLocaleDateString() %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
