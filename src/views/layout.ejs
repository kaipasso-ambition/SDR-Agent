<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Ambition SDR</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen">
  <% if (typeof user !== 'undefined' && user) { %>
    <nav class="bg-white border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href="/" class="font-semibold text-slate-900">Ambition SDR</a>
          <a href="/" class="text-sm text-slate-600 hover:text-slate-900">Dashboard</a>
          <a href="/drafts" class="text-sm text-slate-600 hover:text-slate-900">Drafts</a>
          <a href="/replies" class="text-sm text-slate-600 hover:text-slate-900">Replies</a>
          <a href="/prospects/new" class="text-sm text-slate-600 hover:text-slate-900">Add prospect</a>
          <a href="/settings" class="text-sm text-slate-600 hover:text-slate-900">Settings</a>
        </div>
        <div class="flex items-center gap-3 text-sm text-slate-500">
          <span><%= user.name || user.email %></span>
          <form method="POST" action="/logout" class="inline">
            <button type="submit" class="text-slate-500 hover:text-slate-900 underline">Log out</button>
          </form>
        </div>
      </div>
    </nav>
  <% } %>

  <% if (typeof activeJob !== 'undefined' && activeJob) { %>
    <% if (activeJob.status === 'running') { %>
      <%
        const runningMs = Date.now() - new Date(activeJob.started_at).getTime();
        const runningSec = Math.floor(runningMs / 1000);
        const stuck = runningSec > 300; // 5 minutes = probably dead
      %>
      <div class="<%= stuck ? 'bg-amber-50 border-amber-200 text-amber-900' : 'bg-emerald-50 border-emerald-200 text-emerald-900' %> border-b">
        <div class="max-w-6xl mx-auto px-4 py-3 text-sm flex items-center gap-3">
          <span class="inline-block w-2 h-2 <%= stuck ? 'bg-amber-500' : 'bg-emerald-500' %> rounded-full animate-pulse"></span>
          <div class="flex-1">
            <% if (stuck) { %>
              <strong>Discovery has been running for <%= Math.floor(runningSec / 60) %> min — likely stuck.</strong>
              Background task may have failed silently. Check Railway logs (Deployments → live deploy → Logs) for <code>[discovery]</code> lines, or cancel and retry.
            <% } else { %>
              <strong>Discovering <%= activeJob.requested_count %> new prospects</strong> (<%= runningSec %>s elapsed).
              Claude is searching the web and drafting sequences. Drafts appear as each one finishes (typically 2–4 min total).
            <% } %>
          </div>
          <% if (stuck) { %>
            <form method="POST" action="/discover/cancel" class="inline">
              <button class="underline text-amber-800 hover:text-amber-900">Cancel</button>
            </form>
          <% } else { %>
            <a href="/drafts" class="underline text-emerald-800 hover:text-emerald-900">View drafts →</a>
          <% } %>
        </div>
      </div>
      <script>setTimeout(function() { location.reload(); }, 15000);</script>
    <% } else if (activeJob.status === 'completed') { %>
      <div class="bg-slate-50 border-b border-slate-200 text-slate-800">
        <div class="max-w-6xl mx-auto px-4 py-3 text-sm flex items-center gap-3">
          <span class="text-emerald-600">✓</span>
          <div class="flex-1">
            <strong>Discovery finished.</strong>
            <%= activeJob.drafted_count %> new drafts queued<% if (activeJob.skipped_count) { %>, <%= activeJob.skipped_count %> saved without a draft (weak signal)<% } %>.
          </div>
          <a href="/drafts" class="underline text-slate-600 hover:text-slate-900">View drafts →</a>
        </div>
      </div>
    <% } else if (activeJob.status === 'failed') { %>
      <div class="bg-red-50 border-b border-red-200 text-red-900">
        <div class="max-w-6xl mx-auto px-4 py-3 text-sm">
          <strong>Discovery failed.</strong>
          <% if (activeJob.error) { %><span class="text-red-800"><%= activeJob.error %></span><% } %>
          <a href="/drafts" class="underline ml-2">Try again</a>
        </div>
      </div>
    <% } %>
  <% } %>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <%- body %>
  </main>
</body>
</html>
