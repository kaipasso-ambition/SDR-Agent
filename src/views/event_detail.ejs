<%
  const statusMeta = {
    planning:  { label: 'Planning',  cls: 'bg-amber-100 text-amber-900' },
    active:    { label: 'Active',    cls: 'bg-emerald-100 text-emerald-900' },
    completed: { label: 'Completed', cls: 'bg-slate-100 text-slate-700' },
    cancelled: { label: 'Cancelled', cls: 'bg-slate-100 text-slate-500' },
  };
  const inviteStatusMeta = {
    target:   { label: 'Target',   cls: 'bg-slate-100 text-slate-700' },
    invited:  { label: 'Invited',  cls: 'bg-sky-100 text-sky-800' },
    accepted: { label: 'Accepted', cls: 'bg-emerald-100 text-emerald-800' },
    declined: { label: 'Declined', cls: 'bg-slate-100 text-slate-500' },
    met:      { label: 'Met',      cls: 'bg-violet-100 text-violet-800' },
    passed:   { label: 'Passed',   cls: 'bg-slate-100 text-slate-400' },
  };
  const accountStatusMeta = {
    customer:     { label: 'Customer',     cls: 'bg-emerald-50 text-emerald-800 border-emerald-200' },
    prospect:     { label: 'Prospect',     cls: 'bg-sky-50 text-sky-800 border-sky-200' },
    churned:      { label: 'Churned',      cls: 'bg-amber-50 text-amber-800 border-amber-200' },
    disqualified: { label: 'Disqualified', cls: 'bg-slate-50 text-slate-500 border-slate-200' },
  };
  const kindLabel = { event: 'Event', campaign: 'Campaign', one_off: 'One-off' };
  function shortDate(d) {
    if (!d) return '—';
    return new Date(d).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }
  const s = statusMeta[event.status] || statusMeta.planning;
  const slot = event.personal_invite_session || null;
  const hasSlot = !!(slot && (slot.title || slot.speaker));

  // Tallies — what's the AE actually working?
  const counts = { target: 0, invited: 0, accepted: 0, declined: 0, met: 0, passed: 0 };
  attendees.forEach(function(a) {
    if (counts[a.invite_status] !== undefined) counts[a.invite_status]++;
  });
  const total = attendees.length;
%>

<div class="mb-5">
  <a href="/events" class="text-xs text-slate-500 hover:text-slate-900">← Events</a>
  <div class="flex items-start justify-between gap-4 mt-2 flex-wrap">
    <div class="min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <h1 class="text-2xl font-semibold"><%= event.name %></h1>
        <span class="pill <%= s.cls %>"><%= s.label %></span>
      </div>
      <div class="text-sm text-slate-500 mt-1">
        <%= kindLabel[event.kind] || 'Event' %>
        <% if (event.event_date) { %> · <%= shortDate(event.event_date) %><% } %>
        <% if (event.location) { %> · <%= event.location %><% } %>
      </div>
    </div>
  </div>
</div>

<!-- Jared's session banner -->
<% if (hasSlot) { %>
  <div class="bg-violet-50 border border-violet-200 rounded-lg p-4 mb-6">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="min-w-0">
        <div class="text-[10px] uppercase tracking-wide font-semibold text-violet-700 mb-1">🎤 Our session · limited seats</div>
        <div class="font-semibold text-slate-900"><%= slot.title || '(session title TBD)' %></div>
        <div class="text-sm text-slate-700 mt-0.5">
          <% if (slot.speaker) { %><%= slot.speaker %><% } %>
          <% if (slot.session_time) { %> · <%= slot.session_time %><% } %>
          <% if (slot.session_url) { %>
            · <a href="<%= slot.session_url %>" target="_blank" rel="noopener" class="underline text-violet-700">session page →</a>
          <% } %>
        </div>
        <% if (slot.seat_cap_note) { %>
          <div class="text-xs text-violet-800 mt-1"><%= slot.seat_cap_note %></div>
        <% } %>
      </div>
      <div class="text-right shrink-0 text-sm text-slate-700">
        <div><strong class="text-violet-800"><%= counts.invited + counts.accepted + counts.met %></strong> invited · <strong class="text-emerald-700"><%= counts.accepted %></strong> accepted</div>
        <div class="text-[11px] text-slate-500">of <%= total %> target<%= total === 1 ? '' : 's' %></div>
      </div>
    </div>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <section class="lg:col-span-2 space-y-6">

    <!-- TARGETS: the main execution surface -->
    <div id="attendees" class="bg-white border border-slate-200 rounded-lg overflow-hidden">
      <header class="px-4 py-3 border-b border-slate-200 flex items-center justify-between gap-3 flex-wrap">
        <div>
          <h2 class="font-semibold">Targets</h2>
          <p class="text-xs text-slate-500 mt-0.5">
            People you want to move at this event. Draft a session invite from our speaker, or a casual "are you going?" note.
          </p>
        </div>
        <div class="text-xs text-slate-600 flex items-center gap-2">
          <button onclick="document.getElementById('add-one').classList.toggle('hidden');document.getElementById('add-paste').classList.add('hidden');"
                  class="px-2.5 py-1 rounded border border-slate-300 hover:border-slate-500">+ Add one</button>
          <button onclick="document.getElementById('add-paste').classList.toggle('hidden');document.getElementById('add-one').classList.add('hidden');"
                  class="px-2.5 py-1 rounded border border-slate-300 hover:border-slate-500">📋 Paste list</button>
        </div>
      </header>

      <!-- Add one -->
      <form id="add-one" method="POST" action="/events/<%= event.id %>/attendees" class="hidden p-4 border-b border-slate-100 bg-slate-50 grid grid-cols-1 md:grid-cols-5 gap-2 text-sm">
        <input name="name" required placeholder="Name *" class="border border-slate-300 rounded px-2 py-1" />
        <input name="title" placeholder="Title" class="border border-slate-300 rounded px-2 py-1" />
        <input name="company" placeholder="Company" class="border border-slate-300 rounded px-2 py-1" />
        <input name="linkedin_url" placeholder="LinkedIn URL" class="border border-slate-300 rounded px-2 py-1" />
        <div class="flex items-center gap-2">
          <input name="email" placeholder="Email" class="flex-1 border border-slate-300 rounded px-2 py-1" />
          <button class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded text-xs font-medium">Add</button>
        </div>
      </form>

      <!-- Paste list -->
      <form id="add-paste" method="POST" action="/events/<%= event.id %>/attendees" class="hidden p-4 border-b border-slate-100 bg-slate-50 text-sm">
        <label class="block text-xs text-slate-600 mb-1">
          Paste tab-separated rows (copy from Sheets/Excel): <strong>Name · Title · Company · LinkedIn · Email</strong>. First row can be a header.
        </label>
        <textarea name="paste_list" rows="6" placeholder="Matt Chen&#9;VP Sales&#9;Acme Corp&#9;https://linkedin.com/in/mattchen&#9;matt@acme.com"
                  class="w-full border border-slate-300 rounded px-2 py-1 font-mono text-xs"></textarea>
        <div class="flex items-center justify-between mt-2">
          <span class="text-xs text-slate-500">LinkedIn CSV import is coming — for now paste works cleanly.</span>
          <button class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded text-xs font-medium">Import</button>
        </div>
      </form>

      <% if (attendees.length === 0) { %>
        <div class="p-6 text-sm text-slate-500 text-center">
          No targets yet. Click <strong>+ Add one</strong> or <strong>📋 Paste list</strong> above to start building the list.
        </div>
      <% } else { %>
        <ul class="divide-y divide-slate-100">
          <% attendees.forEach(function(a) {
            const ism = inviteStatusMeta[a.invite_status] || inviteStatusMeta.target;
            const am = accountStatusMeta[a.matched_account_status] || null;
            const isOpen = openAttendeeId === a.id;
          %>
            <li id="a-<%= a.id %>" class="px-4 py-3">
              <div class="flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-semibold text-slate-900"><%= a.name %></span>
                    <% if (a.title) { %><span class="text-sm text-slate-600"><%= a.title %></span><% } %>
                    <span class="pill <%= ism.cls %>"><%= ism.label %></span>
                  </div>
                  <div class="text-xs text-slate-500 mt-0.5 flex items-center gap-2 flex-wrap">
                    <% if (a.matched_account_name) { %>
                      <a href="/accounts/<%= a.account_id %>/plan" class="text-slate-700 hover:text-emerald-700 font-medium"><%= a.matched_account_name %></a>
                      <% if (am) { %>
                        <span class="text-[10px] uppercase tracking-wide font-semibold border rounded px-1.5 py-0.5 <%= am.cls %>"><%= am.label %></span>
                      <% } %>
                    <% } else if (a.company) { %>
                      <span><%= a.company %></span>
                      <span class="text-[10px] text-slate-400 italic">(no match on your book)</span>
                    <% } %>
                    <% if (a.email) { %><span>· <%= a.email %></span><% } %>
                    <% if (a.linkedin_url) { %><a href="<%= a.linkedin_url %>" target="_blank" rel="noopener" class="underline">LinkedIn</a><% } %>
                  </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <% if (hasSlot) { %>
                    <form method="POST" action="/events/<%= event.id %>/attendees/<%= a.id %>/draft" class="inline">
                      <input type="hidden" name="kind" value="invite" />
                      <button class="text-xs bg-violet-600 hover:bg-violet-700 text-white px-2.5 py-1 rounded font-medium" title="Draft a session invite from our speaker">
                        🎤 Draft invite
                      </button>
                    </form>
                  <% } %>
                  <form method="POST" action="/events/<%= event.id %>/attendees/<%= a.id %>/draft" class="inline">
                    <input type="hidden" name="kind" value="meeting" />
                    <button class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-2.5 py-1 rounded font-medium" title="Draft a casual 'are you going?' note">
                      ✉️ Draft note
                    </button>
                  </form>
                </div>
              </div>

              <% if (a.invite_draft || a.meeting_draft) { %>
                <details class="mt-2" <%= isOpen ? 'open' : '' %>>
                  <summary class="text-xs text-slate-500 cursor-pointer hover:text-slate-900">
                    <% if (a.invite_draft && a.meeting_draft) { %>
                      Drafts ready · invite + note
                    <% } else if (a.invite_draft) { %>
                      Session invite ready
                    <% } else { %>
                      Meeting note ready
                    <% } %>
                  </summary>
                  <div class="mt-2 space-y-2">
                    <% if (a.invite_draft) { %>
                      <div class="bg-violet-50 border border-violet-200 rounded p-3">
                        <div class="flex items-center justify-between mb-1">
                          <div class="text-[10px] uppercase tracking-wide font-semibold text-violet-800">🎤 Session invite (speaker voice)</div>
                          <button type="button" onclick="copyDraft(this)" data-draft-id="invite-<%= a.id %>" class="text-xs underline text-violet-700 hover:text-violet-900">Copy</button>
                        </div>
                        <pre id="invite-<%= a.id %>" class="whitespace-pre-wrap font-sans text-sm text-slate-800"><%= a.invite_draft %></pre>
                      </div>
                    <% } %>
                    <% if (a.meeting_draft) { %>
                      <div class="bg-slate-50 border border-slate-200 rounded p-3">
                        <div class="flex items-center justify-between mb-1">
                          <div class="text-[10px] uppercase tracking-wide font-semibold text-slate-600">✉️ "Are you going?" note (your voice)</div>
                          <button type="button" onclick="copyDraft(this)" data-draft-id="meeting-<%= a.id %>" class="text-xs underline text-slate-600 hover:text-slate-900">Copy</button>
                        </div>
                        <pre id="meeting-<%= a.id %>" class="whitespace-pre-wrap font-sans text-sm text-slate-800"><%= a.meeting_draft %></pre>
                      </div>
                    <% } %>
                  </div>
                </details>
              <% } %>

              <!-- Status + delete row -->
              <div class="mt-2 flex items-center gap-3 text-xs text-slate-500">
                <form method="POST" action="/events/<%= event.id %>/attendees/<%= a.id %>" class="inline-flex items-center gap-1">
                  <label>Status:</label>
                  <select name="invite_status" onchange="this.form.submit()"
                          class="border border-slate-300 rounded px-1.5 py-0.5 text-xs">
                    <% ['target','invited','accepted','declined','met','passed'].forEach(function(st) { %>
                      <option value="<%= st %>" <%= a.invite_status === st ? 'selected' : '' %>><%= inviteStatusMeta[st].label %></option>
                    <% }); %>
                  </select>
                </form>
                <form method="POST" action="/events/<%= event.id %>/attendees/<%= a.id %>/delete" class="inline ml-auto">
                  <button onclick="return confirm('Remove <%= a.name.replace(/'/g, "\\'") %> from the target list?');"
                          class="text-xs text-red-600 hover:text-red-800 underline">Remove</button>
                </form>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <!-- PLAYS attached — compact -->
    <% if (plays.length > 0) { %>
      <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
        <header class="px-4 py-3 border-b border-slate-200">
          <h2 class="font-semibold">Plays attached</h2>
          <p class="text-xs text-slate-500 mt-0.5">
            <%= plays.length %> play<%= plays.length === 1 ? '' : 's' %> across
            <%= new Set(plays.map(p => p.account_id)).size %> account<%= new Set(plays.map(p => p.account_id)).size === 1 ? '' : 's' %>.
          </p>
        </header>
        <ul class="divide-y divide-slate-100">
          <% plays.forEach(function(p) {
            const exp = p.ai_expansion || {};
          %>
            <li class="px-4 py-2.5 flex items-center justify-between gap-3">
              <div class="min-w-0 text-sm">
                <a href="/accounts/<%= p.account_id %>/plan" class="font-semibold text-slate-900 hover:text-emerald-700"><%= p.account_name %></a>
                <span class="text-slate-500"> · </span>
                <a href="/accounts/<%= p.account_id %>/plan#play-<%= p.id %>" class="text-slate-700 hover:text-emerald-700"><%= exp.named_play || '(no expansion yet)' %></a>
              </div>
              <a href="/accounts/<%= p.account_id %>/plan#play-<%= p.id %>" class="text-xs text-slate-500 hover:text-slate-900">Open →</a>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <!-- Marketing context (description) — small, collapsed by default if present -->
    <% if (event.description) { %>
      <details class="bg-white border border-slate-200 rounded-lg">
        <summary class="px-4 py-3 text-sm font-semibold cursor-pointer">Notes &amp; context</summary>
        <div class="px-4 pb-4 text-sm text-slate-700 whitespace-pre-wrap"><%= event.description %></div>
      </details>
    <% } %>

  </section>

  <!-- Edit sidebar -->
  <section class="bg-white border border-slate-200 rounded-lg overflow-hidden h-fit">
    <header class="px-4 py-3 border-b border-slate-200"><h2 class="font-semibold">Edit event</h2></header>
    <form method="POST" action="/events/<%= event.id %>" class="p-4 space-y-3 text-sm">
      <label class="block">
        <span class="text-slate-500 text-xs">Name</span>
        <input name="name" value="<%= event.name %>" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5" />
      </label>
      <div class="grid grid-cols-2 gap-2">
        <label class="block">
          <span class="text-slate-500 text-xs">Kind</span>
          <select name="kind" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
            <option value="event"    <%= event.kind === 'event' ? 'selected' : '' %>>Event</option>
            <option value="campaign" <%= event.kind === 'campaign' ? 'selected' : '' %>>Campaign</option>
            <option value="one_off"  <%= event.kind === 'one_off' ? 'selected' : '' %>>One-off</option>
          </select>
        </label>
        <label class="block">
          <span class="text-slate-500 text-xs">Date</span>
          <input type="date" name="event_date"
                 value="<%= event.event_date ? new Date(event.event_date).toISOString().slice(0,10) : '' %>"
                 class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5" />
        </label>
      </div>
      <label class="block">
        <span class="text-slate-500 text-xs">Location</span>
        <input name="location" value="<%= event.location || '' %>" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5" />
      </label>
      <label class="block">
        <span class="text-slate-500 text-xs">Notes (marketing brief, CEO speaking info, etc.)</span>
        <textarea name="description" rows="4" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5"><%= event.description || '' %></textarea>
      </label>
      <label class="block">
        <span class="text-slate-500 text-xs">Status</span>
        <select name="status" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
          <option value="planning"  <%= event.status === 'planning' ? 'selected' : '' %>>Planning</option>
          <option value="active"    <%= event.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="completed" <%= event.status === 'completed' ? 'selected' : '' %>>Completed</option>
          <option value="cancelled" <%= event.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </label>
      <div class="flex items-center justify-between pt-2">
        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded text-xs font-medium">Save</button>
        <button type="submit" formaction="/events/<%= event.id %>/delete"
                onclick="return confirm('Delete this event? Attached plays will keep running — they just detach from the event.');"
                class="text-xs text-red-600 hover:text-red-800 underline">Delete event</button>
      </div>
    </form>
  </section>

</div>

<script>
  function copyDraft(btn) {
    const id = btn.getAttribute('data-draft-id');
    const el = document.getElementById(id);
    if (!el) return;
    navigator.clipboard.writeText(el.innerText).then(function() {
      const prev = btn.innerText;
      btn.innerText = 'Copied ✓';
      setTimeout(function() { btn.innerText = prev; }, 1200);
    });
  }
</script>
