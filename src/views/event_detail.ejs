<%
  const statusMeta = {
    planning:  { label: 'Planning',  cls: 'bg-amber-100 text-amber-900' },
    active:    { label: 'Active',    cls: 'bg-emerald-100 text-emerald-900' },
    completed: { label: 'Completed', cls: 'bg-slate-100 text-slate-700' },
    cancelled: { label: 'Cancelled', cls: 'bg-slate-100 text-slate-500' },
  };
  const playStatusMeta = {
    drafting:   { label: 'Drafting', cls: 'bg-amber-100 text-amber-800' },
    active:     { label: 'Active',   cls: 'bg-emerald-100 text-emerald-800' },
    paused:     { label: 'Paused',   cls: 'bg-slate-100 text-slate-700' },
    won:        { label: 'Won',      cls: 'bg-violet-100 text-violet-800' },
    lost:       { label: 'Lost',     cls: 'bg-slate-100 text-slate-500' },
    abandoned:  { label: 'Abandoned',cls: 'bg-slate-100 text-slate-500' },
  };
  const kindLabel = { event: 'Event', campaign: 'Campaign', one_off: 'One-off' };
  function shortDate(d) {
    if (!d) return '—';
    return new Date(d).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }
  const s = statusMeta[event.status] || statusMeta.planning;
  const ctx = event.context || null;
  const slot = event.personal_invite_session || (ctx && ctx.ambition_speaking_slot) || null;
  const refLinks = Array.isArray(event.reference_links) ? event.reference_links : [];

  // How many personal-invite seats have been earmarked across all
  // attached plays — makes scarcity visible at a glance.
  let seatsAssigned = 0;
  plays.forEach(function(p) {
    if (Array.isArray(p.personal_invite_contact_ids)) {
      seatsAssigned += p.personal_invite_contact_ids.length;
    }
  });
%>

<div class="mb-6">
  <a href="/events" class="text-xs text-slate-500 hover:text-slate-900">← Events</a>
  <div class="flex items-start justify-between gap-4 mt-2 flex-wrap">
    <div class="min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <h1 class="text-2xl font-semibold"><%= event.name %></h1>
        <span class="pill <%= s.cls %>"><%= s.label %></span>
        <% if (event.research_status === 'pending') { %>
          <span class="pill bg-sky-100 text-sky-800 inline-flex items-center gap-1">
            <svg class="animate-spin h-3 w-3" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>
            Researching
          </span>
        <% } else if (event.research_status === 'completed') { %>
          <span class="pill bg-emerald-50 text-emerald-800">Researched</span>
        <% } else if (event.research_status === 'failed') { %>
          <span class="pill bg-red-100 text-red-800" title="<%= event.research_error || '' %>">Research failed</span>
        <% } %>
      </div>
      <div class="text-sm text-slate-500 mt-1">
        <%= kindLabel[event.kind] || 'Event' %>
        <% if (event.event_date) { %> · <%= shortDate(event.event_date) %><% } %>
        <% if (event.location) { %> · <%= event.location %><% } %>
        <% if (event.created_by_name) { %> · set up by <%= event.created_by_name %><% } %>
      </div>
    </div>
  </div>
  <% if (event.description) { %>
    <p class="text-sm text-slate-700 mt-3 max-w-3xl bg-white border border-slate-200 rounded p-3"><%= event.description %></p>
  <% } %>
</div>

<% if (event.research_status === 'pending') { %>
  <div class="bg-sky-50 border border-sky-200 rounded-lg p-4 mb-6 text-sm text-sky-900 flex items-center gap-3">
    <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>
    Claude is researching this event — pulling the agenda, audience profile, sessions, and the angles you can play against. This page will refresh in a moment.
    <button onclick="location.reload()" class="ml-auto text-xs underline">Refresh now</button>
  </div>
  <script>setTimeout(function(){ location.reload(); }, 20000);</script>
<% } %>

<!-- Personal-invite slot banner -->
<% if (slot && (slot.title || slot.speaker)) { %>
  <div class="bg-violet-50 border border-violet-200 rounded-lg p-4 mb-6">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="min-w-0">
        <div class="text-[10px] uppercase tracking-wide font-semibold text-violet-700 mb-1">🎤 Personal-invite slot · limited seating</div>
        <div class="font-semibold text-slate-900"><%= slot.title || '(session title TBD)' %></div>
        <div class="text-sm text-slate-700 mt-0.5">
          <% if (slot.speaker) { %><strong><%= slot.speaker %></strong><% } %>
          <% if (slot.session_time) { %> · <%= slot.session_time %><% } %>
          <% if (slot.session_url) { %> · <a href="<%= slot.session_url %>" target="_blank" rel="noopener" class="underline text-violet-700">session page →</a><% } %>
        </div>
        <% if (slot.seat_cap_note) { %>
          <div class="text-xs text-violet-800 mt-1">Seating note: <%= slot.seat_cap_note %></div>
        <% } %>
        <% if (slot.why_it_matters) { %>
          <div class="text-xs text-slate-600 mt-1 italic"><%= slot.why_it_matters %></div>
        <% } %>
      </div>
      <div class="text-right shrink-0">
        <div class="text-2xl font-semibold text-violet-800"><%= seatsAssigned %></div>
        <div class="text-[10px] uppercase tracking-wide text-slate-500">seats promised</div>
      </div>
    </div>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <section class="lg:col-span-2 space-y-6">

    <!-- Researched context -->
    <% if (ctx && event.research_status === 'completed') { %>
      <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
        <header class="px-4 py-3 border-b border-slate-200 flex items-center justify-between gap-3 flex-wrap">
          <div>
            <h2 class="font-semibold">Research</h2>
            <p class="text-xs text-slate-500 mt-0.5">
              <% if (event.researched_at) { %>Last run <%= new Date(event.researched_at).toLocaleString() %><% } %>
            </p>
          </div>
          <form method="POST" action="/events/<%= event.id %>/research" class="text-right">
            <button class="text-xs text-slate-500 hover:text-slate-900 underline">Rebuild research</button>
          </form>
        </header>
        <div class="p-4 space-y-4 text-sm">
          <% if (ctx.theme) { %>
            <div>
              <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mb-1">Theme</div>
              <div class="text-slate-800"><%= ctx.theme %></div>
            </div>
          <% } %>
          <% if (ctx.audience_profile) { %>
            <div>
              <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mb-1">Audience</div>
              <div class="text-slate-800">
                <% if (Array.isArray(ctx.audience_profile.titles)) { %><strong><%= ctx.audience_profile.titles.join(' · ') %></strong><% } %>
                <% if (ctx.audience_profile.seniority) { %> · <%= ctx.audience_profile.seniority %><% } %>
                <% if (Array.isArray(ctx.audience_profile.functions)) { %>
                  <div class="text-xs text-slate-500 mt-0.5"><%= ctx.audience_profile.functions.join(' · ') %></div>
                <% } %>
              </div>
            </div>
          <% } %>
          <% if (Array.isArray(ctx.themes_and_tracks) && ctx.themes_and_tracks.length) { %>
            <div>
              <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mb-1">Themes / tracks</div>
              <ul class="list-disc list-inside text-slate-800 space-y-0.5">
                <% ctx.themes_and_tracks.forEach(function(t) { %><li><%= t %></li><% }); %>
              </ul>
            </div>
          <% } %>
          <% if (Array.isArray(ctx.notable_sessions) && ctx.notable_sessions.length) { %>
            <div>
              <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mb-1">Notable sessions</div>
              <ul class="space-y-1.5">
                <% ctx.notable_sessions.forEach(function(ns) { %>
                  <li class="text-slate-800">
                    <div class="font-medium"><%= ns.title %><% if (ns.speaker) { %> <span class="text-slate-500 font-normal">· <%= ns.speaker %></span><% } %></div>
                    <% if (ns.why_relevant) { %><div class="text-xs text-slate-500"><%= ns.why_relevant %></div><% } %>
                    <% if (ns.url) { %><a href="<%= ns.url %>" target="_blank" rel="noopener" class="text-xs underline text-slate-500">source →</a><% } %>
                  </li>
                <% }); %>
              </ul>
            </div>
          <% } %>
          <% if (Array.isArray(ctx.sponsors_and_competitors_present) && ctx.sponsors_and_competitors_present.length) { %>
            <div>
              <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mb-1">Sponsors &amp; competitors present</div>
              <ul class="space-y-1">
                <% ctx.sponsors_and_competitors_present.forEach(function(sp) { %>
                  <li class="text-slate-800 text-sm">
                    <strong><%= sp.name %></strong>
                    <% if (sp.relationship) { %><span class="text-xs text-slate-500">· <%= sp.relationship %></span><% } %>
                    <% if (sp.note) { %><div class="text-xs text-slate-500"><%= sp.note %></div><% } %>
                  </li>
                <% }); %>
              </ul>
            </div>
          <% } %>
          <% if (Array.isArray(ctx.angles_for_ambition) && ctx.angles_for_ambition.length) { %>
            <div class="bg-emerald-50 border border-emerald-200 rounded p-3">
              <div class="text-[10px] uppercase tracking-wide text-emerald-800 font-semibold mb-1">Angles for us</div>
              <ul class="list-disc list-inside text-slate-800 space-y-1 text-sm">
                <% ctx.angles_for_ambition.forEach(function(a) { %><li><%= a %></li><% }); %>
              </ul>
            </div>
          <% } %>
          <% if (Array.isArray(ctx.recommended_moves) && ctx.recommended_moves.length) { %>
            <div>
              <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mb-1">Recommended moves</div>
              <ul class="list-disc list-inside text-slate-800 space-y-1 text-sm">
                <% ctx.recommended_moves.forEach(function(m) { %><li><%= m %></li><% }); %>
              </ul>
            </div>
          <% } %>
          <% if (ctx.research_notes) { %>
            <div class="text-xs text-slate-500 italic border-t border-slate-100 pt-3"><%= ctx.research_notes %></div>
          <% } %>
          <% if (Array.isArray(ctx.sources) && ctx.sources.length) { %>
            <details class="text-xs text-slate-500">
              <summary class="cursor-pointer">Sources (<%= ctx.sources.length %>)</summary>
              <ul class="mt-1 space-y-0.5 pl-4 list-disc">
                <% ctx.sources.forEach(function(u) { %><li><a href="<%= u %>" target="_blank" rel="noopener" class="underline hover:text-slate-700"><%= u %></a></li><% }); %>
              </ul>
            </details>
          <% } %>
        </div>
      </div>
    <% } else if (event.research_status !== 'pending') { %>
      <div class="bg-white border border-slate-200 rounded-lg p-4 text-sm">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div class="text-slate-600">
            No research yet. Paste an agenda / sessions URL and click research so Claude can pull the audience profile and the angles you can pull on.
            <% if (event.research_status === 'failed' && event.research_error) { %>
              <div class="text-xs text-red-700 mt-2">Last run failed: <%= event.research_error %></div>
            <% } %>
          </div>
          <form method="POST" action="/events/<%= event.id %>/research" class="flex flex-col gap-2 min-w-[260px]">
            <input name="speaking_note" type="text" placeholder="Speaking note (optional)"
                   class="w-full border border-slate-300 rounded px-2 py-1 text-xs" />
            <button class="bg-slate-900 hover:bg-slate-800 text-white text-xs px-3 py-1.5 rounded font-medium">Run research</button>
          </form>
        </div>
      </div>
    <% } %>

    <!-- Plays attached -->
    <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
      <header class="px-4 py-3 border-b border-slate-200 flex items-center justify-between gap-3 flex-wrap">
        <div>
          <h2 class="font-semibold">Plays attached to this event</h2>
          <p class="text-xs text-slate-500 mt-0.5">
            <%= plays.length %> play<%= plays.length === 1 ? '' : 's' %> across
            <%= new Set(plays.map(p => p.account_id)).size %> account<%= new Set(plays.map(p => p.account_id)).size === 1 ? '' : 's' %>.
            <% if (slot) { %> · <strong><%= seatsAssigned %></strong> personal invite<%= seatsAssigned === 1 ? '' : 's' %> designated.<% } %>
          </p>
        </div>
      </header>

      <% if (plays.length === 0) { %>
        <div class="p-6 text-sm text-slate-500">
          No plays attached yet. Open an account's Game Plan, start a play, and select this event from the Event dropdown on the composer.
          <a href="/accounts" class="underline">Browse accounts →</a>
        </div>
      <% } else { %>
        <ul class="divide-y divide-slate-100">
          <% plays.forEach(function(p) {
            const exp = p.ai_expansion || {};
            const pm  = playStatusMeta[p.status] || playStatusMeta.drafting;
            const invites = Array.isArray(p.personal_invite_contact_ids) ? p.personal_invite_contact_ids.length : 0;
          %>
            <li class="px-4 py-3">
              <div class="flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <a href="/accounts/<%= p.account_id %>/plan" class="text-sm font-semibold text-slate-900 hover:text-emerald-700">
                      <%= p.account_name %>
                    </a>
                    <span class="text-xs text-slate-500">·</span>
                    <a href="/accounts/<%= p.account_id %>/plan#play-<%= p.id %>" class="text-sm text-slate-700 hover:text-emerald-700">
                      <%= exp.named_play || '(no expansion yet)' %>
                    </a>
                    <span class="pill <%= pm.cls %>"><%= pm.label %></span>
                    <% if (invites > 0) { %>
                      <span class="pill bg-violet-100 text-violet-800">🎤 <%= invites %> invite<%= invites === 1 ? '' : 's' %></span>
                    <% } %>
                  </div>
                  <div class="text-xs text-slate-500 mt-1 line-clamp-1"><%= p.instinct %></div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <% if (exp.named_play) { %>
                    <a href="/plays/<%= p.id %>/export.pptx" title="Export .pptx" class="text-xs text-slate-500 hover:text-emerald-700">📊</a>
                  <% } %>
                  <a href="/accounts/<%= p.account_id %>/plan#play-<%= p.id %>" class="text-xs text-slate-600 hover:text-slate-900 whitespace-nowrap">Open →</a>
                </div>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </section>

  <!-- Edit sidebar -->
  <section class="bg-white border border-slate-200 rounded-lg overflow-hidden h-fit">
    <header class="px-4 py-3 border-b border-slate-200"><h2 class="font-semibold">Edit event</h2></header>
    <form method="POST" action="/events/<%= event.id %>" class="p-4 space-y-3 text-sm">
      <label class="block">
        <span class="text-slate-500 text-xs">Name</span>
        <input name="name" value="<%= event.name %>" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5" />
      </label>
      <div class="grid grid-cols-2 gap-2">
        <label class="block">
          <span class="text-slate-500 text-xs">Kind</span>
          <select name="kind" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
            <option value="event"    <%= event.kind === 'event' ? 'selected' : '' %>>Event</option>
            <option value="campaign" <%= event.kind === 'campaign' ? 'selected' : '' %>>Campaign</option>
            <option value="one_off"  <%= event.kind === 'one_off' ? 'selected' : '' %>>One-off</option>
          </select>
        </label>
        <label class="block">
          <span class="text-slate-500 text-xs">Date</span>
          <input type="date" name="event_date"
                 value="<%= event.event_date ? new Date(event.event_date).toISOString().slice(0,10) : '' %>"
                 class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5" />
        </label>
      </div>
      <label class="block">
        <span class="text-slate-500 text-xs">Location</span>
        <input name="location" value="<%= event.location || '' %>" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5" />
      </label>
      <label class="block">
        <span class="text-slate-500 text-xs">Context</span>
        <textarea name="description" rows="4" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5"><%= event.description || '' %></textarea>
      </label>
      <label class="block">
        <span class="text-slate-500 text-xs">Reference links (one per line)</span>
        <textarea name="reference_links" rows="3" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5 font-mono text-xs"><%= refLinks.join('\n') %></textarea>
      </label>
      <label class="block">
        <span class="text-slate-500 text-xs">Status</span>
        <select name="status" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
          <option value="planning"  <%= event.status === 'planning' ? 'selected' : '' %>>Planning</option>
          <option value="active"    <%= event.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="completed" <%= event.status === 'completed' ? 'selected' : '' %>>Completed</option>
          <option value="cancelled" <%= event.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </label>
      <div class="flex items-center justify-between pt-2">
        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded text-xs font-medium">Save</button>
        <button type="submit" formaction="/events/<%= event.id %>/delete"
                onclick="return confirm('Delete this event? Attached plays will keep running — they just detach from the event.');"
                class="text-xs text-red-600 hover:text-red-800 underline">Delete event</button>
      </div>
    </form>
  </section>

</div>
