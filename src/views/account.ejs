<%
  /* Compute all shared values as local vars, then copy to locals so
     EJS include() partials can see them. */

  var FY_MONTHS = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var statusColor = {
    customer: 'bg-emerald-100 text-emerald-800',
    prospect: 'bg-sky-100 text-sky-800',
    churned:  'bg-amber-100 text-amber-800',
  };
  var priorityColor = {
    hot:  'bg-red-100 text-red-800',
    warm: 'bg-amber-100 text-amber-800',
    cool: 'bg-slate-100 text-slate-600',
  };
  var riskPill = {
    defense_risk:        'bg-red-100 text-red-800',
    offense_opportunity: 'bg-sky-100 text-sky-800',
    neutral:             'bg-slate-100 text-slate-700',
  };
  var riskLabel = {
    defense_risk:        'Defense',
    offense_opportunity: 'Offense',
    neutral:             'Context',
  };
  var signalTypeLabel = {
    linkedin_post: 'LinkedIn', press_quote: 'Press', conference: 'Conference',
    job_posting: 'Job posting', podcast: 'Podcast', blog: 'Blog', other: 'Web',
  };
  var dealRoleMeta = {
    economic_buyer: { label: 'Economic buyer', pill: 'bg-violet-100 text-violet-800' },
    champion:       { label: 'Champion',        pill: 'bg-emerald-100 text-emerald-800' },
    coach:          { label: 'Coach',           pill: 'bg-sky-100 text-sky-800' },
    influencer:     { label: 'Influencer',      pill: 'bg-amber-100 text-amber-800' },
    user:           { label: 'User',             pill: 'bg-slate-100 text-slate-700' },
    blocker:        { label: 'Blocker',         pill: 'bg-red-100 text-red-800' },
    unknown:        { label: 'Unclassified',    pill: 'bg-slate-100 text-slate-500' },
  };
  var stanceMeta = {
    hot: { label: 'Hot', cls: 'text-red-600 font-medium' },
    warm: { label: 'Warm', cls: 'text-orange-600' },
    neutral: { label: 'Neutral', cls: 'text-slate-500' },
    cold: { label: 'Cold', cls: 'text-sky-700' },
    hostile: { label: 'Hostile', cls: 'text-red-700 font-medium' },
  };
  var playStatusMeta = {
    drafting:  { label: 'Drafting',  cls: 'bg-amber-100 text-amber-800' },
    active:    { label: 'Active',    cls: 'bg-emerald-100 text-emerald-800' },
    paused:    { label: 'Paused',    cls: 'bg-slate-100 text-slate-700' },
    won:       { label: 'Won',       cls: 'bg-violet-100 text-violet-800' },
    lost:      { label: 'Lost',      cls: 'bg-slate-100 text-slate-500' },
    abandoned: { label: 'Abandoned', cls: 'bg-slate-100 text-slate-500' },
  };
  var actorMeta = {
    champion:           { label: 'Champion carries', cls: 'bg-emerald-100 text-emerald-900 border-emerald-300' },
    ae:                 { label: 'You (coach)',       cls: 'bg-slate-100 text-slate-800 border-slate-300' },
    internal_colleague: { label: 'Internal assist',   cls: 'bg-sky-100 text-sky-900 border-sky-300' },
  };
  var useCaseLabel = {
    performance_graph: 'Performance Graph', ascend_coaching: 'Ascend coaching',
    gtm_governance: 'GTM Governance', manager_enablement: 'Manager enablement',
    rep_ramp: 'Rep ramp', multi_team_rollup: 'Multi-team roll-up',
  };

  function daysAgo(d) {
    if (!d) return null;
    var ms = Date.now() - new Date(d).getTime();
    return ms < 0 ? 0 : Math.floor(ms / 86400000);
  }
  function agoLabel(d) {
    var n = daysAgo(d);
    if (n === null) return '';
    if (n === 0) return 'today';
    if (n === 1) return 'yesterday';
    if (n < 7) return n + 'd ago';
    if (n < 60) return Math.floor(n / 7) + 'w ago';
    return Math.floor(n / 30) + 'mo ago';
  }

  // POV
  var pov = intel?.account_pov?.status === 'completed' ? intel.account_pov.result : null;
  var povRunning = intel?.account_pov?.status === 'running';

  // Prospects
  var ps = intel?.prospect_scan;
  var psResult = ps?.status === 'completed' ? ps.result : null;
  var psRunning = ps?.status === 'running';
  var psFailed = ps?.status === 'failed';
  var visibleProspects = (psResult && Array.isArray(psResult.prospects))
    ? psResult.prospects.filter(function(p) { return !p.dismissed; }) : [];

  // Signals
  var sigCount = signals.length;

  // Contacts tree
  var _byId = new Map(contacts.map(function(c) { return [c.id, Object.assign({}, c, { children: [] })]; }));
  var _roots = [];
  for (var _c of _byId.values()) {
    var _pid = _c.reports_to_contact_id;
    if (_pid && _byId.has(_pid)) _byId.get(_pid).children.push(_c);
    else _roots.push(_c);
  }
  var contactRows = [];
  function _walk(node, depth) { contactRows.push({ node: node, depth: depth }); node.children.forEach(function(ch) { _walk(ch, depth + 1); }); }
  _roots.forEach(function(r) { _walk(r, 0); });

  // Intel
  var ucf = intel?.use_case_fit;
  var ucfRunning = ucf?.status === 'running';
  var ucfResult = ucf?.status === 'completed' && ucf.result ? ucf.result : null;
  var ind = intel?.industry_insight;
  var indRunning = ind?.status === 'running';
  var indResult = ind?.status === 'completed' && ind.result ? ind.result : null;
  var hgen = intel?.hypotheses_gen;
  var hgenRunning = hgen?.status === 'running';
  var anyIntelRunning = ucfRunning || indRunning || hgenRunning || psRunning || povRunning;

  // Copy everything partials need onto locals so include() propagates them
  Object.assign(locals, {
    FY_MONTHS, statusColor, priorityColor, riskPill, riskLabel, signalTypeLabel,
    dealRoleMeta, stanceMeta, playStatusMeta, actorMeta, useCaseLabel,
    daysAgo, agoLabel,
    pov, povRunning, psResult, psRunning, psFailed, visibleProspects,
    sigCount, contactRows,
    ucf, ucfRunning, ucfResult, ind, indRunning, indResult,
    hgen, hgenRunning,
  });
%>

<!-- ============ HEADER ============ -->
<div class="mb-6">
  <a href="/brief" class="text-xs text-slate-500 hover:text-slate-900">&larr; Today</a>
  <div class="flex items-start justify-between gap-4 mt-2 flex-wrap">
    <div class="flex items-center gap-3 flex-wrap">
      <h1 class="text-2xl font-semibold"><%= account.account_name %></h1>
      <span class="pill <%= statusColor[account.status] || 'bg-slate-100 text-slate-700' %>"><%= account.status %></span>
      <% if (pov && pov.priority) { %>
        <span class="pill <%= priorityColor[pov.priority] || priorityColor.cool %>"><%= pov.priority %></span>
      <% } %>
      <form method="POST" action="/accounts/<%= account.id %>/watch" class="inline">
        <button type="submit" class="pill cursor-pointer <%= account.watched ? 'bg-amber-100 text-amber-800 border border-amber-300' : 'bg-slate-50 text-slate-400 border border-slate-200 hover:border-slate-400' %>" title="<%= account.watched ? 'Remove from daily scan' : 'Add to daily scan' %>">
          <%= account.watched ? 'Watching' : 'Watch' %>
        </button>
      </form>
      <% if (account.domain) { %><span class="text-xs text-slate-400"><%= account.domain %></span><% } %>
      <% if (account.industry) { %><span class="text-xs text-slate-400">· <%= account.industry %></span><% } %>
    </div>
    <div class="flex items-center gap-3">
      <form method="POST" action="/accounts/<%= account.id %>/deprioritize" class="inline">
        <button type="submit" class="text-xs text-slate-400 hover:text-slate-700 underline">
          <%= account.deprioritized ? 'Reprioritize' : 'Deprioritize' %>
        </button>
      </form>
      <form method="POST" action="/accounts/<%= account.id %>/scan-all">
        <button type="submit" class="text-sm bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded font-medium disabled:bg-slate-400 disabled:cursor-wait"
                <% if (psRunning || povRunning) { %>disabled<% } %>>
          <% if (psRunning || povRunning) { %>Scanning…<% } else { %>Scan account<% } %>
        </button>
      </form>
    </div>
  </div>
  <% if (rescanStatus === 'started') { %>
    <div class="mt-2 text-xs text-emerald-700 flex items-center gap-2">
      <span class="inline-block w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span> Scan started — results appear in ~60s.
    </div>
  <% } else if (rescanStatus === 'throttled') { %>
    <div class="mt-2 text-xs text-slate-500">Already scanned in the last 24h.</div>
  <% } %>
</div>

<% if (anyIntelRunning) { %>
  <script>setTimeout(function(){ location.reload(); }, 8000);</script>
<% } %>

<!-- ================================================================
     DEBRIEF — POV + Intel summary + Notes
     ================================================================ -->
<div class="bg-white border border-slate-200 rounded-lg mb-6 overflow-hidden">

  <%# === POV === %>
  <% if (pov) { %>
    <div class="p-5 space-y-3">
      <div>
        <div class="text-[10px] uppercase tracking-wide text-slate-500 mb-0.5">What's happening</div>
        <div class="text-sm text-slate-800"><%= pov.whats_happening || pov.pov %></div>
      </div>
      <% if (pov.where_is_the_opportunity || pov.path_in) { %>
        <div>
          <div class="text-[10px] uppercase tracking-wide text-emerald-700 mb-0.5">Where's the opportunity</div>
          <div class="text-sm text-emerald-900"><%= pov.where_is_the_opportunity || pov.path_in %></div>
        </div>
      <% } %>
      <% if (pov.who_needs_to_know) { %>
        <div>
          <div class="text-[10px] uppercase tracking-wide text-sky-700 mb-0.5">Who needs to know</div>
          <div class="text-sm text-sky-900"><%= pov.who_needs_to_know %></div>
        </div>
      <% } %>
      <div class="pt-2 border-t border-slate-100">
        <span class="text-sm font-medium text-slate-700">This week:</span>
        <span class="text-sm text-slate-800"><%= pov.next_step || pov.strategy %></span>
      </div>
      <% if (pov.recommended_play) { %>
        <div class="pt-1">
          <div class="text-sm mb-2">
            <span class="font-medium text-slate-500">Recommended play:</span>
            <span class="text-slate-800"><%= pov.recommended_play %></span>
          </div>
          <% var hasActivePlay = plays.some(function(p) { return p.status === 'active' || p.status === 'drafting'; }); %>
          <a href="/accounts/<%= account.id %>?new_play=1&instinct=<%= encodeURIComponent(pov.recommended_play) %>#plays-section"
             class="inline-flex items-center gap-1 text-sm <%= hasActivePlay ? 'bg-slate-600 hover:bg-slate-700' : 'bg-emerald-700 hover:bg-emerald-800' %> text-white px-3 py-1.5 rounded font-medium">
            <%= hasActivePlay ? 'Alternative angle' : 'Run this play' %>
          </a>
        </div>
      <% } %>
    </div>
  <% } else if (povRunning) { %>
    <div class="p-5 text-sm text-slate-500 flex items-center gap-2">
      <span class="inline-block w-2 h-2 bg-slate-400 rounded-full animate-pulse"></span> Building point of view…
    </div>
  <% } else { %>
    <div class="p-5 text-sm text-slate-500">No POV yet. Click <strong>Scan account</strong> to generate.</div>
  <% } %>

  <%# === INTEL SUMMARY === %>
  <% var hasUcf = ucfResult && ucfResult.primary; %>
  <% var hasInd = indResult && indResult.insights && indResult.insights.length > 0; %>
  <% if (hasUcf || hasInd || ucfRunning || indRunning) { %>
    <div class="px-5 py-3 border-t border-slate-100 space-y-2">
      <% if (hasUcf) { %>
        <div class="flex items-start gap-3">
          <span class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold w-16 shrink-0 pt-0.5">Use case</span>
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="pill bg-slate-900 text-white"><%= ucfResult.primary.label %></span>
              <% if (ucfResult.primary.audience) { %><span class="pill bg-sky-100 text-sky-800"><%= ucfResult.primary.audience %></span><% } %>
              <% if (ucfResult.primary.confidence) { %><span class="text-xs text-slate-400">conf <%= ucfResult.primary.confidence %>/5</span><% } %>
            </div>
            <% if (ucfResult.primary.why) { %>
              <div class="text-xs text-slate-600 mt-1"><%= ucfResult.primary.why %></div>
            <% } %>
          </div>
        </div>
      <% } else if (ucfRunning) { %>
        <div class="flex items-center gap-2 text-xs text-slate-400">
          <span class="inline-block w-1.5 h-1.5 bg-slate-400 rounded-full animate-pulse"></span> Identifying use case…
        </div>
      <% } %>
      <% if (hasInd) { %>
        <div class="flex items-start gap-3">
          <span class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold w-16 shrink-0 pt-0.5">Industry</span>
          <div class="min-w-0 text-xs text-slate-700">
            <div class="font-medium"><%= indResult.insights[0].headline %></div>
            <% if (indResult.insights[0].the_reframe) { %>
              <div class="text-slate-500 mt-0.5"><%= indResult.insights[0].the_reframe %></div>
            <% } %>
          </div>
        </div>
      <% } else if (indRunning) { %>
        <div class="flex items-center gap-2 text-xs text-slate-400">
          <span class="inline-block w-1.5 h-1.5 bg-slate-400 rounded-full animate-pulse"></span> Searching industry insight…
        </div>
      <% } %>
    </div>
  <% } %>

  <%# === NOTES === %>
  <div class="px-5 py-3 border-t border-slate-100">
    <% if (account.notes) { %>
      <div class="text-sm text-slate-700 whitespace-pre-line leading-relaxed"><%= account.notes %></div>
      <details class="mt-2">
        <summary class="text-xs text-slate-400 cursor-pointer list-none select-none hover:text-slate-700">Edit notes</summary>
        <form method="POST" action="/accounts/<%= account.id %>/notes" class="mt-2">
          <textarea name="notes" rows="4" class="w-full border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 resize-y"><%= account.notes %></textarea>
          <div class="flex justify-end mt-1.5">
            <button type="submit" class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded">Save</button>
          </div>
        </form>
      </details>
    <% } else { %>
      <form method="POST" action="/accounts/<%= account.id %>/notes">
        <textarea name="notes" rows="2" placeholder="Add notes — meeting summaries, product usage, open issues. These feed every scan and POV."
                  class="w-full border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 resize-y"></textarea>
        <div class="flex justify-end mt-1.5">
          <button type="submit" class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded">Save</button>
        </div>
      </form>
    <% } %>
  </div>

</div>

<!-- ================================================================
     VOICES — always visible, not behind a tab
     ================================================================ -->
<div id="voices-section" class="bg-white border border-slate-200 rounded-lg mb-6 overflow-hidden">
  <div class="px-5 py-3 border-b border-slate-200 flex items-center justify-between">
    <div class="text-sm font-semibold text-slate-900">
      Voices
      <% if (visibleProspects.length > 0) { %>
        <span class="text-slate-400 font-normal ml-1"><%= visibleProspects.length %></span>
      <% } %>
    </div>
    <% if (psRunning) { %>
      <span class="text-xs text-slate-400 flex items-center gap-1">
        <span class="inline-block w-1.5 h-1.5 bg-slate-400 rounded-full animate-pulse"></span> Scanning…
      </span>
    <% } %>
  </div>
  <%- include('partials/account_voices') %>
</div>

<!-- ================================================================
     PLAYS — always visible, not behind a tab
     ================================================================ -->
<div id="plays-section" class="bg-white border border-slate-200 rounded-lg mb-6 overflow-hidden">
  <div class="px-5 py-3 border-b border-slate-200 flex items-center justify-between">
    <div class="text-sm font-semibold text-slate-900">
      Plays
      <% if (plays.length > 0) { %>
        <span class="text-slate-400 font-normal ml-1"><%= plays.length %></span>
      <% } %>
    </div>
  </div>
  <%- include('partials/account_plays') %>
</div>

<!-- ================================================================
     REFERENCE TABS — deep-dive content
     ================================================================ -->
<div class="bg-white border border-slate-200 rounded-lg overflow-hidden">

  <%# Tab bar %>
  <%
    var refTabs = [
      { id: 'signals', label: 'Signals', count: sigCount },
      { id: 'contacts', label: 'Contacts', count: contacts.length },
      { id: 'intel', label: 'Intel', count: null },
      { id: 'hypotheses', label: 'Hypotheses', count: hypotheses.length },
      { id: 'fields', label: 'Fields', count: null },
    ];
    var activeTab = typeof tab !== 'undefined' && tab ? tab : 'signals';
  %>
  <div class="border-b border-slate-200 px-4 flex gap-0 overflow-x-auto">
    <% refTabs.forEach(function(t) { %>
      <a href="/accounts/<%= account.id %>?tab=<%= t.id %>"
         class="px-3 py-2.5 text-sm whitespace-nowrap border-b-2 <%= activeTab === t.id ? 'border-slate-900 text-slate-900 font-medium' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300' %>">
        <%= t.label %>
        <% if (t.count != null && t.count > 0) { %>
          <span class="text-xs text-slate-400 ml-0.5"><%= t.count %></span>
        <% } %>
      </a>
    <% }); %>
  </div>

  <%# Tab content %>
  <div class="p-0">
    <% if (activeTab === 'signals') { %>
      <%- include('partials/account_signals') %>
    <% } else if (activeTab === 'contacts') { %>
      <%- include('partials/account_contacts') %>
    <% } else if (activeTab === 'intel') { %>
      <%- include('partials/account_intel') %>
    <% } else if (activeTab === 'hypotheses') { %>
      <%- include('partials/account_hypotheses') %>
    <% } else if (activeTab === 'fields') { %>
      <div class="p-4">
        <form method="POST" action="/accounts/<%= account.id %>/fields" class="space-y-3 text-sm">
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="text-xs text-slate-500">Fiscal year ends</span>
              <select name="fiscal_year_end" class="w-full border border-slate-300 rounded px-2 py-1.5 mt-0.5 text-sm">
                <option value="">Unknown</option>
                <% for (var m = 1; m <= 12; m++) { %>
                  <option value="<%= m %>" <%= account.fiscal_year_end === m ? 'selected' : '' %>><%= FY_MONTHS[m] %></option>
                <% } %>
              </select>
            </label>
            <label class="block">
              <span class="text-xs text-slate-500">Budget cycle starts</span>
              <select name="budget_start_month" class="w-full border border-slate-300 rounded px-2 py-1.5 mt-0.5 text-sm">
                <option value="">Unknown</option>
                <% for (var m = 1; m <= 12; m++) { %>
                  <option value="<%= m %>" <%= account.budget_start_month === m ? 'selected' : '' %>><%= FY_MONTHS[m] %></option>
                <% } %>
              </select>
            </label>
          </div>
          <label class="block">
            <span class="text-xs text-slate-500">Buyer timing notes</span>
            <input name="buyer_timing" value="<%= account.buyer_timing || '' %>" placeholder="e.g. 'Q3 budget review, renewal in Oct'" class="w-full border border-slate-300 rounded px-2 py-1.5 mt-0.5 text-sm" />
          </label>
          <label class="block">
            <span class="text-xs text-slate-500">Sales performance topics</span>
            <textarea name="sales_perf_topics" rows="2" placeholder="e.g. 'SDR ramp, manager coaching cadence, forecast discipline'" class="w-full border border-slate-300 rounded px-2 py-1.5 mt-0.5 text-sm"><%= account.sales_perf_topics || '' %></textarea>
          </label>
          <div class="flex items-center gap-3">
            <button type="submit" class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded">Save fields</button>
            <form method="POST" action="/accounts/<%= account.id %>/fields/lookup-fiscal-year" class="inline">
              <button type="submit" class="text-xs text-slate-500 hover:text-slate-900 underline">Auto-lookup fiscal year</button>
            </form>
          </div>
        </form>
      </div>
    <% } %>
  </div>

</div>
