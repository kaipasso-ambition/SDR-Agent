<%
  function fmtDate(d) {
    if (!d) return '—';
    const dt = d instanceof Date ? d : new Date(d);
    if (isNaN(dt)) return '—';
    return dt.toISOString().slice(0, 10);
  }
  const triggers = Array.isArray(deal.last_scan_result) ? deal.last_scan_result : [];
  const status = deal.last_scan_status;
  const isRunning = status === 'running';
  const linkedin = deal.notes && deal.notes.startsWith('LinkedIn: ') ? deal.notes.slice(10) : null;
  const sevPill = (s) => {
    if (s >= 5) return 'bg-red-100 text-red-800';
    if (s === 4) return 'bg-orange-100 text-orange-800';
    if (s === 3) return 'bg-amber-100 text-amber-800';
    if (s === 2) return 'bg-slate-100 text-slate-700';
    return 'bg-slate-100 text-slate-500';
  };
  const channelIcon = (ch) => {
    if (ch === 'linkedin') return 'in';
    if (ch === 'email')    return '@';
    if (ch === 'call')     return '☎';
    if (ch === 'internal') return '→';
    if (ch === 'event')    return '★';
    return '·';
  };
  const channelColor = (ch) => {
    if (ch === 'linkedin') return 'bg-blue-100 text-blue-800';
    if (ch === 'email')    return 'bg-emerald-100 text-emerald-800';
    if (ch === 'call')     return 'bg-amber-100 text-amber-800';
    if (ch === 'internal') return 'bg-slate-100 text-slate-700';
    if (ch === 'event')    return 'bg-purple-100 text-purple-800';
    return 'bg-slate-100 text-slate-600';
  };
  const likelihoodColor = (l) => {
    if (l === 'high')   return 'text-emerald-700';
    if (l === 'medium') return 'text-amber-700';
    return 'text-red-700';
  };
  // Build a quick lookup: trigger_index → pathSet for that trigger (most recent first)
  const pathsByTrigger = {};
  (pathSets || []).forEach(function(ps) {
    if (!pathsByTrigger[ps.trigger_index]) pathsByTrigger[ps.trigger_index] = ps;
  });
  const pathColors = [
    { border: 'border-blue-300',    header: 'bg-blue-50 text-blue-900 border-b border-blue-200',       dot: 'bg-blue-500',    bar: 'bg-blue-500',    selected: 'ring-2 ring-blue-500',    selectBtn: 'bg-blue-600 hover:bg-blue-700 text-white' },
    { border: 'border-emerald-300', header: 'bg-emerald-50 text-emerald-900 border-b border-emerald-200', dot: 'bg-emerald-500', bar: 'bg-emerald-500', selected: 'ring-2 ring-emerald-500', selectBtn: 'bg-emerald-600 hover:bg-emerald-700 text-white' },
    { border: 'border-purple-300',  header: 'bg-purple-50 text-purple-900 border-b border-purple-200',  dot: 'bg-purple-500',  bar: 'bg-purple-500',  selected: 'ring-2 ring-purple-500',  selectBtn: 'bg-purple-600 hover:bg-purple-700 text-white' },
  ];
  const outcomeLabels = { won: 'Won', lost: 'Lost', no_response: 'No response', in_progress: 'In progress' };
  const outcomeColors = { won: 'bg-emerald-100 text-emerald-800', lost: 'bg-red-100 text-red-800', no_response: 'bg-slate-100 text-slate-700', in_progress: 'bg-amber-100 text-amber-800' };
%>

<div class="mb-2 text-sm text-slate-500">
  <a href="/revisit" class="hover:text-slate-900">&larr; Revisit</a>
</div>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-semibold"><%= deal.account_name %></h1>
    <div class="text-sm text-slate-500 mt-1">
      <%= deal.account_type_at_close || 'unknown type' %> &middot; closed <%= fmtDate(deal.close_date) %>
      <% if (deal.loss_reason) { %> &middot; loss reason: <strong class="text-slate-700"><%= deal.loss_reason %></strong><% } %>
      <% if (deal.owner_name) { %> &middot; owner: <%= deal.owner_name %><% } %>
    </div>
    <div class="text-[11px] text-slate-400 mt-1">opp: <%= deal.opportunity_id %></div>
  </div>
  <form method="POST" action="/revisit/<%= encodeURIComponent(deal.opportunity_id) %>/scan" class="shrink-0">
    <button type="submit"
            class="text-sm bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded font-medium disabled:opacity-50"
            <% if (isRunning) { %>disabled<% } %>>
      <% if (isRunning) { %>Scanning&hellip;<% } else if (status === 'completed') { %>Re-scan<% } else { %>Run scan<% } %>
    </button>
  </form>
</div>

<% if (isRunning) { %>
  <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6 flex items-center gap-3">
    <span class="inline-block w-2 h-2 bg-amber-500 rounded-full animate-pulse"></span>
    <div class="flex-1 text-sm text-amber-900">
      Scanning the web for what has changed since close_date. Typically 1&ndash;3 minutes (~6 web searches).
    </div>
  </div>
  <script>setTimeout(function(){ location.reload(); }, 15000);</script>
<% } else if (status === 'failed') { %>
  <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6 text-sm text-red-900">
    <strong>Last scan failed.</strong>
    <% if (deal.last_scan_error) { %><div class="mt-1 text-red-800 font-mono text-xs"><%= deal.last_scan_error %></div><% } %>
  </div>
<% } %>

<!-- Deal context -->
<details class="bg-white border border-slate-200 rounded-lg p-5 mb-6" <% if (!triggers.length && !isRunning) { %>open<% } %>>
  <summary class="cursor-pointer text-sm font-semibold text-slate-700 select-none">Deal context (what the scanner sees)</summary>
  <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-3 text-sm">
    <% const fields = [
      ['Industry', deal.industry],
      ['LinkedIn', linkedin],
      ['Why taking call', deal.why_taking_call],
      ['Why now', deal.why_now],
      ['Why Ambition', deal.why_ambition],
      ['Current state pains', deal.current_state_pains],
      ['Business / technical pains', deal.business_technical_pains],
      ['Champion (raw)', deal.champion_raw],
      ['Decision criteria', deal.decision_criteria],
      ['Decision process', deal.decision_process],
      ['FoA note', deal.foa_note],
      ['Next step', deal.next_step],
    ]; %>
    <% fields.forEach(function(f) { if (f[1]) { %>
      <div>
        <div class="text-[11px] uppercase tracking-wide text-slate-400 font-semibold"><%= f[0] %></div>
        <div class="text-slate-700 whitespace-pre-wrap"><%= f[1] %></div>
      </div>
    <% } }); %>
  </div>
</details>

<!-- AE scratchpad — things learned between scans -->
<div id="notes" class="bg-white border border-slate-200 rounded-lg p-5 mb-6">
  <div class="flex items-baseline justify-between mb-3">
    <h2 class="text-sm font-semibold text-slate-700">Notes
      <span class="text-xs text-slate-400 font-normal">&middot; fed into the next scan &amp; path build</span>
    </h2>
    <span class="text-xs text-slate-400"><%= (notes || []).length %></span>
  </div>

  <form method="POST" action="/revisit/<%= encodeURIComponent(deal.opportunity_id) %>/notes" class="mb-4">
    <textarea name="note" rows="2" maxlength="4000" required
              placeholder="e.g. heard their new CRO is ex-Outreach, comp plan overhaul underway, saw them at Gartner CSO summit…"
              class="w-full text-sm border border-slate-300 rounded p-2 focus:outline-none focus:border-slate-500"></textarea>
    <div class="flex justify-end mt-2">
      <button type="submit" class="text-xs bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded font-medium">
        Add note
      </button>
    </div>
  </form>

  <% if ((notes || []).length === 0) { %>
    <div class="text-xs text-slate-400 text-center py-2">
      Nothing here yet. Drop anything you pick up about this account &mdash; it'll show up in the JSON context next time you scan or build paths.
    </div>
  <% } else { %>
    <ul class="space-y-2">
      <% (notes || []).forEach(function(n) { %>
        <li class="flex items-start gap-3 text-sm border-l-2 border-slate-200 pl-3 py-1">
          <div class="flex-1">
            <div class="text-slate-700 whitespace-pre-wrap"><%= n.note %></div>
            <div class="text-[11px] text-slate-400 mt-0.5">
              <%= fmtDate(n.created_at) %>
              <% if (n.created_by_name) { %> &middot; <%= n.created_by_name %><% } %>
            </div>
          </div>
          <form method="POST" action="/revisit/notes/<%= n.id %>/delete"
                onsubmit="return confirm('Delete this note?');" class="shrink-0">
            <button type="submit" class="text-[11px] text-slate-400 hover:text-red-600">delete</button>
          </form>
        </li>
      <% }); %>
    </ul>
  <% } %>
</div>

<% if (status === 'completed' || triggers.length > 0) { %>
  <div class="mb-3 flex items-center justify-between">
    <h2 class="text-lg font-semibold">
      <%= triggers.length %> trigger<%= triggers.length === 1 ? '' : 's' %>
      <% if (deal.last_scan_searches != null) { %>
        <span class="text-xs text-slate-500 font-normal">&middot; <%= deal.last_scan_searches %> web searches</span>
      <% } %>
    </h2>
  </div>

  <% if (triggers.length === 0) { %>
    <div class="bg-white border border-slate-200 rounded-lg p-8 text-sm text-slate-500 text-center">
      <div class="text-base text-slate-700 mb-1">No material change found.</div>
      Claude searched but didn't surface anything that would neutralise the original loss reason.
      Worth re-scanning in a few weeks.
    </div>
  <% } else { %>
    <div class="space-y-6">
      <% triggers.forEach(function(t, i) {
        const ps = pathsByTrigger[i];
        const paths = ps && Array.isArray(ps.paths) ? ps.paths : [];
      %>
        <div id="trigger-<%= i %>" class="bg-white border-2 border-slate-200 rounded-lg p-5">
          <!-- Trigger card header -->
          <div class="flex items-start justify-between gap-4 mb-2">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="pill <%= sevPill(t.severity) %>">SEV <%= t.severity %></span>
              <% if (t.signal_type) { %><span class="pill bg-slate-100 text-slate-700"><%= t.signal_type %></span><% } %>
              <% if (t.loss_reason_link) { %><span class="text-xs text-slate-500">&darr; <%= t.loss_reason_link %></span><% } %>
            </div>
            <span class="text-xs text-slate-400">#<%= i + 1 %></span>
          </div>

          <div class="text-base font-semibold text-slate-900 mb-1"><%= t.trigger_title %></div>
          <% if (t.trigger_summary) { %>
            <div class="text-sm text-slate-600 mb-3"><%= t.trigger_summary %></div>
          <% } %>

          <% if (t.why_this_unlocks) { %>
            <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mt-3 mb-1">Why this unlocks</div>
            <div class="text-sm text-slate-800"><%= t.why_this_unlocks %></div>
          <% } %>

          <% if (t.re_entry_angle) { %>
            <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mt-3 mb-1">Re-entry angle</div>
            <div class="text-sm text-slate-800"><%= t.re_entry_angle %></div>
          <% } %>

          <% if (Array.isArray(t.sponsors_to_target) && t.sponsors_to_target.length) { %>
            <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mt-3 mb-1">Sponsors to target</div>
            <ul class="text-sm text-slate-800 space-y-1">
              <% t.sponsors_to_target.forEach(function(sp) { %>
                <li>
                  <strong><%= sp.name %></strong>
                  <% if (sp.title) { %><span class="text-slate-600">&mdash; <%= sp.title %></span><% } %>
                  <% if (sp.role_guess) { %><span class="text-xs text-slate-500"> (<%= sp.role_guess %>)</span><% } %>
                  <% if (sp.why_this_person) { %><div class="text-xs text-slate-500"><%= sp.why_this_person %></div><% } %>
                </li>
              <% }); %>
            </ul>
          <% } %>

          <div class="flex items-center justify-between gap-3 mt-4 flex-wrap text-xs">
            <div>
              <% if (t.source_url) { %>
                <a href="<%= t.source_url %>" target="_blank" rel="noopener"
                   class="text-slate-600 hover:text-slate-900 underline truncate max-w-md inline-block align-middle">
                  Source &nearr;
                </a>
              <% } %>
              <% if (t.source_excerpt) { %>
                <span class="text-slate-400 italic ml-2">"<%= t.source_excerpt %>"</span>
              <% } %>
            </div>
            <div class="flex items-center gap-2">
              <form method="POST" action="/revisit/<%= encodeURIComponent(deal.opportunity_id) %>/triggers/<%= i %>/play"
                    onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='Building play…';">
                <button type="submit"
                        class="bg-slate-900 hover:bg-slate-800 disabled:bg-slate-500 disabled:cursor-wait text-white px-4 py-1.5 rounded font-medium text-xs">
                  Build a play &rarr;
                </button>
              </form>
              <% if (!ps) { %>
                <form method="POST" action="/revisit/<%= encodeURIComponent(deal.opportunity_id) %>/paths">
                  <input type="hidden" name="trigger_index" value="<%= i %>" />
                  <button type="submit"
                          class="border border-slate-300 text-slate-700 hover:bg-slate-50 px-3 py-1.5 rounded font-medium text-xs">
                    Enumerate 3 paths
                  </button>
                </form>
              <% } %>
            </div>
          </div>

          <!-- ============================================================ -->
          <!-- PATH CARDS — dashboard view: comparison table + metric cards -->
          <!-- ============================================================ -->
          <% if (ps && paths.length > 0) {
            // Compute comparison stats for the summary table — highlight
            // the best number in each column. "Best" is subjective per
            // column: high reply/confidence is good, low days/effort is good.
            const safeM = (p) => p.metrics || {};
            const bestReply = Math.max(...paths.map(p => safeM(p).predicted_reply_rate ?? -1));
            const bestDays  = Math.min(...paths.map(p => safeM(p).predicted_days_to_meeting ?? 9999).filter(n => n !== 9999));
            const bestEffort = Math.min(...paths.map(p => safeM(p).effort_score ?? 99));
            const bestConf  = Math.max(...paths.map(p => safeM(p).confidence ?? -1));
            const effortLabel = (s) => ({1:'XS',2:'S',3:'M',4:'L',5:'XL'}[s] || '?');
          %>
            <div id="paths-<%= ps.id %>" class="mt-6 border-t border-slate-200 pt-5">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-semibold text-slate-700">
                  Hypotheses
                  <% if (ps.selected_path != null) { %>
                    &middot; <span class="text-emerald-700">Path <%= ps.selected_path + 1 %> selected</span>
                    <% if (ps.outcome) { %>
                      &middot; <span class="pill <%= outcomeColors[ps.outcome] || 'bg-slate-100' %>"><%= outcomeLabels[ps.outcome] || ps.outcome %></span>
                    <% } %>
                  <% } %>
                </h3>
                <% if (ps.selected_path == null) { %>
                  <form method="POST" action="/revisit/<%= encodeURIComponent(deal.opportunity_id) %>/paths">
                    <input type="hidden" name="trigger_index" value="<%= i %>" />
                    <button type="submit" class="text-xs text-slate-500 hover:text-slate-900 underline">Regenerate</button>
                  </form>
                <% } %>
              </div>

              <!-- Comparison table — scannable first read -->
              <div class="bg-white border border-slate-200 rounded-lg overflow-hidden mb-4">
                <table class="w-full text-sm">
                  <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
                    <tr>
                      <th class="text-left px-3 py-2 font-semibold">Path</th>
                      <th class="text-right px-3 py-2 font-semibold">Reply %</th>
                      <th class="text-right px-3 py-2 font-semibold">Days&nbsp;&rarr;&nbsp;meet</th>
                      <th class="text-right px-3 py-2 font-semibold">Effort</th>
                      <th class="text-right px-3 py-2 font-semibold">Confidence</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% paths.forEach(function(p, pi) {
                      const m = p.metrics || {};
                      const color = pathColors[pi] || pathColors[0];
                      const isSelected = ps.selected_path === pi;
                      const highlight = (val, best) => val === best ? 'font-semibold text-emerald-700' : 'text-slate-700';
                    %>
                      <tr class="border-t border-slate-100 <%= isSelected ? 'bg-emerald-50' : '' %>">
                        <td class="px-3 py-2">
                          <a href="#path-<%= ps.id %>-<%= pi %>" class="inline-flex items-center gap-2">
                            <span class="inline-block w-2 h-2 rounded-full <%= color.dot %>"></span>
                            <span class="font-medium text-slate-800"><%= p.path_name %></span>
                          </a>
                        </td>
                        <td class="px-3 py-2 text-right tabular-nums <%= highlight(m.predicted_reply_rate, bestReply) %>">
                          <%= m.predicted_reply_rate != null ? m.predicted_reply_rate + '%' : '—' %>
                        </td>
                        <td class="px-3 py-2 text-right tabular-nums <%= highlight(m.predicted_days_to_meeting, bestDays) %>">
                          <%= m.predicted_days_to_meeting != null ? m.predicted_days_to_meeting + 'd' : '—' %>
                        </td>
                        <td class="px-3 py-2 text-right tabular-nums <%= highlight(m.effort_score, bestEffort) %>">
                          <%= effortLabel(m.effort_score) %>
                        </td>
                        <td class="px-3 py-2 text-right tabular-nums <%= highlight(m.confidence, bestConf) %>">
                          <%= m.confidence != null ? m.confidence + '/10' : '—' %>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

              <!-- Detail cards: one per path -->
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                <% paths.forEach(function(p, pi) {
                  const m = p.metrics || {};
                  const color = pathColors[pi] || pathColors[0];
                  const isSelected = ps.selected_path === pi;
                  const isDimmed = ps.selected_path != null && !isSelected;
                  const reply = m.predicted_reply_rate ?? 0;
                  const conf  = m.confidence ?? 0;
                  const effort = m.effort_score ?? 0;
                %>
                  <div id="path-<%= ps.id %>-<%= pi %>"
                       class="bg-white border-2 <%= color.border %> rounded-lg overflow-hidden flex flex-col
                              <%= isSelected ? color.selected : '' %>
                              <%= isDimmed ? 'opacity-50' : '' %>">
                    <!-- Header strip -->
                    <div class="<%= color.header %> px-4 py-2 flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <span class="inline-block w-2 h-2 rounded-full <%= color.dot %>"></span>
                        <span class="text-sm font-semibold">Path <%= pi + 1 %></span>
                      </div>
                      <% if (isSelected) { %><span class="text-[10px] uppercase tracking-wider font-bold">&check; Selected</span><% } %>
                    </div>

                    <div class="p-4 flex-1 flex flex-col">
                      <!-- Path name + hypothesis -->
                      <div class="text-base font-semibold text-slate-900 mb-1"><%= p.path_name %></div>
                      <div class="text-xs text-slate-600 italic mb-4 leading-snug"><%= p.hypothesis %></div>

                      <!-- Metric grid: 2×2 big numbers + bars -->
                      <div class="grid grid-cols-2 gap-3 mb-4">
                        <!-- Reply rate -->
                        <div class="bg-slate-50 rounded p-2.5">
                          <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Reply %</div>
                          <div class="text-xl font-bold tabular-nums text-slate-900"><%= reply %>%</div>
                          <div class="w-full bg-slate-200 rounded-full h-1 mt-1">
                            <div class="<%= color.bar %> h-1 rounded-full" style="width: <%= Math.min(100, reply * 2) %>%"></div>
                          </div>
                        </div>
                        <!-- Days to meeting -->
                        <div class="bg-slate-50 rounded p-2.5">
                          <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Days &rarr; meet</div>
                          <div class="text-xl font-bold tabular-nums text-slate-900">
                            <%= m.predicted_days_to_meeting != null ? m.predicted_days_to_meeting + 'd' : '—' %>
                          </div>
                          <div class="text-[10px] text-slate-400 mt-1">if booked</div>
                        </div>
                        <!-- Effort -->
                        <div class="bg-slate-50 rounded p-2.5">
                          <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Effort</div>
                          <div class="flex items-baseline gap-1">
                            <div class="text-xl font-bold text-slate-900"><%= effortLabel(effort) %></div>
                            <div class="text-[10px] text-slate-500"><%= ['','<30min','1hr','½ day','1 day','multi-day'][effort] || '' %></div>
                          </div>
                          <div class="flex gap-0.5 mt-1">
                            <% for (let e = 1; e <= 5; e++) { %>
                              <div class="flex-1 h-1 rounded-full <%= e <= effort ? color.bar : 'bg-slate-200' %>"></div>
                            <% } %>
                          </div>
                        </div>
                        <!-- Confidence -->
                        <div class="bg-slate-50 rounded p-2.5">
                          <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">Confidence</div>
                          <div class="text-xl font-bold tabular-nums text-slate-900"><%= conf %><span class="text-xs text-slate-500">/10</span></div>
                          <div class="w-full bg-slate-200 rounded-full h-1 mt-1">
                            <div class="<%= color.bar %> h-1 rounded-full" style="width: <%= conf * 10 %>%"></div>
                          </div>
                        </div>
                      </div>

                      <!-- Sequence timeline: dot chain -->
                      <div class="mb-4">
                        <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mb-2">Sequence</div>
                        <div class="flex items-start gap-1 overflow-x-auto">
                          <% (p.steps || []).forEach(function(step, si) { %>
                            <% if (si > 0) { %>
                              <div class="h-px bg-slate-300 flex-1 mt-3 min-w-[12px]"></div>
                            <% } %>
                            <div class="flex flex-col items-center shrink-0" title="<%= step.action %>">
                              <div class="w-6 h-6 rounded-full <%= channelColor(step.channel) %> flex items-center justify-center text-[11px] font-bold"><%= channelIcon(step.channel) %></div>
                              <div class="text-[9px] text-slate-500 mt-1">D<%= step.day %></div>
                              <div class="text-[9px] text-slate-700 font-medium"><%= step.channel %></div>
                            </div>
                          <% }); %>
                        </div>
                      </div>

                      <!-- Best / worst: one-line each, side-by-side -->
                      <div class="grid grid-cols-2 gap-2 mb-3 text-[11px]">
                        <div class="bg-emerald-50 border border-emerald-200 rounded p-2">
                          <div class="text-[10px] uppercase tracking-wide text-emerald-700 font-semibold">Best</div>
                          <div class="text-slate-700 leading-snug"><%= p.best_case || '—' %></div>
                        </div>
                        <div class="bg-red-50 border border-red-200 rounded p-2">
                          <div class="text-[10px] uppercase tracking-wide text-red-700 font-semibold">Worst</div>
                          <div class="text-slate-700 leading-snug"><%= p.worst_case || '—' %></div>
                        </div>
                      </div>

                      <!-- Key variable -->
                      <% if (p.key_variable) { %>
                        <div class="text-[11px] text-slate-500 mb-3">
                          <span class="font-semibold text-slate-600">Hinges on:</span> <%= p.key_variable %>
                        </div>
                      <% } %>

                      <!-- Drafts — collapsed, no dead weight on the card -->
                      <% if ((p.steps || []).some(s => s.draft_message)) { %>
                        <details class="mb-3 text-xs">
                          <summary class="cursor-pointer text-slate-600 hover:text-slate-900 select-none font-medium">&#9662; Show drafts (<%= (p.steps || []).filter(s => s.draft_message).length %>)</summary>
                          <div class="mt-2 space-y-2">
                            <% (p.steps || []).forEach(function(step) { if (step.draft_message) { %>
                              <div class="bg-slate-50 border-l-2 <%= color.border %> pl-3 py-2 pr-2">
                                <div class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold">
                                  Day <%= step.day %> &middot; <%= step.channel %> &middot; <%= step.action %>
                                </div>
                                <div class="text-slate-700 mt-1 whitespace-pre-wrap"><%= step.draft_message %></div>
                              </div>
                            <% } }); %>
                          </div>
                        </details>
                      <% } %>

                      <!-- Select -->
                      <% if (ps.selected_path == null) { %>
                        <form method="POST" action="/revisit/paths/<%= ps.id %>/select" class="mt-auto">
                          <input type="hidden" name="path_index" value="<%= pi %>" />
                          <button type="submit"
                                  class="w-full text-xs font-semibold py-2 rounded <%= color.selectBtn %> transition">
                            Select this hypothesis
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                <% }); %>
              </div>

              <!-- Outcome tracker -->
              <% if (ps.selected_path != null && !ps.outcome) { %>
                <div class="mt-4 bg-slate-50 border border-slate-200 rounded-lg p-4">
                  <div class="text-sm font-semibold text-slate-700 mb-2">How did it go?</div>
                  <form method="POST" action="/revisit/paths/<%= ps.id %>/outcome" class="flex items-end gap-3 flex-wrap">
                    <div>
                      <select name="outcome" class="text-sm border border-slate-300 rounded px-3 py-1.5">
                        <option value="in_progress">In progress</option>
                        <option value="won">Won (meeting / reply)</option>
                        <option value="no_response">No response</option>
                        <option value="lost">Lost (rejected)</option>
                      </select>
                    </div>
                    <div class="flex-1">
                      <input type="text" name="notes" placeholder="What happened? (optional)" class="w-full text-sm border border-slate-300 rounded px-3 py-1.5" />
                    </div>
                    <button type="submit" class="text-sm bg-slate-900 hover:bg-slate-800 text-white px-4 py-1.5 rounded font-medium">
                      Record outcome
                    </button>
                  </form>
                </div>
              <% } else if (ps.outcome) { %>
                <div class="mt-4 bg-slate-50 border border-slate-200 rounded-lg p-4 text-sm">
                  <span class="pill <%= outcomeColors[ps.outcome] || 'bg-slate-100' %>"><%= outcomeLabels[ps.outcome] || ps.outcome %></span>
                  <% if (ps.outcome_notes) { %><span class="text-slate-600 ml-2"><%= ps.outcome_notes %></span><% } %>
                  <span class="text-xs text-slate-400 ml-2">&middot; recorded <%= fmtDate(ps.outcome_at) %></span>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>
<% } else if (!isRunning) { %>
  <div class="bg-white border border-slate-200 rounded-lg p-8 text-sm text-slate-500 text-center">
    <div class="text-base text-slate-700 mb-1">Not scanned yet.</div>
    Click <strong>Run scan</strong> above to ask Claude what's changed since this deal closed.
  </div>
<% } %>
