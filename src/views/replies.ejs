<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold">Replies <span class="text-slate-400 text-base font-normal">(<%= replies.length %> pending)</span></h1>
</div>

<% if (replies.length === 0) { %>
  <div class="bg-white border border-slate-200 rounded-lg p-10 text-center text-slate-500">
    No replies in the queue. The reply monitor runs every 30 minutes during business hours.
  </div>
<% } %>

<% function classBadge(c) {
  const map = {
    interested: 'bg-emerald-100 text-emerald-800',
    not_now: 'bg-amber-100 text-amber-800',
    not_interested: 'bg-slate-100 text-slate-700',
    objection: 'bg-blue-100 text-blue-800',
    referral: 'bg-violet-100 text-violet-800',
    ooo: 'bg-slate-100 text-slate-500',
  };
  return map[c] || 'bg-slate-100 text-slate-700';
} %>

<% replies.forEach(function(r) { %>
  <div class="bg-white border <%= r.escalate ? 'border-red-300' : 'border-slate-200' %> rounded-lg mb-3 p-5">
    <div class="flex items-center justify-between mb-3">
      <div>
        <div class="font-medium text-slate-900"><%= r.company %></div>
        <div class="text-xs text-slate-500"><%= r.contact_name || '—' %> · <%= r.contact_email || '' %></div>
      </div>
      <div class="flex items-center gap-2">
        <span class="pill <%= classBadge(r.classification) %>"><%= r.classification %></span>
        <% if (r.escalate) { %>
          <span class="pill bg-red-100 text-red-800">Escalate</span>
        <% } %>
      </div>
    </div>

    <% if (r.escalate && r.escalate_reason) { %>
      <div class="bg-red-50 border border-red-200 text-red-800 text-xs p-3 rounded mb-3">
        <strong>Why escalate:</strong> <%= r.escalate_reason %>. Edit the draft before sending.
      </div>
    <% } %>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <div class="text-xs uppercase tracking-wide text-slate-500 mb-1">Their reply</div>
        <pre class="bg-slate-50 border border-slate-200 rounded p-3 text-sm whitespace-pre-wrap font-sans"><%= r.original_reply %></pre>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wide text-slate-500 mb-1">Drafted response</div>
        <textarea data-reply-id="<%= r.id %>" rows="8"
          class="w-full border border-slate-200 rounded px-3 py-2 text-sm font-mono"><%- r.draft_response || '' %></textarea>
      </div>
    </div>

    <% if (r.referral_draft) { %>
      <div class="mt-4">
        <div class="text-xs uppercase tracking-wide text-slate-500 mb-1">Referral outreach</div>
        <pre class="bg-slate-50 border border-slate-200 rounded p-3 text-sm whitespace-pre-wrap font-sans"><%= r.referral_draft %></pre>
      </div>
    <% } %>

    <% if (r.notes) { %>
      <div class="mt-3 text-xs text-slate-500"><strong>Notes:</strong> <%= r.notes %></div>
    <% } %>

    <div class="flex items-center gap-3 mt-4 pt-4 border-t border-slate-100">
      <button type="button" data-action="approve" data-reply-id="<%= r.id %>"
        <%= r.escalate ? 'disabled title="Edit before sending"' : '' %>
        class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed">Send reply</button>
      <button type="button" data-action="reject" data-reply-id="<%= r.id %>"
        class="bg-white hover:bg-red-50 text-red-700 border border-red-200 px-4 py-2 rounded text-sm font-medium ml-auto">Discard</button>
    </div>
  </div>
<% }); %>

<script>
  document.querySelectorAll('button[data-action]').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const id = btn.dataset.replyId;
      btn.disabled = true;
      try {
        await fetch('/api/queue/replies/' + id + '/' + btn.dataset.action, { method: 'POST' });
        btn.closest('div.bg-white').remove();
      } catch (e) {
        alert('Error: ' + e.message);
        btn.disabled = false;
      }
    });
  });
</script>
