<h1 class="text-2xl font-semibold mb-6">Dashboard</h1>

<% if ((counts.signalsThisWeek || 0) > 0 || (counts.signalsUnacked || 0) > 0) { %>
  <a href="/brief" class="block mb-4 bg-white border-2 border-slate-900 rounded-lg p-4 hover:bg-slate-50">
    <div class="flex items-center justify-between gap-4">
      <div>
        <div class="text-xs uppercase tracking-wide text-slate-500">Today</div>
        <div class="text-lg font-semibold mt-1">
          <%= counts.signalsThisWeek %> signal<%= counts.signalsThisWeek === 1 ? '' : 's' %> this week
          <span class="text-sm text-slate-500 font-normal">
            (<span class="text-red-700 font-medium"><%= counts.signalsDefense %></span> defense ·
             <span class="text-sky-700 font-medium"><%= counts.signalsOffense %></span> offense ·
             <span class="text-emerald-700 font-medium"><%= counts.signalsGrowth || 0 %></span> growth ·
             <span class="text-amber-700 font-medium"><%= counts.signalsRevisit || 0 %></span> revisit)
          </span>
        </div>
        <div class="text-xs text-slate-500 mt-0.5">
          One ranked feed across customers, expansion, and revisit. Defense first, then offense, growth, revisit.
        </div>
      </div>
      <span class="text-sm bg-slate-900 text-white px-4 py-2 rounded font-medium">Open Today →</span>
    </div>
  </a>
<% } %>

<% if ((counts.playsActive || 0) > 0) { %>
  <a href="/plays" class="block mb-4 bg-white border border-slate-200 rounded-lg p-4 hover:bg-slate-50">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div>
        <div class="text-xs uppercase tracking-wide text-slate-500">Active plays</div>
        <div class="text-lg font-semibold mt-1">
          <%= counts.playsActive %> active
          <% if ((counts.playsDueSoon || 0) > 0) { %>
            <span class="text-sm text-amber-700 font-medium">· <%= counts.playsDueSoon %> due this week</span>
          <% } %>
        </div>
        <div class="text-xs text-slate-500 mt-0.5">
          Named plays in flight on your book. Grouped by account.
        </div>
      </div>
      <span class="text-sm text-slate-500">Open →</span>
    </div>
  </a>
<% } %>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <div class="text-xs uppercase tracking-wide text-slate-500">Drafts pending</div>
    <div class="text-3xl font-semibold mt-2"><%= counts.pendingDrafts %></div>
    <a href="/drafts" class="text-xs text-slate-500 hover:text-slate-900 mt-2 inline-block">Review →</a>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <div class="text-xs uppercase tracking-wide text-slate-500">Replies pending</div>
    <div class="text-3xl font-semibold mt-2"><%= counts.pendingReplies %></div>
    <a href="/replies" class="text-xs text-slate-500 hover:text-slate-900 mt-2 inline-block">Review →</a>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <div class="text-xs uppercase tracking-wide text-slate-500">Researched today</div>
    <div class="text-3xl font-semibold mt-2"><%= counts.researchedToday %></div>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <div class="text-xs uppercase tracking-wide text-slate-500">Sent this week</div>
    <div class="text-3xl font-semibold mt-2"><%= counts.sentThisWeek %></div>
  </div>
</div>

<h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">Connections</h2>
<div class="grid grid-cols-1 md:grid-cols-4 gap-3 mb-8">
  <% connections.forEach(function(c) { %>
    <div class="bg-white border border-slate-200 rounded-lg p-4 flex items-center justify-between">
      <div>
        <div class="text-sm font-medium"><%= c.label %></div>
        <div class="text-xs text-slate-500 mt-0.5"><%= c.detail %></div>
      </div>
      <span class="w-2.5 h-2.5 rounded-full <%= c.ok ? 'bg-emerald-500' : 'bg-slate-300' %>"></span>
    </div>
  <% }); %>
</div>

<div class="bg-white border border-slate-200 rounded-lg p-5">
  <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">How this works</h2>
  <ol class="text-sm text-slate-600 space-y-2 list-decimal ml-5">
    <li>Researcher cron pulls accounts from Salesforce + intent signals from CommonRoom, scores each, writes them to <code class="bg-slate-100 px-1 rounded">prospects</code>.</li>
    <li>Writer cron generates a 3-touch sequence for any prospect with a fit score ≥ 50, queues it on the <a href="/drafts" class="underline">Drafts</a> page.</li>
    <li>You approve, edit, or reject. Approved drafts get sent through Gmail / LinkedIn within the daily limit and send window.</li>
    <li>Reply monitor classifies inbound responses every 30 minutes and queues drafts on the <a href="/replies" class="underline">Replies</a> page.</li>
  </ol>
</div>
