<h1 class="text-2xl font-semibold mb-6">Settings</h1>

<section class="mb-8">
  <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">Connections</h2>
  <p class="text-sm text-slate-500 mb-4">Connect external accounts so the agent can send messages and pull data. OAuth tokens are stored in the database — you don't need to edit the .env file for these.</p>

  <div class="space-y-3">
    <% providers.forEach(function(p) { %>
      <div class="bg-white border border-slate-200 rounded-lg p-5 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <span class="w-2.5 h-2.5 rounded-full <%= p.connected ? 'bg-emerald-500' : 'bg-slate-300' %>"></span>
          <div>
            <div class="font-medium"><%= p.label %></div>
            <div class="text-xs text-slate-500"><%= p.description %></div>
            <% if (p.connected) { %>
              <div class="text-xs text-emerald-700 mt-0.5">Connected as <%= p.account_label %> · <%= new Date(p.connected_at).toLocaleDateString() %></div>
            <% } %>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <% if (p.connected) { %>
            <form method="POST" action="/settings/disconnect/<%= p.provider %>">
              <button type="submit" class="text-sm text-red-700 hover:underline">Disconnect</button>
            </form>
          <% } else if (p.oauth_url) { %>
            <a href="<%= p.oauth_url %>" class="bg-slate-900 hover:bg-slate-800 text-white text-sm font-medium px-4 py-2 rounded">Connect</a>
          <% } else { %>
            <span class="text-xs text-slate-400">Coming soon</span>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<section class="mb-8">
  <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">Send window</h2>
  <div class="bg-white border border-slate-200 rounded-lg p-5 text-sm text-slate-600">
    <p>Currently sending Mon–Fri, <%= sendWindow.start %>:00–<%= sendWindow.end %>:00 (<%= sendWindow.tz %>), max <%= sendWindow.dailyLimit %> emails/day.</p>
    <p class="text-xs text-slate-400 mt-2">Edit <code class="bg-slate-100 px-1 rounded">SEND_WINDOW_START</code>, <code class="bg-slate-100 px-1 rounded">SEND_WINDOW_END</code>, <code class="bg-slate-100 px-1 rounded">DAILY_EMAIL_LIMIT</code>, and <code class="bg-slate-100 px-1 rounded">SEND_TIMEZONE</code> in your .env file to change these.</p>
  </div>
</section>

<section>
  <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">Team</h2>
  <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="text-left p-3">Email</th>
          <th class="text-left p-3">Name</th>
          <th class="text-left p-3">Role</th>
          <th class="text-left p-3">Last login</th>
          <th class="text-right p-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr class="border-t border-slate-100">
            <td class="p-3"><%= u.email %><% if (currentUser && u.id === currentUser.id) { %> <span class="text-xs text-slate-400">(you)</span><% } %></td>
            <td class="p-3"><%= u.name || '—' %></td>
            <td class="p-3">
              <% if (currentUser && u.id !== currentUser.id) { %>
                <form method="POST" action="/settings/users/<%= u.id %>/role" class="inline">
                  <select name="role" onchange="this.form.submit()" class="text-xs border border-slate-300 rounded px-2 py-1">
                    <option value="member" <%= u.role !== 'admin' ? 'selected' : '' %>>Member</option>
                    <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                  </select>
                </form>
              <% } else { %>
                <span class="text-xs pill bg-slate-100 text-slate-700"><%= u.role || 'member' %></span>
              <% } %>
            </td>
            <td class="p-3 text-slate-500"><%= u.last_login_at ? new Date(u.last_login_at).toLocaleString() : 'never' %></td>
            <td class="p-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <details class="relative">
                  <summary class="text-xs text-slate-500 hover:text-slate-900 cursor-pointer">Reset password</summary>
                  <form method="POST" action="/settings/users/<%= u.id %>/reset-password"
                        class="absolute right-0 mt-1 bg-white border border-slate-200 rounded-lg shadow-lg p-3 z-10 w-56">
                    <input type="password" name="password" placeholder="New password (min 6)" required minlength="6"
                           class="w-full border border-slate-300 rounded px-2 py-1 text-xs mb-2" />
                    <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white text-xs px-3 py-1.5 rounded font-medium">Reset</button>
                  </form>
                </details>
                <% if (currentUser && u.id !== currentUser.id) { %>
                  <form method="POST" action="/settings/users/<%= u.id %>/delete"
                        onsubmit="return confirm('Remove this user?')">
                    <button type="submit" class="text-xs text-red-600 hover:text-red-800">Remove</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <div class="border-t border-slate-200 p-4 bg-slate-50">
      <div class="text-xs font-semibold text-slate-700 mb-2">Add team member</div>
      <form method="POST" action="/settings/users" class="flex items-end gap-2 flex-wrap">
        <div>
          <label class="text-[10px] uppercase tracking-wide text-slate-500">Email *</label>
          <input type="email" name="email" required placeholder="name@company.com"
                 class="block w-48 border border-slate-300 rounded px-2 py-1 text-xs" />
        </div>
        <div>
          <label class="text-[10px] uppercase tracking-wide text-slate-500">Name</label>
          <input type="text" name="name" placeholder="Full Name"
                 class="block w-36 border border-slate-300 rounded px-2 py-1 text-xs" />
        </div>
        <div>
          <label class="text-[10px] uppercase tracking-wide text-slate-500">Password *</label>
          <input type="password" name="password" required minlength="6" placeholder="min 6 chars"
                 class="block w-32 border border-slate-300 rounded px-2 py-1 text-xs" />
        </div>
        <div>
          <label class="text-[10px] uppercase tracking-wide text-slate-500">Role</label>
          <select name="role" class="block border border-slate-300 rounded px-2 py-1 text-xs">
            <option value="member">Member</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white text-xs px-4 py-1.5 rounded font-medium">Add user</button>
      </form>
    </div>
  </div>
</section>
