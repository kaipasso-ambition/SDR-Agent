<%
  const dealRoleMeta = {
    economic_buyer: { label: 'Economic buyer', pill: 'bg-violet-100 text-violet-800' },
    champion:       { label: 'Champion',        pill: 'bg-emerald-100 text-emerald-800' },
    coach:          { label: 'Coach',           pill: 'bg-sky-100 text-sky-800' },
    influencer:     { label: 'Influencer',      pill: 'bg-amber-100 text-amber-800' },
    user:           { label: 'User',             pill: 'bg-slate-100 text-slate-700' },
    blocker:        { label: 'Blocker',         pill: 'bg-red-100 text-red-800' },
    unknown:        { label: 'Unclassified',    pill: 'bg-slate-100 text-slate-500' },
  };
  const stanceMeta = {
    hot:     { label: '🔥 Hot',     cls: 'text-red-600 font-medium' },
    warm:    { label: 'Warm',        cls: 'text-orange-600' },
    neutral: { label: 'Neutral',     cls: 'text-slate-500' },
    cold:    { label: 'Cold',        cls: 'text-sky-700' },
    hostile: { label: 'Hostile',     cls: 'text-red-700 font-medium' },
  };
  const useCaseLabel = {
    performance_graph:   'Performance Graph',
    ascend_coaching:     'Ascend coaching',
    gtm_governance:      'GTM Governance',
    manager_enablement:  'Manager enablement',
    rep_ramp:            'Rep ramp',
    multi_team_rollup:   'Multi-team roll-up',
  };
  const playStatusMeta = {
    drafting:   { label: 'Drafting',  cls: 'bg-amber-100 text-amber-800' },
    active:     { label: 'Active',    cls: 'bg-emerald-100 text-emerald-800' },
    paused:     { label: 'Paused',    cls: 'bg-slate-100 text-slate-700' },
    won:        { label: 'Won',        cls: 'bg-violet-100 text-violet-800' },
    lost:       { label: 'Lost',       cls: 'bg-slate-100 text-slate-500' },
    abandoned:  { label: 'Abandoned', cls: 'bg-slate-100 text-slate-500' },
  };
  // Sports/coaching vernacular on the play card — matches Ambition's own
  // gamification voice. CHAMPION is the starter carrying the ball;
  // AE is the coach equipping them; internal is the assistant coach.
  const actorMeta = {
    champion:          { label: '🏈 Champion carries', cls: 'bg-emerald-100 text-emerald-900 border-emerald-300' },
    ae:                { label: '🎯 You (coach)',       cls: 'bg-slate-100 text-slate-800 border-slate-300' },
    internal_colleague:{ label: '🤝 Internal assist',   cls: 'bg-sky-100 text-sky-900 border-sky-300' },
  };

  // Build the reports_to tree then flatten into a depth-annotated list so
  // the template can render without a recursive EJS function (EJS scriptlet
  // tags can't be nested inside a user-defined function body).
  const byId = new Map(contacts.map((c) => [c.id, { ...c, children: [] }]));
  const roots = [];
  for (const c of byId.values()) {
    const parentId = c.reports_to_contact_id;
    if (parentId && byId.has(parentId)) byId.get(parentId).children.push(c);
    else roots.push(c);
  }
  const contactRows = [];
  function walk(node, depth) {
    contactRows.push({ node, depth });
    for (const child of node.children) walk(child, depth + 1);
  }
  for (const root of roots) walk(root, 0);
%>

<div class="mb-6">
  <a href="/accounts/<%= account.id %>" class="text-xs text-slate-500 hover:text-slate-900">← <%= account.account_name %></a>
  <div class="flex items-start justify-between gap-4 mt-2">
    <div>
      <h1 class="text-2xl font-semibold"><%= account.account_name %> — Game Plan</h1>
      <p class="text-sm text-slate-500 mt-1 max-w-3xl">
        Scouting report (who's on the roster), theory of the case (what we're playing for),
        and the playbook (our called moves). Your instincts are the spine; Claude scaffolds
        around them. Default ball-carrier on any move inside the buyer's org: the champion.
        Your job is to equip the starter, not to run the play yourself.
      </p>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- ============ COLUMN 1: ORG CHART ============ -->
  <section class="bg-white border border-slate-200 rounded-lg overflow-hidden">
    <header class="px-4 py-3 border-b border-slate-200">
      <h2 class="font-semibold">Org chart</h2>
      <p class="text-xs text-slate-500 mt-0.5">
        Click any contact to re-role, re-stance, or re-parent. Auto-placed pieces are marked 🔵.
      </p>
    </header>

    <% if (roots.length === 0) { %>
      <div class="p-5 text-sm text-slate-500">
        No contacts yet. Add one below — or run a signal scan and Claude will auto-place people it finds.
      </div>
    <% } else { %>
      <ul class="p-3 space-y-1 text-sm">
        <% contactRows.forEach(function(row) { var node = row.node; var depth = row.depth; %>
          <li style="padding-left: <%= depth * 16 %>px;">
            <details class="group">
              <summary class="cursor-pointer list-none flex items-start gap-2 py-1.5 px-2 hover:bg-slate-50 rounded">
                <% if (depth > 0) { %><span class="text-slate-400">└─</span><% } %>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-medium text-slate-900"><%= node.name %></span>
                    <% if (node.source === 'signal_mention') { %><span title="auto-placed from a signal">🔵</span><% } %>
                    <span class="pill <%= (dealRoleMeta[node.deal_role] || dealRoleMeta.unknown).pill %>">
                      <%= (dealRoleMeta[node.deal_role] || dealRoleMeta.unknown).label %>
                    </span>
                    <span class="text-xs <%= (stanceMeta[node.stance] || stanceMeta.neutral).cls %>">
                      <%= (stanceMeta[node.stance] || stanceMeta.neutral).label %>
                    </span>
                  </div>
                  <% if (node.title) { %><div class="text-xs text-slate-500"><%= node.title %></div><% } %>
                </div>
              </summary>
              <form method="POST" action="/contacts/<%= node.id %>" class="bg-slate-50 border border-slate-200 rounded p-3 mt-1 mb-2 space-y-2 text-xs">
                <div class="grid grid-cols-2 gap-2">
                  <label class="block">
                    <span class="text-slate-500">Name</span>
                    <input name="name" value="<%= node.name %>" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5" />
                  </label>
                  <label class="block">
                    <span class="text-slate-500">Title</span>
                    <input name="title" value="<%= node.title || '' %>" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5" />
                  </label>
                  <label class="block">
                    <span class="text-slate-500">Deal role</span>
                    <select name="deal_role" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
                      <% Object.keys(dealRoleMeta).forEach(function(k) { %>
                        <option value="<%= k %>" <%= node.deal_role === k ? 'selected' : '' %>><%= dealRoleMeta[k].label %></option>
                      <% }); %>
                    </select>
                  </label>
                  <label class="block">
                    <span class="text-slate-500">Stance</span>
                    <select name="stance" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
                      <% Object.keys(stanceMeta).forEach(function(k) { %>
                        <option value="<%= k %>" <%= node.stance === k ? 'selected' : '' %>><%= stanceMeta[k].label %></option>
                      <% }); %>
                    </select>
                  </label>
                </div>
                <label class="block">
                  <span class="text-slate-500">Reports to</span>
                  <select name="reports_to_contact_id" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5">
                    <option value="">— top of org —</option>
                    <% contacts.filter(function(c){ return c.id !== node.id; }).forEach(function(c) { %>
                      <option value="<%= c.id %>" <%= node.reports_to_contact_id === c.id ? 'selected' : '' %>><%= c.name %> (<%= c.title || '—' %>)</option>
                    <% }); %>
                  </select>
                </label>
                <label class="block">
                  <span class="text-slate-500">Notes</span>
                  <textarea name="notes" rows="2" class="w-full border border-slate-300 rounded px-2 py-1 mt-0.5"><%= node.notes || '' %></textarea>
                </label>
                <div class="flex items-center gap-2">
                  <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded font-medium">Save</button>
                  <button type="submit" formaction="/contacts/<%= node.id %>/delete" class="text-red-600 hover:text-red-800">Remove</button>
                </div>
              </form>
            </details>
          </li>
        <% }); %>
      </ul>
    <% } %>

    <details class="border-t border-slate-200 p-4 bg-slate-50">
      <summary class="text-xs font-semibold text-slate-700 cursor-pointer">+ Add contact manually</summary>
      <form method="POST" action="/accounts/<%= account.id %>/contacts" class="mt-3 space-y-2 text-xs">
        <div class="grid grid-cols-2 gap-2">
          <input name="name" placeholder="Name *" required class="border border-slate-300 rounded px-2 py-1" />
          <input name="title" placeholder="Title" class="border border-slate-300 rounded px-2 py-1" />
          <select name="deal_role" class="border border-slate-300 rounded px-2 py-1">
            <% Object.keys(dealRoleMeta).forEach(function(k) { %>
              <option value="<%= k %>" <%= k === 'unknown' ? 'selected' : '' %>><%= dealRoleMeta[k].label %></option>
            <% }); %>
          </select>
          <select name="stance" class="border border-slate-300 rounded px-2 py-1">
            <% Object.keys(stanceMeta).forEach(function(k) { %>
              <option value="<%= k %>" <%= k === 'neutral' ? 'selected' : '' %>><%= stanceMeta[k].label %></option>
            <% }); %>
          </select>
        </div>
        <select name="reports_to_contact_id" class="w-full border border-slate-300 rounded px-2 py-1">
          <option value="">— reports to (top of org) —</option>
          <% contacts.forEach(function(c) { %>
            <option value="<%= c.id %>"><%= c.name %> (<%= c.title || '—' %>)</option>
          <% }); %>
        </select>
        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded font-medium">Add contact</button>
      </form>
    </details>
  </section>

  <!-- ============ COLUMN 2: HYPOTHESES ============ -->
  <section class="bg-white border border-slate-200 rounded-lg overflow-hidden">
    <header class="px-4 py-3 border-b border-slate-200">
      <h2 class="font-semibold">Theory of the case</h2>
      <p class="text-xs text-slate-500 mt-0.5">
        Which Ambition use case fits this account, for which persona, supported by which signals.
      </p>
    </header>

    <% if (hypotheses.length === 0) { %>
      <div class="p-5 text-sm text-slate-500">
        No hypotheses yet. Draft one below — plays attach to hypotheses so your reasoning carries forward.
      </div>
    <% } else { %>
      <ul class="divide-y divide-slate-100">
        <% hypotheses.forEach(function(h) { %>
          <li class="p-4">
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <span class="pill bg-slate-900 text-white"><%= useCaseLabel[h.use_case] || h.use_case %></span>
              <span class="pill bg-sky-100 text-sky-800"><%= h.target_persona_id %></span>
              <span class="text-xs text-slate-500">confidence <%= h.confidence %>/5</span>
              <% if (h.status === 'validated') { %><span class="pill bg-emerald-100 text-emerald-800">validated</span>
              <% } else if (h.status === 'disproven') { %><span class="pill bg-slate-100 text-slate-500">disproven</span>
              <% } %>
            </div>
            <p class="text-sm text-slate-800"><%= h.narrative_hook %></p>

            <% if (h.narrative && (h.narrative.current_state || h.narrative.future_state || h.narrative.bridge)) { %>
              <div class="mt-3 space-y-2 text-xs">
                <% if (h.narrative.current_state) { %>
                  <div class="bg-slate-50 border-l-2 border-slate-300 rounded px-3 py-2">
                    <div class="uppercase tracking-wide text-[10px] text-slate-500 font-semibold mb-0.5">Today</div>
                    <div class="text-slate-800"><%= h.narrative.current_state %></div>
                  </div>
                <% } %>
                <% if (h.narrative.future_state) { %>
                  <div class="bg-emerald-50 border-l-2 border-emerald-400 rounded px-3 py-2">
                    <div class="uppercase tracking-wide text-[10px] text-emerald-700 font-semibold mb-0.5">What would be different</div>
                    <div class="text-slate-800"><%= h.narrative.future_state %></div>
                  </div>
                <% } %>
                <% if (h.narrative.bridge) { %>
                  <div class="bg-violet-50 border-l-2 border-violet-400 rounded px-3 py-2">
                    <div class="uppercase tracking-wide text-[10px] text-violet-700 font-semibold mb-0.5">Bridge</div>
                    <div class="text-slate-800"><%= h.narrative.bridge %></div>
                  </div>
                <% } %>
              </div>
            <% } %>

            <div class="text-xs text-slate-500 mt-2"><%= h.evidence_count || 0 %> evidence signal<%= h.evidence_count === 1 ? '' : 's' %></div>
            <details class="mt-2">
              <summary class="text-xs text-slate-500 hover:text-slate-900 cursor-pointer">Edit</summary>
              <form method="POST" action="/hypotheses/<%= h.id %>" class="mt-2 space-y-2 text-xs">
                <textarea name="narrative_hook" rows="2" class="w-full border border-slate-300 rounded px-2 py-1"><%= h.narrative_hook %></textarea>
                <div class="space-y-1">
                  <div class="uppercase tracking-wide text-[10px] text-slate-500 font-semibold">Three-beat narrative (champion voice — optional)</div>
                  <textarea name="narrative_current_state" rows="2" placeholder="Today — what's the status quo?" class="w-full border border-slate-300 rounded px-2 py-1"><%= (h.narrative && h.narrative.current_state) || '' %></textarea>
                  <textarea name="narrative_future_state" rows="2" placeholder="What would be different?" class="w-full border border-slate-300 rounded px-2 py-1"><%= (h.narrative && h.narrative.future_state) || '' %></textarea>
                  <textarea name="narrative_bridge" rows="2" placeholder="Bridge — what we're asking for" class="w-full border border-slate-300 rounded px-2 py-1"><%= (h.narrative && h.narrative.bridge) || '' %></textarea>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <select name="status" class="border border-slate-300 rounded px-2 py-1">
                    <option value="theory"     <%= h.status === 'theory' ? 'selected' : '' %>>Theory</option>
                    <option value="validated"  <%= h.status === 'validated' ? 'selected' : '' %>>Validated</option>
                    <option value="disproven"  <%= h.status === 'disproven' ? 'selected' : '' %>>Disproven</option>
                  </select>
                  <label class="flex items-center gap-1"><span class="text-slate-500">conf</span>
                    <input type="number" min="1" max="5" name="confidence" value="<%= h.confidence %>" class="w-14 border border-slate-300 rounded px-2 py-1" />
                  </label>
                  <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white rounded font-medium">Save</button>
                </div>
                <button type="submit" formaction="/hypotheses/<%= h.id %>/delete" class="text-red-600 hover:text-red-800 text-xs">Remove</button>
              </form>
            </details>
          </li>
        <% }); %>
      </ul>
    <% } %>

    <details class="border-t border-slate-200 p-4 bg-slate-50">
      <summary class="text-xs font-semibold text-slate-700 cursor-pointer">+ New hypothesis</summary>
      <form method="POST" action="/accounts/<%= account.id %>/hypotheses" class="mt-3 space-y-2 text-xs">
        <div class="grid grid-cols-2 gap-2">
          <select name="use_case" required class="border border-slate-300 rounded px-2 py-1">
            <option value="">Use case *</option>
            <% Object.keys(useCaseLabel).forEach(function(k) { %>
              <option value="<%= k %>"><%= useCaseLabel[k] %></option>
            <% }); %>
          </select>
          <select name="target_persona_id" required class="border border-slate-300 rounded px-2 py-1">
            <option value="">Persona *</option>
            <% personas.forEach(function(p) { %>
              <option value="<%= p.id %>"><%= p.label || p.id %></option>
            <% }); %>
          </select>
        </div>
        <textarea name="narrative_hook" rows="2" required placeholder="Narrative hook — one line. &quot;Earnings call flagged tooling rationalization; pitch one Performance Graph across SDR + AE.&quot;" class="w-full border border-slate-300 rounded px-2 py-1"></textarea>

        <details>
          <summary class="cursor-pointer text-slate-500 text-xs">+ Three-beat narrative (champion voice — optional, Nasralla arc)</summary>
          <div class="mt-2 space-y-1">
            <textarea name="narrative_current_state" rows="2" placeholder="Today. What the champion sees inside the org today — status quo, pain, workaround." class="w-full border border-slate-300 rounded px-2 py-1"></textarea>
            <textarea name="narrative_future_state" rows="2" placeholder="What would be different. What the champion is telling their peers life looks like on the other side." class="w-full border border-slate-300 rounded px-2 py-1"></textarea>
            <textarea name="narrative_bridge" rows="2" placeholder="Bridge. The specific ask — 20 minutes, a meeting, a one-pager input — in the champion's voice." class="w-full border border-slate-300 rounded px-2 py-1"></textarea>
          </div>
        </details>
        <div class="grid grid-cols-2 gap-2">
          <label class="flex items-center gap-1"><span class="text-slate-500">confidence</span>
            <input type="number" min="1" max="5" name="confidence" value="3" class="w-14 border border-slate-300 rounded px-2 py-1" />
          </label>
          <% if (pulseSignals && pulseSignals.length > 0) { %>
            <details class="relative">
              <summary class="cursor-pointer text-slate-500">Attach evidence signals (<%= pulseSignals.length %> available)</summary>
              <div class="absolute z-10 right-0 mt-1 w-72 max-h-60 overflow-y-auto bg-white border border-slate-300 rounded p-2 shadow">
                <% pulseSignals.forEach(function(s) { %>
                  <label class="flex items-start gap-2 py-1 text-xs">
                    <input type="checkbox" name="evidence_signal_ids" value="<%= s.id %>" />
                    <span><%= s.title %></span>
                  </label>
                <% }); %>
              </div>
            </details>
          <% } %>
        </div>
        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded font-medium">Save hypothesis</button>
      </form>
    </details>
  </section>

  <!-- ============ COLUMN 3: PLAYS ============ -->
  <section class="bg-white border border-slate-200 rounded-lg overflow-hidden">
    <header class="px-4 py-3 border-b border-slate-200 flex items-center justify-between gap-2">
      <div>
        <h2 class="font-semibold">Plays</h2>
        <p class="text-xs text-slate-500 mt-0.5">Instinct + Claude's move sequence. Active plays surface on /brief.</p>
      </div>
    </header>

    <!-- Composer -->
    <details id="play-composer" class="border-b border-slate-200 p-4 bg-slate-50" <% if (composerOpen) { %>open<% } %>>
      <summary class="text-sm font-semibold text-slate-900 cursor-pointer">
        + Start a play
        <% if (triggerSignal) { %><span class="text-xs text-slate-500 font-normal">· triggered by "<%= triggerSignal.title %>"</span><% } %>
      </summary>
      <form method="POST" action="/accounts/<%= account.id %>/plays" class="mt-3 space-y-3"
            onsubmit="return startBuildingPlay(this)">
        <% if (triggerSignal) { %>
          <input type="hidden" name="triggered_by_signal_id" value="<%= triggerSignal.id %>" />
          <div class="bg-white border border-slate-200 rounded p-3 text-xs">
            <div class="text-slate-500 uppercase tracking-wide text-[10px] font-semibold mb-1">Triggering signal</div>
            <div class="font-medium text-slate-900"><%= triggerSignal.title %></div>
            <% if (triggerSignal.so_what) { %><div class="text-slate-600 mt-1"><%= triggerSignal.so_what %></div><% } %>
          </div>
        <% } %>

        <label class="block text-sm">
          <span class="font-medium text-slate-800">What's your read? <span class="text-slate-400 font-normal">(your instinct — Claude scaffolds around it)</span></span>
          <textarea name="instinct" rows="3" required
                    placeholder="e.g. 'SDR team already uses us. Want to get to the new CRO through our SDR champion before Q3 budget review.'"
                    class="w-full border border-slate-300 rounded px-3 py-2 mt-1 text-sm"></textarea>
        </label>

        <% if (hypotheses.length > 0) { %>
          <label class="block text-sm">
            <span class="font-medium text-slate-800">Hypothesis</span>
            <select name="hypothesis_id" class="w-full border border-slate-300 rounded px-3 py-2 mt-1 text-sm">
              <option value="">— none —</option>
              <% hypotheses.forEach(function(h) { %>
                <option value="<%= h.id %>"><%= useCaseLabel[h.use_case] || h.use_case %> → <%= h.target_persona_id %></option>
              <% }); %>
            </select>
          </label>
        <% } %>

        <% if (typeof events !== 'undefined' && events && events.length > 0) { %>
          <%
            // Map event id → invite-slot JSON for the client script.
            const eventSlotMap = {};
            events.forEach(function(e) {
              if (e.personal_invite_session) eventSlotMap[e.id] = e.personal_invite_session;
            });
          %>
          <label class="block text-sm">
            <span class="font-medium text-slate-800">Event <span class="text-slate-400 font-normal">(optional — Gartner stop, CVI dinner, themed wave)</span></span>
            <select name="event_id" id="event-select" class="w-full border border-slate-300 rounded px-3 py-2 mt-1 text-sm">
              <option value="">— none —</option>
              <% events.forEach(function(e) { %>
                <option value="<%= e.id %>" data-has-invite="<%= e.personal_invite_session ? '1' : '0' %>">
                  <%= e.name %><% if (e.event_date) { %> · <%= new Date(e.event_date).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %><% } %><% if (e.personal_invite_session) { %> · 🎤 invite slot<% } %>
                </option>
              <% }); %>
            </select>
          </label>

          <div id="invite-picker" class="hidden bg-violet-50 border border-violet-200 rounded p-3 text-sm">
            <div class="text-[10px] uppercase tracking-wide font-semibold text-violet-800 mb-1">🎤 Personal invite · limited seating</div>
            <div id="invite-slot-summary" class="text-xs text-slate-700 mb-2"></div>
            <div class="text-xs text-slate-600 mb-1">Which contacts on the path should get a seat? (Pick from the contact path above. Scarcity is the hook — don't overcommit.)</div>
            <div id="invite-contact-list" class="space-y-1 text-xs"></div>
          </div>

          <script>
            (function() {
              const slots = <%- JSON.stringify(eventSlotMap) %>;
              const sel = document.getElementById('event-select');
              const picker = document.getElementById('invite-picker');
              const summary = document.getElementById('invite-slot-summary');
              const list = document.getElementById('invite-contact-list');

              function refresh() {
                const slot = slots[sel.value];
                if (!slot) {
                  picker.classList.add('hidden');
                  list.innerHTML = '';
                  return;
                }
                picker.classList.remove('hidden');
                const bits = [];
                if (slot.speaker) bits.push('<strong>' + slot.speaker + '</strong>');
                if (slot.title) bits.push(slot.title);
                if (slot.session_time) bits.push(slot.session_time);
                if (slot.seat_cap_note) bits.push('<em>' + slot.seat_cap_note + '</em>');
                summary.innerHTML = bits.join(' · ');

                // Build from currently CHECKED contact_path — no double-add;
                // invite can only go to someone the play is threading through.
                const checked = document.querySelectorAll('input[name="contact_path"]:checked');
                if (checked.length === 0) {
                  list.innerHTML = '<div class="text-slate-500 italic">Select one or more contacts in the Contact path above first.</div>';
                  return;
                }
                list.innerHTML = '';
                checked.forEach(function(cp) {
                  const label = cp.parentElement.querySelector('span')?.innerText || cp.value;
                  const id = 'inv-' + cp.value;
                  const row = document.createElement('label');
                  row.className = 'flex items-center gap-2';
                  row.innerHTML = '<input type="checkbox" name="personal_invite_contact_ids" value="' + cp.value + '" id="' + id + '" />' +
                                  '<span>' + label + '</span>';
                  list.appendChild(row);
                });
              }
              sel.addEventListener('change', refresh);
              document.addEventListener('change', function(e) {
                if (e.target && e.target.name === 'contact_path') refresh();
              });
              refresh();
            })();
          </script>
        <% } %>

        <% if (contacts.length > 0) { %>
          <div class="text-sm">
            <div class="font-medium text-slate-800 mb-1">Contact path <span class="text-slate-400 font-normal">(order matters — first move lands on the first pick)</span></div>
            <div class="max-h-48 overflow-y-auto border border-slate-200 rounded p-2 space-y-1 bg-white">
              <% contacts.forEach(function(c) { %>
                <label class="flex items-start gap-2 text-xs py-1">
                  <input type="checkbox" name="contact_path" value="<%= c.id %>" class="mt-0.5" />
                  <span>
                    <span class="font-medium"><%= c.name %></span>
                    <span class="text-slate-500"><%= c.title ? '· ' + c.title : '' %></span>
                    <span class="pill <%= (dealRoleMeta[c.deal_role] || dealRoleMeta.unknown).pill %> ml-1">
                      <%= (dealRoleMeta[c.deal_role] || dealRoleMeta.unknown).label %>
                    </span>
                  </span>
                </label>
              <% }); %>
            </div>
          </div>
        <% } %>

        <button type="submit" id="play-build-btn"
                class="bg-slate-900 hover:bg-slate-800 disabled:bg-slate-400 disabled:cursor-wait text-white px-4 py-2 rounded font-medium text-sm inline-flex items-center gap-2">
          <svg id="play-build-spinner" class="hidden animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
          </svg>
          <span id="play-build-label">Build the play →</span>
        </button>
        <p id="play-build-status" class="text-xs text-slate-500">
          Claude expands your instinct into 2–5 sequenced moves. When a champion is on the path,
          the champion carries the ball on internal moves and you carry the artifact that
          equips them. Takes ~10s.
        </p>
      </form>
    </details>

    <script>
      // Sync call to /plays takes ~6-12s (Claude expansion). Without
      // feedback, the page just freezes and the AE assumes it hung.
      // We disable the button, swap to a spinner, and rotate through a
      // short status script so they can see it's still working. Browser
      // submits the form in the background; status messages are purely
      // cosmetic — we don't know which step the server is actually on.
      function startBuildingPlay(form) {
        const btn    = document.getElementById('play-build-btn');
        const spin   = document.getElementById('play-build-spinner');
        const label  = document.getElementById('play-build-label');
        const status = document.getElementById('play-build-status');
        if (!btn || btn.disabled) return false;

        btn.disabled = true;
        spin.classList.remove('hidden');
        label.textContent = 'Building the play…';

        const frames = [
          'Reading your instinct…',
          'Pulling the account context + prior plays…',
          'Resolving the champion on the path…',
          'Sequencing the moves…',
          'Drafting champion-voice artifacts…',
          'Almost there — stitching the narrative…',
        ];
        let i = 0;
        status.textContent = frames[0];
        status.className = 'text-xs text-emerald-700 font-medium';
        const timer = setInterval(() => {
          i = (i + 1) % frames.length;
          status.textContent = frames[i];
        }, 2500);

        // Safety net: if the browser hangs or the request dies without a
        // redirect, clear the interval after 3 minutes so we don't spin
        // forever. The user can refresh to see whatever did persist.
        setTimeout(() => clearInterval(timer), 180000);
        return true;
      }
    </script>

    <!-- Existing plays -->
    <% if (plays.length === 0) { %>
      <div class="p-5 text-sm text-slate-500">No plays yet.</div>
    <% } else { %>
      <ul class="divide-y divide-slate-100">
        <% plays.forEach(function(p) {
          const exp = p.ai_expansion || {};
          const statusM = playStatusMeta[p.status] || playStatusMeta.drafting;
        %>
          <li id="play-<%= p.id %>" class="p-4">
            <div class="flex items-start justify-between gap-3 mb-2">
              <div>
                <div class="text-sm font-semibold text-slate-900"><%= exp.named_play || '(no expansion yet)' %></div>
                <div class="text-xs text-slate-500 mt-0.5">
                  <% if (p.hypothesis_use_case) { %>
                    <%= useCaseLabel[p.hypothesis_use_case] || p.hypothesis_use_case %> ·
                  <% } %>
                  by <%= p.author_name || 'unknown' %> · <%= new Date(p.created_at).toLocaleDateString() %>
                  <% if (p.event_name) { %>
                    · <a href="/events/<%= p.event_id %>" class="inline-flex items-center gap-1 text-violet-700 hover:text-violet-900">🎯 <%= p.event_name %></a>
                  <% } %>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <% if (exp.named_play) { %>
                  <a href="/plays/<%= p.id %>/export.pptx"
                     class="text-xs inline-flex items-center gap-1 border border-slate-300 hover:border-emerald-500 hover:text-emerald-700 text-slate-700 px-2 py-1 rounded font-medium"
                     title="Download as .pptx — opens in Google Slides via File → Open → Upload">
                    📊 Export to Slides
                  </a>
                <% } %>
                <span class="pill <%= statusM.cls %>"><%= statusM.label %></span>
              </div>
            </div>

            <div class="bg-slate-50 border-l-2 border-slate-300 px-3 py-2 text-sm text-slate-700 mb-3">
              <span class="text-xs text-slate-500 uppercase tracking-wide font-semibold">Your instinct</span><br/>
              <%= p.instinct %>
            </div>

            <% if (exp.moves && exp.moves.length > 0) { %>
              <ol class="space-y-3 mb-3">
                <% exp.moves.forEach(function(m) {
                  const am = actorMeta[m.actor_type] || actorMeta.ae;
                  const hasArtifact = m.artifact && m.artifact.content && String(m.artifact.content).trim();
                %>
                  <li class="text-sm flex gap-3">
                    <span class="shrink-0 w-6 h-6 rounded-full bg-slate-900 text-white text-xs flex items-center justify-center font-semibold"><%= m.step %></span>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="inline-flex items-center text-[10px] font-semibold uppercase tracking-wide border rounded px-1.5 py-0.5 <%= am.cls %>"><%= am.label %></span>
                        <span class="font-medium text-slate-900"><%= m.actor %></span>
                        <span class="text-xs text-slate-500">· <%= m.channel %> · day <%= m.days_from_now %></span>
                      </div>
                      <div class="text-slate-700 mt-1"><%= m.ask %></div>
                      <% if (m.rationale) { %><div class="text-xs text-slate-500 italic mt-0.5"><%= m.rationale %></div><% } %>
                      <% if (hasArtifact) { %>
                        <%
                          const artifactId = 'artifact-' + p.id + '-' + m.step;
                          const artifactTypeLabel = {
                            slack_forward: 'Slack forward',
                            exec_talking_points: 'Exec talking points',
                            one_pager: 'One-pager',
                            question_to_raise: 'Question to raise',
                            meeting_pre_read: 'Meeting pre-read',
                          }[m.artifact.type] || 'Artifact';
                          const forChampion = m.artifact.for_actor === 'champion';
                        %>
                        <details class="mt-2 bg-emerald-50/50 border border-emerald-200 rounded">
                          <summary class="cursor-pointer px-3 py-2 text-xs font-semibold text-emerald-900 flex items-center justify-between gap-2">
                            <span>📋 <%= artifactTypeLabel %><% if (forChampion) { %> — for the champion to paste<% } else { %> — for you<% } %></span>
                            <span class="text-emerald-600 font-normal">open</span>
                          </summary>
                          <div class="px-3 pb-3">
                            <pre id="<%= artifactId %>" class="whitespace-pre-wrap text-xs text-slate-800 bg-white border border-emerald-200 rounded p-2 font-sans"><%= m.artifact.content %></pre>
                            <button type="button" class="mt-2 text-xs bg-emerald-600 hover:bg-emerald-700 text-white px-2 py-1 rounded"
                                    onclick="(function(btn){var el=document.getElementById('<%= artifactId %>');navigator.clipboard.writeText(el.innerText).then(function(){var o=btn.textContent;btn.textContent='Copied ✓';setTimeout(function(){btn.textContent=o;},1500);});})(this)">
                              Copy to clipboard
                            </button>
                          </div>
                        </details>
                      <% } %>
                    </div>
                  </li>
                <% }); %>
              </ol>

              <% if (exp.stakeholder_narratives && Object.keys(exp.stakeholder_narratives).length > 0) { %>
                <div class="mb-3 border border-slate-200 rounded p-3 bg-white">
                  <div class="uppercase tracking-wide text-[10px] text-slate-500 font-semibold mb-2">Stakeholder narratives <span class="font-normal normal-case">— what each person needs to believe (in champion voice)</span></div>
                  <ul class="space-y-1.5 text-xs">
                    <% Object.keys(exp.stakeholder_narratives).forEach(function(name) { %>
                      <li><span class="font-semibold text-slate-900"><%= name %>:</span> <span class="text-slate-700"><%= exp.stakeholder_narratives[name] %></span></li>
                    <% }); %>
                  </ul>
                </div>
              <% } %>
            <% } else { %>
              <div class="bg-amber-50 border border-amber-200 rounded p-3 text-xs text-amber-900 mb-3">
                Expansion missing — Claude may have failed to parse.
                <form method="POST" action="/plays/<%= p.id %>/rebuild" class="inline">
                  <button class="underline hover:no-underline ml-1">Rebuild</button>
                </form>
              </div>
            <% } %>

            <% if (exp.internal_ask) { %>
              <div class="text-xs mb-2">
                <span class="uppercase tracking-wide text-slate-500 font-semibold">Internal ask</span>
                <span class="text-slate-700">· <%= exp.internal_ask %></span>
              </div>
            <% } %>

            <% if (exp.risks && exp.risks.length > 0) { %>
              <div class="text-xs mb-2">
                <span class="uppercase tracking-wide text-slate-500 font-semibold">Risks</span>
                <ul class="text-slate-700 list-disc list-inside mt-0.5">
                  <% exp.risks.forEach(function(r) { %><li><%= r %></li><% }); %>
                </ul>
              </div>
            <% } %>

            <% if (exp.positioning_hooks && exp.positioning_hooks.length > 0) { %>
              <div class="text-xs mb-2 flex items-center gap-1 flex-wrap">
                <span class="uppercase tracking-wide text-slate-500 font-semibold">Positioning:</span>
                <% exp.positioning_hooks.forEach(function(h) { %><span class="pill bg-slate-100 text-slate-700"><%= h %></span><% }); %>
              </div>
            <% } %>

            <!-- Status / next action editor -->
            <details class="mt-3">
              <summary class="text-xs text-slate-500 hover:text-slate-900 cursor-pointer">Update status / next action</summary>
              <form method="POST" action="/plays/<%= p.id %>" class="mt-2 space-y-2 text-xs">
                <div class="grid grid-cols-3 gap-2">
                  <select name="status" class="border border-slate-300 rounded px-2 py-1">
                    <% Object.keys(playStatusMeta).forEach(function(k) { %>
                      <option value="<%= k %>" <%= p.status === k ? 'selected' : '' %>><%= playStatusMeta[k].label %></option>
                    <% }); %>
                  </select>
                  <input name="next_action" value="<%= p.next_action || '' %>" placeholder="next action" class="border border-slate-300 rounded px-2 py-1 col-span-2" />
                </div>
                <div class="flex items-center gap-2">
                  <input type="date" name="next_action_due" value="<%= p.next_action_due ? new Date(p.next_action_due).toISOString().slice(0,10) : '' %>" class="border border-slate-300 rounded px-2 py-1" />
                  <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-3 py-1 rounded font-medium">Save</button>
                  <button type="submit" formaction="/plays/<%= p.id %>/rebuild" class="text-slate-600 hover:text-slate-900 underline">Rebuild expansion</button>
                  <button type="submit" formaction="/plays/<%= p.id %>/delete" class="text-red-600 hover:text-red-800 underline">Delete</button>
                </div>
              </form>
            </details>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>

</div>
