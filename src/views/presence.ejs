<%
  // Derive banner state. The route updates presence_refresh_jobs; we render
  // a matching status strip so the user knows a refresh is in flight and
  // doesn't keep mashing the button.
  const job = typeof activePresenceJob !== 'undefined' ? activePresenceJob : null;
  const jobRunning = job && job.status === 'running';
  const jobCompleted = job && job.status === 'completed';
  const jobFailed = job && job.status === 'failed';
  let elapsedSec = 0;
  if (job) {
    elapsedSec = Math.floor((Date.now() - new Date(job.started_at).getTime()) / 1000);
  }
%>

<div class="mb-6 flex items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Presence</h1>
    <p class="text-sm text-slate-500 mt-1">
      Fresh posts from your Sales Navigator Lead Lists, ranked and drafted.
      Review each draft, then click <strong>Open post</strong> — the comment
      is copied to your clipboard, ready to paste on LinkedIn.
    </p>
    <p class="text-xs text-slate-500 mt-2">
      <strong><%= stats.last24h_count %></strong> posts ingested in the last 24h ·
      <strong><%= stats.drafted_count %></strong> drafted ·
      <strong><%= stats.posted_count %></strong> posted ·
      <strong><%= stats.skipped_count %></strong> skipped
    </p>
  </div>
  <form method="POST" action="/presence/refresh">
    <button
      type="submit"
      <% if (jobRunning) { %>disabled<% } %>
      class="<%= jobRunning ? 'bg-slate-400 cursor-not-allowed' : 'bg-slate-900 hover:bg-slate-800' %> text-white px-5 py-2 rounded text-sm font-medium"
      title="Check inbox for new Sales Nav digests and rank+draft">
      <%= jobRunning ? 'Refreshing…' : 'Refresh now' %>
    </button>
  </form>
</div>

<% if (jobRunning) { %>
  <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-lg px-4 py-3 flex items-center gap-3">
    <span class="inline-block w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
    <div class="flex-1 text-sm">
      <strong>Refreshing…</strong>
      Checking inbox, scoring posts, drafting top comments
      (<%= elapsedSec %>s elapsed). Usually 15–45s.
    </div>
    <span class="text-xs text-emerald-700">auto-reloading</span>
  </div>
  <script>setTimeout(function() { location.reload(); }, 5000);</script>
<% } else if (jobCompleted) { %>
  <div class="mb-6 bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-4 py-3 flex items-center gap-3">
    <span class="text-emerald-600">✓</span>
    <div class="flex-1 text-sm">
      <strong>Refreshed.</strong>
      <%= job.emails_seen %> email<%= job.emails_seen === 1 ? '' : 's' %> processed ·
      <%= job.posts_new %> new post<%= job.posts_new === 1 ? '' : 's' %> ingested ·
      <%= job.drafted %> drafted<% if (job.skipped) { %> · <%= job.skipped %> skipped<% } %><% if (job.errored) { %> · <span class="text-red-700"><%= job.errored %> errored</span><% } %>.
    </div>
  </div>
<% } else if (jobFailed) { %>
  <div class="mb-6 bg-red-50 border border-red-200 text-red-900 rounded-lg px-4 py-3 text-sm">
    <strong>Refresh failed.</strong>
    <% if (job.error) { %><span class="text-red-800"><%= job.error %></span><% } %>
    Check Railway logs for the full stack trace, or click Refresh now to retry.
  </div>
<% } %>

<% if (!feed || feed.length === 0) { %>
  <div class="bg-white border border-slate-200 rounded-lg p-8 text-center text-slate-500">
    <p class="text-sm">No drafted posts yet.</p>
    <p class="text-xs mt-2">
      Once Sales Nav sends a daily digest and the poller runs, the top ~10
      posts will show up here with draft comments. Click <strong>Refresh now</strong>
      to pull from the inbox manually.
    </p>
  </div>
<% } else { %>
  <div class="space-y-4">
    <% feed.forEach(function(p) { %>
      <div class="bg-white border border-slate-200 rounded-lg p-4" id="p-<%= p.id %>">
        <div class="flex items-start justify-between gap-4 mb-2">
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2 flex-wrap">
              <strong class="text-slate-900"><%= p.author_name %></strong>
              <% if (p.author_title) { %>
                <span class="text-xs text-slate-500"><%= p.author_title %><% if (p.author_company) { %> @ <%= p.author_company %><% } %></span>
              <% } else if (p.author_company) { %>
                <span class="text-xs text-slate-500">@ <%= p.author_company %></span>
              <% } %>
              <span class="pill bg-slate-100 text-slate-600"><%= p.post_type %></span>
              <% if (p.rank_score) { %>
                <span class="pill bg-emerald-50 text-emerald-700">score <%= p.rank_score %></span>
              <% } %>
            </div>
            <% if (p.post_snippet) { %>
              <p class="text-sm text-slate-700 mt-2 leading-relaxed"><%= p.post_snippet %></p>
            <% } else { %>
              <p class="text-xs text-slate-400 italic mt-2">(digest didn't include post text — open on LinkedIn for full context)</p>
            <% } %>
          </div>
          <span class="text-xs text-slate-400 whitespace-nowrap">
            <%= new Date(p.received_at).toLocaleString() %>
          </span>
        </div>

        <div class="mt-3 bg-slate-50 border border-slate-200 rounded p-3">
          <div class="text-xs uppercase tracking-wider text-slate-500 mb-1">Draft comment</div>
          <p class="text-sm text-slate-800 leading-relaxed" data-draft-for="<%= p.id %>"><%= p.draft_comment %></p>
        </div>

        <div class="mt-3 flex items-center gap-2 flex-wrap">
          <%
            // Primary path: Sales Nav profile — at least lands on the lead so
            // the operator can scroll Activity if the post is there.
            // Secondary path: Google site:linkedin.com search — Google
            // indexes public LinkedIn posts + comment threads, and the first
            // hit almost always resolves to the actual post URL. This is our
            // most reliable "find the post" escape hatch when Sales Nav
            // Activity doesn't surface it.
            const profileUrl = (p.raw_meta && p.raw_meta.click_url) || p.post_url;
            let googleUrl = null;
            if (p.post_snippet) {
              const cleaned = p.post_snippet.replace(/[…]+$/g, '').replace(/\.{3,}$/g, '').trim();
              const words = cleaned.split(/\s+/).slice(0, 8).join(' ');
              if (words) {
                const q = 'site:linkedin.com "' + words + '" ' + (p.author_name || '');
                googleUrl = 'https://www.google.com/search?q=' + encodeURIComponent(q.trim());
              }
            }
          %>
          <button
            type="button"
            class="open-post bg-slate-900 hover:bg-slate-800 text-white px-4 py-1.5 rounded text-sm"
            data-post-id="<%= p.id %>"
            data-post-url="<%= profileUrl %>">
            Open profile (copy draft)
          </button>
          <% if (googleUrl) { %>
            <a
              href="<%= googleUrl %>"
              target="_blank"
              rel="noopener"
              class="text-xs text-slate-500 hover:text-slate-800 underline"
              title="Google site:linkedin.com search for this snippet — finds the actual post or comment thread when Sales Nav Activity doesn't surface it.">
              Find on Google ↗
            </a>
          <% } %>
          <form method="POST" action="/presence/<%= p.id %>/posted" class="inline">
            <button type="submit" class="text-xs text-emerald-700 hover:text-emerald-900 underline">Mark posted</button>
          </form>
          <form method="POST" action="/presence/<%= p.id %>/skip" class="inline">
            <button type="submit" class="text-xs text-slate-500 hover:text-slate-800 underline">Skip</button>
          </form>
          <span class="flex-1"></span>
          <form method="POST" action="/presence/<%= p.id %>/thumbs" class="inline">
            <input type="hidden" name="thumbs" value="up" />
            <button type="submit" class="text-sm <%= p.thumbs === 'up' ? 'text-emerald-600 font-semibold' : 'text-slate-400 hover:text-emerald-600' %>" title="Draft quality: good">👍</button>
          </form>
          <form method="POST" action="/presence/<%= p.id %>/thumbs" class="inline">
            <input type="hidden" name="thumbs" value="down" />
            <button type="submit" class="text-sm <%= p.thumbs === 'down' ? 'text-red-600 font-semibold' : 'text-slate-400 hover:text-red-600' %>" title="Draft quality: bad">👎</button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<script>
  document.querySelectorAll('.open-post').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const id = btn.dataset.postId;
      const url = btn.dataset.postUrl;
      const draftEl = document.querySelector('[data-draft-for="' + id + '"]');
      const draft = draftEl ? draftEl.textContent.trim() : '';
      try {
        if (navigator.clipboard && draft) await navigator.clipboard.writeText(draft);
      } catch (e) {
        console.warn('clipboard write failed:', e);
      }
      window.open(url, '_blank', 'noopener');
    });
  });
</script>
