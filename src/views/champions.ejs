<%
  function pill(color, text) {
    const cls = {
      emerald: 'bg-emerald-100 text-emerald-800',
      amber:   'bg-amber-100 text-amber-800',
      slate:   'bg-slate-100 text-slate-700',
      red:     'bg-red-100 text-red-800',
      sky:     'bg-sky-100 text-sky-800',
      violet:  'bg-violet-100 text-violet-800',
    }[color] || 'bg-slate-100 text-slate-700';
    return `<span class="pill ${cls}">${text}</span>`;
  }
  const sourceLabel = {
    customer_champion: 'Customer champion',
    foa: 'Friend of Ambition',
    churned_customer_contact: 'Ex-customer contact',
  };
  const sourceColor = {
    customer_champion: 'emerald',
    foa: 'violet',
    churned_customer_contact: 'amber',
  };
  const routingLabel = {
    warm_outbound: 'Warm outbound',
    winback: 'Win-back',
    internal_customer: 'Internal note',
    skip: 'Skip',
  };
%>

<div class="mb-6 flex items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Champions</h1>
    <p class="text-sm text-slate-500 mt-1 max-w-2xl">
      Track champions across companies. When they move to a new employer,
      you get a warm-intro draft. Seed the list from HubSpot or Salesforce —
      customer champions, Friends of Ambition, and ex-customer contacts all go here.
    </p>
  </div>
  <form method="POST" action="/champions/check-now" class="inline">
    <button type="submit"
      <%= runningJob ? 'disabled' : '' %>
      class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed">
      <%= runningJob ? 'Checking…' : 'Check for moves now' %>
    </button>
  </form>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Tracking</div>
    <div class="text-2xl font-semibold mt-1"><%= counts.tracking %></div>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">New moves</div>
    <div class="text-2xl font-semibold mt-1 <%= counts.newMoves > 0 ? 'text-amber-600' : '' %>"><%= counts.newMoves %></div>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Drafted reconnects</div>
    <div class="text-2xl font-semibold mt-1"><%= counts.drafted %></div>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="text-xs uppercase tracking-wide text-slate-500">Last check</div>
    <div class="text-sm mt-2 text-slate-700">
      <%= counts.lastCheckLabel %>
    </div>
  </div>
</div>

<% if (pendingMoves && pendingMoves.length > 0) { %>
  <div class="bg-white border border-amber-200 rounded-lg mb-8 overflow-hidden">
    <div class="px-4 py-3 bg-amber-50 border-b border-amber-200 flex items-center justify-between">
      <h2 class="font-semibold text-amber-900">Pending moves — warm-intro opportunities</h2>
      <span class="text-xs text-amber-800"><%= pendingMoves.filter(function(m){return m.status === 'new';}).length %> new</span>
    </div>
    <table class="w-full text-sm">
      <thead class="text-slate-500 uppercase tracking-wider text-xs bg-slate-50">
        <tr>
          <th class="text-left px-4 py-2">Champion</th>
          <th class="text-left px-4 py-2">From → To</th>
          <th class="text-left px-4 py-2">Play</th>
          <th class="text-left px-4 py-2">Source</th>
          <th class="text-right px-4 py-2">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% pendingMoves.forEach(function(m) { %>
          <tr>
            <td class="px-4 py-3">
              <div class="font-medium"><%= m.full_name %></div>
              <div class="text-xs text-slate-500"><%- sourceLabel[m.source] || m.source %><% if (m.tier) { %> · <%= m.tier %><% } %></div>
            </td>
            <td class="px-4 py-3">
              <div class="text-slate-600 text-xs"><%= m.from_company || '—' %></div>
              <div class="font-medium">→ <%= m.to_company %><% if (m.to_title) { %> <span class="text-slate-500 font-normal">· <%= m.to_title %></span><% } %></div>
            </td>
            <td class="px-4 py-3">
              <% if (m.routing === 'warm_outbound') { %><%- pill('emerald', 'Warm outbound') %><% } %>
              <% if (m.routing === 'winback') { %><%- pill('violet', 'Win-back') %><% } %>
              <% if (m.routing === 'internal_customer') { %><%- pill('sky', 'Internal') %><% } %>
              <% if (m.routing === 'skip') { %><%- pill('slate', 'Skip') %><% } %>
              <% if (m.status === 'drafted') { %>
                <span class="ml-1"><%- pill('slate', 'Drafted') %></span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-xs">
              <% if (m.source_url) { %>
                <a href="<%= m.source_url %>" target="_blank" rel="noopener" class="text-slate-500 hover:text-slate-900 underline truncate inline-block max-w-xs"><%= m.source_url.replace(/^https?:\/\//, '').slice(0, 48) %></a>
              <% } else { %><span class="text-slate-400">—</span><% } %>
            </td>
            <td class="px-4 py-3 text-right">
              <% if (m.status === 'new' && (m.routing === 'warm_outbound' || m.routing === 'winback')) { %>
                <form method="POST" action="/champions/moves/<%= m.id %>/draft" class="inline">
                  <button class="text-emerald-700 hover:text-emerald-900 font-medium text-sm underline">Draft reconnect</button>
                </form>
              <% } %>
              <% if (m.status === 'drafted') { %>
                <a href="/drafts" class="text-slate-600 hover:text-slate-900 text-sm underline">View draft →</a>
              <% } %>
              <form method="POST" action="/champions/moves/<%= m.id %>/dismiss" class="inline ml-2">
                <button class="text-slate-400 hover:text-slate-700 text-sm">Dismiss</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="bg-white border border-slate-200 rounded-lg mb-8">
  <div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between">
    <h2 class="font-semibold">Add champions (paste CSV)</h2>
    <span class="text-xs text-slate-500">Headers: full_name, linkedin_url, current_company, current_title, email, associated_account_domain, source, tier, one_line_context, relationship_owner</span>
  </div>
  <form method="POST" action="/champions/import" class="p-4">
    <textarea name="csv" rows="8" placeholder="full_name,linkedin_url,current_company,current_title,email,associated_account_domain,source,tier,one_line_context,relationship_owner&#10;Jane Smith,https://linkedin.com/in/janesmith,Acme Logistics,VP RevOps,jane@acme.com,acme.com,customer_champion,hot,Sponsored the 2024 rollout,kai"
      class="w-full border border-slate-300 rounded px-3 py-2 text-sm font-mono focus:ring-1 focus:ring-slate-500 focus:outline-none"></textarea>
    <div class="flex items-center justify-between mt-3">
      <span class="text-xs text-slate-500">Tab- or comma-separated. Headers are case-insensitive. Dedups by linkedin_url or email.</span>
      <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded text-sm font-medium">Import</button>
    </div>
  </form>
  <% if (importResults && importResults.length > 0) { %>
    <div class="px-4 pb-4">
      <div class="text-xs font-semibold text-slate-700 uppercase tracking-wide mb-2">Last import</div>
      <ul class="text-xs space-y-1">
        <% importResults.slice(0, 20).forEach(function(r) { %>
          <li class="<%= r.ok ? 'text-slate-600' : 'text-red-700' %>">
            row <%= r.index + 1 %>:
            <% if (r.ok) { %>
              <%= r.inserted ? 'added' : 'updated' %> — <%= r.name %><% if (r.company) { %> (<%= r.company %>)<% } %>
            <% } else { %>
              error — <%= (r.errors || []).join('; ') %>
            <% } %>
          </li>
        <% }); %>
        <% if (importResults.length > 20) { %>
          <li class="text-slate-400">…and <%= importResults.length - 20 %> more rows</li>
        <% } %>
      </ul>
    </div>
  <% } %>
</div>

<div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
  <div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between">
    <h2 class="font-semibold">Tracked champions <span class="text-slate-400 font-normal">(<%= champions.length %>)</span></h2>
  </div>
  <% if (champions.length === 0) { %>
    <div class="p-6 text-sm text-slate-500">
      No champions yet. Paste a CSV above to start tracking.
    </div>
  <% } else { %>
    <table class="w-full text-sm">
      <thead class="text-slate-500 uppercase tracking-wider text-xs bg-slate-50">
        <tr>
          <th class="text-left px-4 py-2">Name</th>
          <th class="text-left px-4 py-2">Company · title</th>
          <th class="text-left px-4 py-2">Source</th>
          <th class="text-left px-4 py-2">From account</th>
          <th class="text-left px-4 py-2">Status</th>
          <th class="text-right px-4 py-2">Last checked</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% champions.forEach(function(c) { %>
          <tr class="<%= c.status === 'moved' ? 'bg-amber-50/40' : '' %>">
            <td class="px-4 py-3">
              <div class="font-medium">
                <% if (c.linkedin_url) { %>
                  <a href="<%= c.linkedin_url %>" target="_blank" rel="noopener" class="hover:underline"><%= c.full_name %></a>
                <% } else { %>
                  <%= c.full_name %>
                <% } %>
              </div>
              <% if (c.email) { %><div class="text-xs text-slate-500"><%= c.email %></div><% } %>
            </td>
            <td class="px-4 py-3">
              <div><%= c.current_company || '—' %></div>
              <% if (c.current_title) { %><div class="text-xs text-slate-500"><%= c.current_title %></div><% } %>
            </td>
            <td class="px-4 py-3">
              <%- pill(sourceColor[c.source] || 'slate', sourceLabel[c.source] || c.source) %>
              <% if (c.tier) { %><span class="ml-1 text-xs text-slate-500"><%= c.tier %></span><% } %>
            </td>
            <td class="px-4 py-3 text-xs text-slate-600"><%= c.associated_account_domain || '—' %></td>
            <td class="px-4 py-3">
              <% if (c.status === 'moved') { %><%- pill('amber', 'Moved · action needed') %><% } %>
              <% if (c.status === 'tracking') { %><%- pill('emerald', 'Tracking') %><% } %>
              <% if (c.status === 'acted') { %><%- pill('slate', 'Acted') %><% } %>
              <% if (c.status === 'dormant') { %><%- pill('slate', 'Dormant') %><% } %>
              <% if (c.pending_moves > 0 && c.status !== 'moved') { %>
                <span class="ml-1"><%- pill('amber', c.pending_moves + ' pending') %></span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-right text-xs text-slate-500">
              <% if (c.last_checked_at) { %>
                <%= new Date(c.last_checked_at).toLocaleDateString() %>
              <% } else { %>
                never
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
