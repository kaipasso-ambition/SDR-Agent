<%
  const priorityColor = {
    hot:  'bg-red-50 text-red-700 ring-1 ring-red-200',
    warm: 'bg-amber-50 text-amber-700 ring-1 ring-amber-200',
    cool: 'bg-slate-50 text-slate-500',
  };
  const statusColor = {
    customer: 'bg-teal-50 text-teal-700',
    prospect: 'bg-sky-50 text-sky-700',
    churned:  'bg-slate-100 text-slate-500',
  };

  function agoLabel(d) {
    if (!d) return '';
    const ms = Date.now() - new Date(d).getTime();
    if (ms < 0) return '';
    const n = Math.floor(ms / 86400000);
    if (n === 0) return 'today';
    if (n === 1) return 'yesterday';
    if (n < 7) return n + 'd ago';
    if (n < 60) return Math.floor(n / 7) + 'w ago';
    return Math.floor(n / 30) + 'mo ago';
  }

  const anyRunning = accounts.some(function(a) {
    return a.prospect_scan_status === 'running' || a.pov_status === 'running';
  });

  function qs(overrides) {
    const base = { sort: sort, status: statusFilter || '', quiet: includeQuiet ? '1' : '', depri: includeDeprioritized ? '1' : '' };
    const merged = Object.assign({}, base, overrides || {});
    const params = Object.keys(merged)
      .filter(function(k) { return merged[k] !== '' && merged[k] != null; })
      .map(function(k) { return encodeURIComponent(k) + '=' + encodeURIComponent(merged[k]); })
      .join('&');
    return params ? ('/brief?' + params) : '/brief';
  }
%>

<div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
  <div>
    <h1 class="text-2xl font-semibold">Today</h1>
    <p class="text-sm text-slate-500 mt-1">Triage your book. Decide which accounts need your attention this week.</p>
  </div>
  <div class="flex items-center gap-2">
    <form method="POST" action="/signals/purge-stale" class="shrink-0"
          onsubmit="return confirm('Dismiss every active signal older than 60 days or with no event date?');">
      <button type="submit" class="text-xs text-slate-500 hover:text-red-700 underline px-2">Purge stale</button>
    </form>
    <form method="POST" action="/signals/scan" class="shrink-0"
          onsubmit="return confirm('Scan all <%= totalAccounts %> accounts? ~$0.10 each. Estimated: ~$<%= (totalAccounts * 0.12).toFixed(2) %>.');">
      <button type="submit"
              class="text-sm bg-navy-700 hover:bg-navy-800 text-white px-4 py-2 rounded font-medium disabled:bg-slate-400 disabled:cursor-wait"
              <% if (runningJob) { %>disabled<% } %>>
        <% if (runningJob) { %>Scanning…<% } else { %>Scan all accounts<% } %>
      </button>
    </form>
  </div>
</div>

<% if (typeof purgedCount !== 'undefined' && purgedCount !== null) { %>
  <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 mb-5 text-sm text-slate-700">
    Purged <%= purgedCount %> stale signal<%= purgedCount === 1 ? '' : 's' %>.
  </div>
<% } %>

<% if (runningJob) { %>
  <div class="bg-teal-50 border border-teal-200 rounded-lg p-3 mb-5 flex items-center gap-3">
    <span class="inline-block w-2 h-2 bg-teal-500 rounded-full animate-pulse"></span>
    <div class="flex-1 text-sm text-teal-800">
      Scanning — <%= activeJob.accounts_scanned || 0 %> scanned, <%= activeJob.signals_detected || 0 %> new.
    </div>
  </div>
  <script>setTimeout(function(){ location.reload(); }, 15000);</script>
<% } else if (activeJob && activeJob.status === 'failed') { %>
  <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 mb-5">
    <div class="flex items-center gap-2 text-sm text-red-700 font-medium">
      Scan failed<% if (activeJob.errors) { %> — <%= activeJob.errors %> error<%= activeJob.errors === 1 ? '' : 's' %><% } %>
    </div>
    <% if (activeJob.error) { %>
      <p class="text-xs text-slate-500 mt-1"><%= activeJob.error.includes('usage limit') || activeJob.error.includes('rate_limit') ? 'API spend limit reached.' : activeJob.error %></p>
    <% } %>
    <form method="POST" action="/signals/scan" class="mt-2">
      <button type="submit" class="text-xs bg-navy-700 hover:bg-navy-800 text-white px-3 py-1 rounded">Retry</button>
    </form>
  </div>
<% } else if (anyRunning) { %>
  <script>setTimeout(function(){ location.reload(); }, 8000);</script>
<% } %>

<div class="mb-4 flex items-center gap-3 text-xs flex-wrap">
  <div class="flex items-center gap-1">
    <% ['', 'customer', 'prospect', 'churned'].forEach(function(s) {
      const active = (statusFilter || '') === s;
      const label = s === '' ? 'All' : s.charAt(0).toUpperCase() + s.slice(1);
    %>
      <a href="<%= qs({status: s}) %>"
         class="px-2.5 py-1 rounded border <%= active ? 'bg-navy-700 text-white border-navy-700' : 'bg-white border-slate-300 text-slate-700 hover:border-slate-500' %>">
        <%= label %>
      </a>
    <% }); %>
  </div>

  <span class="text-slate-300">·</span>

  <div class="flex items-center gap-1">
    <a href="<%= qs({sort: 'priority'}) %>"
       class="px-2.5 py-1 rounded border <%= sort === 'priority' ? 'bg-navy-700 text-white border-navy-700' : 'bg-white border-slate-300 text-slate-700 hover:border-slate-500' %>">
      Priority
    </a>
    <a href="<%= qs({sort: 'newest'}) %>"
       class="px-2.5 py-1 rounded border <%= sort === 'newest' ? 'bg-navy-700 text-white border-navy-700' : 'bg-white border-slate-300 text-slate-700 hover:border-slate-500' %>">
      Newest
    </a>
  </div>

  <span class="text-slate-300">·</span>

  <span class="text-slate-400"><%= accounts.length %> of <%= totalAccounts %></span>

  <% if (!includeQuiet && accounts.length < totalAccounts) { %>
    <a href="<%= qs({quiet: '1'}) %>" class="text-slate-500 hover:text-slate-900 underline">Show all</a>
  <% } else if (includeQuiet) { %>
    <a href="<%= qs({quiet: ''}) %>" class="text-slate-500 hover:text-slate-900 underline">Hide quiet</a>
  <% } %>
  <% if (!includeDeprioritized) { %>
    <a href="<%= qs({depri: '1'}) %>" class="text-slate-500 hover:text-slate-900 underline">Show deprioritized</a>
  <% } else { %>
    <a href="<%= qs({depri: ''}) %>" class="text-slate-500 hover:text-slate-900 underline">Hide deprioritized</a>
  <% } %>
</div>

<% if (!accounts || accounts.length === 0) { %>
  <div class="bg-white border border-slate-200 rounded-lg p-8 text-center text-slate-500">
    <% if (statusFilter) { %>
      No <%= statusFilter %> accounts with activity.
      <a href="<%= qs({status: ''}) %>" class="underline">Clear filter</a>
    <% } else { %>
      <div class="text-base text-slate-700 mb-1">No activity yet.</div>
      Click <strong>Scan all accounts</strong> to start.
    <% } %>
  </div>
<% } else { %>
  <div class="space-y-2.5">
    <% accounts.forEach(function(a) {
      const pov = a.pov_result;
      const povRunning = a.pov_status === 'running';
      const hasPov = a.pov_status === 'completed' && pov && (pov.whats_happening || pov.pov);
      const sigCount = Number(a.signal_count) || 0;
      const defCount = Number(a.defense_count) || 0;
      const offCount = Number(a.offense_count) || 0;
      const ucfResult = a.ucf_status === 'completed' && a.ucf_result ? a.ucf_result : null;
      const scanning = a.prospect_scan_status === 'running' || a.pov_status === 'running';
      const psResult = a.prospect_scan_result;
      const prospectCount = (psResult && Array.isArray(psResult.prospects))
        ? psResult.prospects.filter(function(p) { return !p.dismissed; }).length : 0;
      const activePlays = Number(a.active_plays) || 0;
      var priDot = '';
      if (hasPov && pov.priority === 'hot') priDot = 'bg-red-500';
      else if (hasPov && pov.priority === 'warm') priDot = 'bg-amber-400';
    %>
      <a href="/accounts/<%= a.account_id %>"
         class="block <%= a.deprioritized ? 'opacity-50' : '' %> bg-white border border-slate-200 rounded-lg hover:shadow-md hover:border-slate-300 transition-all overflow-hidden">

        <%# === HEADER === %>
        <div class="px-5 pt-4 pb-1.5 flex items-center gap-2.5 flex-wrap">
          <div class="flex items-center gap-2">
            <% if (priDot) { %><span class="inline-block w-2 h-2 rounded-full <%= priDot %> shrink-0"></span><% } %>
            <span class="font-semibold text-navy-800"><%= a.account_name %></span>
          </div>
          <span class="pill <%= statusColor[a.account_status] || 'bg-slate-50 text-slate-500' %> text-[10px]"><%= a.account_status %></span>
          <% if (ucfResult && ucfResult.primary) { %>
            <span class="pill bg-navy-50 text-navy-700 text-[10px]"><%= ucfResult.primary.label %></span>
          <% } %>
          <% if (a.watched) { %>
            <span class="pill bg-teal-50 text-teal-700 text-[10px]">watching</span>
          <% } %>
          <span class="ml-auto text-[11px] text-slate-400 shrink-0">
            <% if (sigCount > 0) { %>
              <%= sigCount %> signal<%= sigCount === 1 ? '' : 's' %>
              <% if (defCount > 0) { %><span class="text-red-600 font-medium"><%= defCount %> def</span><% } %>
              ·
            <% } %>
            <%= agoLabel(a.last_activity_at) %>
          </span>
        </div>

        <%# === POV BODY === %>
        <% if (hasPov) { %>
          <div class="px-5 pb-1.5 space-y-1">
            <div class="text-sm text-slate-700 leading-relaxed"><%= pov.whats_happening || pov.pov %></div>
            <% if (pov.where_is_the_opportunity || pov.path_in) { %>
              <div class="text-sm text-teal-700"><span class="font-medium">Opportunity:</span> <%= pov.where_is_the_opportunity || pov.path_in %></div>
            <% } %>
          </div>

          <% if (pov.next_step || pov.strategy || pov.recommended_play) { %>
            <div class="px-5 pb-1.5 mt-0.5 space-y-1">
              <% if (pov.next_step || pov.strategy) { %>
                <div class="text-sm">
                  <span class="font-medium text-navy-400">This week:</span>
                  <span class="text-slate-700"><%= pov.next_step || pov.strategy %></span>
                </div>
              <% } %>
              <% if (pov.recommended_play) { %>
                <div class="text-sm">
                  <span class="font-medium text-navy-400">Recommended play:</span>
                  <span class="text-slate-700"><%= pov.recommended_play %></span>
                </div>
              <% } %>
            </div>
          <% } %>
        <% } else if (povRunning) { %>
          <div class="px-5 pb-1.5 text-xs text-slate-400 flex items-center gap-2">
            <span class="inline-block w-1.5 h-1.5 bg-teal-400 rounded-full animate-pulse"></span> Building POV…
          </div>
        <% } else if (scanning) { %>
          <div class="px-5 pb-1.5 text-xs text-slate-400 flex items-center gap-2">
            <span class="inline-block w-1.5 h-1.5 bg-teal-400 rounded-full animate-pulse"></span> Scanning…
          </div>
        <% } else { %>
          <div class="px-5 pb-1.5 text-sm text-slate-400">Not scanned yet</div>
        <% } %>

        <%# === FOOTER === %>
        <div class="px-5 pb-3.5 pt-1.5 flex items-center gap-4 text-[11px] text-slate-400">
          <% if (prospectCount > 0) { %>
            <span><%= prospectCount %> voice<%= prospectCount === 1 ? '' : 's' %></span>
          <% } %>
          <% if (activePlays > 0) { %>
            <span class="text-teal-600"><%= activePlays %> active play<%= activePlays === 1 ? '' : 's' %></span>
          <% } %>
          <% if (a.notes) { %>
            <span>has notes</span>
          <% } %>
        </div>

      </a>
    <% }); %>
  </div>
<% } %>
