<%
  // Kind meta — three scanner sources, normalized to one card shape.
  // The 'lane' styling reflects the AE's mental model:
  //   blue    = defense (customer signal, risk)
  //   sky     = offense (customer signal, opportunity) / context
  //   emerald = expansion (growth inside current customers)
  //   amber   = revisit (re-entry on lost/churned)
  const riskMeta = {
    defense_risk:         { label: 'Defense risk',        pill: 'bg-red-100 text-red-800',       border: 'border-red-300',     bar: 'bg-red-500' },
    offense_opportunity:  { label: 'Offense opportunity', pill: 'bg-sky-100 text-sky-800',       border: 'border-sky-300',     bar: 'bg-sky-500' },
    neutral:              { label: 'Context',             pill: 'bg-slate-100 text-slate-700',   border: 'border-slate-200',   bar: 'bg-slate-300' },
  };
  const kindMeta = {
    customer_signal: { label: 'Customer',  pill: 'bg-slate-100 text-slate-700',     border: 'border-slate-200',   bar: 'bg-slate-400' },
    expansion:       { label: 'Expansion', pill: 'bg-emerald-100 text-emerald-800', border: 'border-emerald-300', bar: 'bg-emerald-500' },
    revisit:         { label: 'Revisit',   pill: 'bg-amber-100 text-amber-800',     border: 'border-amber-300',   bar: 'bg-amber-500' },
  };
  function cardMeta(item) {
    if (item.kind === 'customer_signal') return riskMeta[item.risk_class] || riskMeta.neutral;
    return kindMeta[item.kind] || kindMeta.customer_signal;
  }
  const tabs = [
    { key: null,              label: 'All',        count: kindTotals.all },
    { key: 'customers',       label: 'Customers',  count: kindTotals.customer_signal },
    { key: 'expansion',       label: 'Expansion',  count: kindTotals.expansion },
    { key: 'revisit',         label: 'Revisit',    count: kindTotals.revisit },
  ];
%>

<div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
  <div>
    <h1 class="text-2xl font-semibold">Today</h1>
    <p class="text-sm text-slate-500 mt-1 max-w-2xl">
      Every signal on your book — customer risk &amp; opportunity, expansion triggers on current customers, revisit moments on lost/churned deals — ranked in one feed.
      Defense outranks offense; expansion slots in with growth; revisit sits beneath. Ties break on severity, then recency.
    </p>
  </div>
  <form method="POST" action="/signals/scan" class="shrink-0">
    <button type="submit"
            class="text-sm bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded font-medium"
            <% if (runningJob) { %>disabled<% } %>>
      <% if (runningJob) { %>Scanning…<% } else { %>Run scan now<% } %>
    </button>
  </form>
</div>

<% if (runningJob) { %>
  <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-4 mb-6 flex items-center gap-3">
    <span class="inline-block w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
    <div class="flex-1 text-sm text-emerald-900">
      Scanning accounts for new signals — <%= activeJob.accounts_scanned || 0 %> scanned, <%= activeJob.signals_detected || 0 %> new.
      Expect ~30-45s per account.
    </div>
  </div>
  <script>setTimeout(function(){ location.reload(); }, 15000);</script>
<% } else if (activeJob && activeJob.status === 'completed' && activeJob.finished_at && (Date.now() - new Date(activeJob.finished_at).getTime() < 120000)) { %>
  <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 mb-6 text-sm text-slate-700">
    ✓ Last customer scan finished — <%= activeJob.accounts_scanned %> account<%= activeJob.accounts_scanned === 1 ? '' : 's' %>,
    <%= activeJob.signals_detected %> new signal<%= activeJob.signals_detected === 1 ? '' : 's' %>,
    <%= activeJob.signals_skipped_dedup %> deduped.
  </div>
<% } %>

<div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
  <div class="bg-white border border-slate-200 rounded-lg p-3">
    <div class="text-xs uppercase tracking-wide text-slate-500">This week</div>
    <div class="text-2xl font-semibold mt-1"><%= counts.this_week %></div>
  </div>
  <div class="bg-white border border-red-200 rounded-lg p-3">
    <div class="text-xs uppercase tracking-wide text-red-700">Defense</div>
    <div class="text-2xl font-semibold mt-1 text-red-700"><%= counts.defense %></div>
  </div>
  <div class="bg-white border border-sky-200 rounded-lg p-3">
    <div class="text-xs uppercase tracking-wide text-sky-700">Offense</div>
    <div class="text-2xl font-semibold mt-1 text-sky-700"><%= counts.offense %></div>
  </div>
  <div class="bg-white border border-emerald-200 rounded-lg p-3">
    <div class="text-xs uppercase tracking-wide text-emerald-700">Expansion</div>
    <div class="text-2xl font-semibold mt-1 text-emerald-700"><%= counts.growth %></div>
  </div>
  <div class="bg-white border border-amber-200 rounded-lg p-3">
    <div class="text-xs uppercase tracking-wide text-amber-700">Revisit</div>
    <div class="text-2xl font-semibold mt-1 text-amber-700"><%= counts.revisit %></div>
  </div>
</div>

<div class="mb-5 flex items-center gap-1 text-xs flex-wrap">
  <% tabs.forEach(function(t) {
      const active = (kindFilter || null) === t.key;
      const href = t.key ? ('/brief?kind=' + t.key) : '/brief';
  %>
    <a href="<%= href %>"
       class="px-3 py-1.5 rounded border <%= active ? 'bg-slate-900 text-white border-slate-900' : 'bg-white border-slate-300 text-slate-700 hover:border-slate-500' %>">
      <%= t.label %>
      <span class="<%= active ? 'text-slate-300' : 'text-slate-400' %> ml-1"><%= t.count %></span>
    </a>
  <% }); %>
</div>

<% if (!items || items.length === 0) { %>
  <div class="bg-white border border-slate-200 rounded-lg p-8 text-sm text-slate-500 text-center">
    <% if (kindFilter) { %>
      <div class="text-base text-slate-700 mb-1">Nothing in this lane right now.</div>
      <a href="/brief" class="underline">Show everything →</a>
    <% } else { %>
      <div class="text-base text-slate-700 mb-1">No signals yet.</div>
      Click <strong>Run scan now</strong> to start a pass over your customer accounts,
      or kick off a scan from <a href="/expand" class="underline">/expand</a> (current customers)
      or <a href="/revisit" class="underline">/revisit</a> (lost / churned).
    <% } %>
  </div>
<% } else { %>
  <ul class="space-y-4">
    <% items.forEach(function(s, idx) {
      const meta = cardMeta(s);
      const km = kindMeta[s.kind] || kindMeta.customer_signal;
      const isCustomerSignal = s.kind === 'customer_signal';
    %>
      <li class="bg-white border-2 <%= meta.border %> rounded-lg overflow-hidden">
        <div class="flex">
          <div class="<%= meta.bar %> w-1 shrink-0"></div>
          <div class="flex-1 p-5">
            <div class="flex items-start justify-between gap-4 mb-2">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="pill <%= km.pill %>"><%= km.label %></span>
                <% if (isCustomerSignal) { %>
                  <span class="pill <%= (riskMeta[s.risk_class] || riskMeta.neutral).pill %>">
                    <%= (riskMeta[s.risk_class] || riskMeta.neutral).label %>
                  </span>
                <% } %>
                <span class="pill bg-slate-100 text-slate-700">SEV <%= s.severity %></span>
                <span class="text-xs text-slate-500">·
                  <a href="/accounts/<%= s.account_id %>" class="font-medium text-slate-700 hover:underline"><%= s.account_name %></a>
                </span>
                <% if (s.account_industry) { %>
                  <span class="text-xs text-slate-400">· <%= s.account_industry %></span>
                <% } %>
                <span class="text-xs text-slate-400">· <%= new Date(s.detected_at).toLocaleDateString() %></span>
              </div>
              <span class="text-xs text-slate-400">#<%= idx + 1 %></span>
            </div>

            <div class="text-base font-semibold text-slate-900 mb-1"><%= s.title %></div>
            <% if (s.summary) { %>
              <div class="text-sm text-slate-600 mb-3"><%= s.summary %></div>
            <% } %>

            <% if (s.so_what) { %>
              <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mt-3 mb-1">So what</div>
              <div class="text-sm text-slate-800"><%= s.so_what %></div>
            <% } %>

            <% if (s.recommended_move) { %>
              <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mt-3 mb-1">Recommended move</div>
              <div class="text-sm text-slate-800"><%= s.recommended_move %></div>
            <% } %>

            <div class="flex items-center justify-between gap-3 mt-4 flex-wrap">
              <div class="flex items-center gap-3 text-xs">
                <% if (s.source_url) { %>
                  <a href="<%= s.source_url %>" target="_blank" rel="noopener"
                     class="text-slate-600 hover:text-slate-900 underline truncate max-w-xs inline-block align-middle">
                    Source ↗
                  </a>
                <% } %>
              </div>
              <div class="flex items-center gap-2">
                <form method="POST" action="<%= s.play_action %>" class="inline"
                      onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='Building play…';">
                  <% if (isCustomerSignal) { %>
                    <input type="hidden" name="action" value="build_play" />
                  <% } %>
                  <button type="submit" class="text-xs bg-slate-900 hover:bg-slate-800 disabled:bg-slate-500 disabled:cursor-wait text-white px-3 py-1.5 rounded font-medium">
                    Build a play →
                  </button>
                </form>
                <% if (isCustomerSignal) { %>
                  <form method="POST" action="/signals/<%= s.id %>/ack" class="inline">
                    <button type="submit" class="text-xs border border-slate-300 text-slate-700 hover:bg-slate-50 px-3 py-1.5 rounded font-medium">
                      Acknowledge
                    </button>
                  </form>
                  <form method="POST" action="/signals/<%= s.id %>/dismiss" class="inline">
                    <button type="submit" class="text-xs text-slate-500 hover:text-slate-900 px-3 py-1.5 rounded">
                      Dismiss
                    </button>
                  </form>
                <% } else if (s.kind === 'expansion') { %>
                  <a href="/expand/<%= s.account_id %>" class="text-xs text-slate-500 hover:text-slate-900 px-3 py-1.5 rounded">
                    Open dossier →
                  </a>
                <% } else if (s.kind === 'revisit') { %>
                  <%
                    // play_action is /revisit/<opportunity_id>/triggers/<idx>/play
                    // opportunity_id is the 2nd path segment after /revisit/
                    const parts = (s.play_action || '').split('/');
                    const oppId = parts[2] || '';
                  %>
                  <a href="/revisit/<%= encodeURIComponent(oppId) %>" class="text-xs text-slate-500 hover:text-slate-900 px-3 py-1.5 rounded">
                    Open revisit →
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </li>
    <% }); %>
  </ul>
<% } %>
