ANTHROPIC_API_KEY=your_key_here
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
COMMONROOM_API_KEY=
COMMONROOM_WORKSPACE=
DATABASE_URL=postgresql://localhost:5432/ambition_sdr
DAILY_EMAIL_LIMIT=50
SEND_WINDOW_START=8
SEND_WINDOW_END=17
SEND_TIMEZONE=America/Chicago
PORT=3000

# Automation is paused by default after the LinkedIn block. All cron jobs
# (research, writer, reply monitor, sender, presence poll, champion check,
# discovery) are disabled unless this is set to "true". Manual scans from
# the UI continue to work either way.
AUTOMATION_ENABLED=false

# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used for OAuth callbacks once Gmail/Salesforce are wired)
APP_URL=http://localhost:3000
